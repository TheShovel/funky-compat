{
  // Section hidden from users: aspect re-framing is DETECTED automatically
  // from each mod's own window declaration (a boot-time resize like
  // `resizeWindow(960, 720)` in data/global.hx - e.g. gumballs). The
  // overrides below only FORCE a value when that detection gets it wrong:
  //   "modAspects": { "<modFolder>": "4:3" }  - whole mod,
  //   "stageBias": { "<stageId>": { "aspect": "4:3" } } - one stage.
  // The value is a "W:H" ratio; the world camera is pillar-boxed to it
  // (black bars on the sides, same zoom and vertical extent).
  "cameraBiasX": 0,
  "cameraBiasY": 0,
  "characterBiasX": 0,
  "characterBiasY": 0,

  // Fake-3D backdrop tuning (GUNLICK-style stages that reference .awd models):
  //   "fake3dZoom": expansion factor over cover-fit - higher = room bigger/closer.
  //   "fake3dGroundY": pixels from screen top where the floor line sits.
  "fake3dZoom": 2.0,
  "fake3dGroundY": 720,
  "stageBias": {
    // Per-stage overrides: x/y/camx/camy shift props & camera, gfY/bfY/dadY
    // nudge that slot's anchor, zoom overrides the stage zoom, "aspect"
    // forces a non-16:9 view width for a single stage (see above), and
    // "crowdGround": true opts an animated crowd into ground-plane
    // correction. By default imported props stay at their authored Codename/
    // XML position, avoiding vertical drift from inferred floor geometry.
    "the barracks settlement": {
      "x": 0,
      "y": 0
    },
    "stage": {
      "gfY": 55
    },
    "philly": {
      "gfY": 55
    },
    "spooky": {
      "gfY": 55
    }
  }
}