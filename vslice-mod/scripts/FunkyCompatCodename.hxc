// funky-compat - Codename Engine (1.x) mod importer.
// Converts Codename mod data (charts, song meta, characters, stages, weeks,
// audio) into V-Slice formats entirely in memory.
//
// Codename scripts (HScript states, song scripts, character/stage scripts)
// are not portable and are skipped with a warning.

import haxe.Json;
import StringTools;
import openfl.utils.ByteArray;
import funkin.util.ReflectUtil;
import flixel.FlxG;

class FunkyCompatCodename
{
  public var util:FunkyCompatUtil;

  // charId -> {w, h, s} frame dims + base scale (for top-left -> feet
  // anchor conversion in stages).
  var charMetrics:Dynamic;
  // stageId -> {bf, dad, gf} char ids referenced by the first song that
  // uses the stage (needed to know which sprites the anchors describe).
  var stageCharHints:Dynamic;
  // stageId -> {spriteName: alpha} create()-time sprite overrides extracted
  // from the first song's scripts (the "hidethings" pattern: sprites hidden
  // until an HScript Call event reveals them).
  var stageSpritePatch:Dynamic;
  // stageId -> Codename HScript Call events collected from imported charts.
  // These are replayed by DynStage because V-Slice cannot execute the
  // original stage script callbacks.
  var stageCallEvents:Dynamic;
  // Optional tuning knobs from the layer's own config.json
  // (mods/funky-compat/config.json):
  //   cameraBiasY:      adds to the baked stage camera Y offset (moves the
  //                     view up/down; characters appear higher/lower).
  //   characterBiasY:   shifts the character feet directly (+y = lower).
  var layerConfig:Dynamic;
  // stageId (lowercased) -> true, for stages referenced by imported songs.
  // Only these get converted/registered (skips decoding art for unused
  // stages, which used to cost gigabytes of RAM at boot).
  var usedStageIds:Dynamic;
  // Framed view width (0 = 16:9) detected from the mod's stage layouts,
  // passed into convert() by the module; used to emit aspect re-framing
  // events for square/4:3-era mods (see detectStageAspect).
  var detectedAspect:Int;
  var songStageList:Array<Dynamic>;

  public function new(util:FunkyCompatUtil)
  {
    this.util = util;
    this.charMetrics = {};
    this.stageCharHints = {};
    this.stageSpritePatch = {};
    this.stageCallEvents = {};
    this.layerConfig = null;
    this.usedStageIds = {};
    this.detectedAspect = 0;
  }

  public function getLayerConfig():Dynamic
  {
    if (layerConfig == null)
    {
      layerConfig = {};
      var cfgText:String = util.readText('mods/funky-compat/config.json');
      if (cfgText != null)
      {
        // haxe.Json rejects comments - strip them defensively so an edited
        // config with notes still parses.
        var stripped:String = '';
        var lines:Array<String> = cfgText.split('\n');
        for (ln in lines)
        {
          var li:Int = ln.indexOf('//');
          if (li >= 0) ln = ln.substring(0, li);
          stripped += ln + '\n';
        }
        try
        {
          var parsed:Dynamic = Json.parse(stripped);
          if (parsed != null) layerConfig = parsed;
        }
        catch (e:Dynamic)
        {
          util.warn('Failed to parse funky-compat config.json - using defaults');
        }
      }
    }
    return layerConfig;
  }

  public function has(o:Dynamic, name:String):Bool
  {
    return ReflectUtil.hasField(o, name);
  }

  public function get(o:Dynamic, name:String):Dynamic
  {
    return ReflectUtil.getField(o, name);
  }

  public function set(o:Dynamic, name:String, value:Dynamic):Void
  {
    ReflectUtil.setAnonymousField(o, name, value);
  }

  // ------------------------------------------------------------------
  // Detection
  // ------------------------------------------------------------------

  public function detect(dir:String):Bool
  {
    if (!util.pathExists('mods/$dir')) return false;
    if (util.fileExists('mods/$dir/data/config/modpack.ini')) return true;
    // Charts with codenameChart: true are unambiguous.
    if (util.pathExists('mods/$dir/songs'))
    {
      var songDirs:Array<String> = util.listDir('mods/$dir/songs');
      for (songDir in songDirs)
      {
        if (!util.pathExists('mods/$dir/songs/$songDir')) continue;
        if (!util.pathExists('mods/$dir/songs/$songDir/charts')) continue;
        var chartFiles:Array<String> = util.listDir('mods/$dir/songs/$songDir/charts');
        for (chartFile in chartFiles)
        {
          if (!StringTools.endsWith(chartFile.toLowerCase(), '.json')) continue;
          var chart:Dynamic = util.readJson('mods/$dir/songs/$songDir/charts/$chartFile');
          if (chart != null && get(chart, 'codenameChart') == true) return true;
        }
      }
    }
    // Character XML is codename-specific (psych uses JSON).
    if (util.pathExists('mods/$dir/data/characters'))
    {
      var charFiles:Array<String> = util.listDir('mods/$dir/data/characters');
      for (charFile in charFiles)
      {
        if (StringTools.endsWith(charFile.toLowerCase(), '.xml')) return true;
      }
    }
    return false;
  }

  // ------------------------------------------------------------------
  // Output helpers
  // ------------------------------------------------------------------

  public function addText(out:Dynamic, paths:Array<String>, content:String):Void
  {
    out.texts.push({paths: paths, content: content});
  }

  // Register an image from the mod's images/ folder. `keyOverride` rebinds
  // the asset-cache key when the emitted id was namespaced (cross-mod
  // collision): the file is read from its real disk path, but registered
  // under the unique key so another mod's identically-named art cannot
  // override it.
  public function addImage(out:Dynamic, modDir:String, relPath:String, ?keyOverride:String):Void
  {
    var entry:Dynamic = util.resolveFileEntry(out, 'mods/$modDir/images/$relPath');
    if (entry == null) return;
    var key:String = (keyOverride != null && keyOverride != '') ? keyOverride : relPath;
    out.images.push({paths: util.imageKeys(key), bytes: entry.bytes, file: entry.file});
    var xmlRel:String = relPath;
    if (StringTools.endsWith(xmlRel.toLowerCase(), '.png')) xmlRel = xmlRel.substring(0, xmlRel.length - 4);
    var xmlKey:String = key;
    if (StringTools.endsWith(xmlKey.toLowerCase(), '.png')) xmlKey = xmlKey.substring(0, xmlKey.length - 4);
    var xmlText:String = util.readText('mods/$modDir/images/$xmlRel.xml');
    if (xmlText != null)
    {
      out.texts.push({paths: util.imageKeys('$xmlKey.xml'), content: xmlText});
    }
  }

  // V-Slice resolves health icons as icons/icon-<characterId>. Imported
  public function addIconAlias(out:Dynamic, modDir:String, iconName:String, charId:String):Void
  {
    // Try to register the real icon image before falling back to transparent.
    var candidates:Array<String> = [
      'mods/$modDir/images/icons/$iconName.png',
      'mods/$modDir/images/icons/icon-$iconName.png',
      'mods/$modDir/images/icons/icon-$charId.png',
      'mods/$modDir/images/icons/$charId.png',
      'mods/$modDir/images/icons/$iconName/icon.png'
    ];
    for (cand in candidates)
    {
      var entry:Dynamic = util.resolveFileEntry(out, cand);
      if (entry != null)
      {
        out.images.push({paths: util.imageKeys('icons/icon-$charId.png'), bytes: entry.bytes, file: entry.file});
        var candXml:String = cand.substring(0, cand.length - 4) + '.xml';
        var xmlText:String = util.readText(candXml);
        if (xmlText != null)
        {
          out.texts.push({paths: util.imageKeys('icons/icon-$charId.xml'), content: xmlText});
        }
        return;
      }
    }
    util.registerTransparentIcon(out, charId);
  }

  public function addSound(out:Dynamic, paths:Array<String>, entry:Dynamic):Void
  {
    if (entry == null) return;
    if (entry.bytes == null && entry.file == null) return;
    out.sounds.push({paths: paths, bytes: entry.bytes, file: entry.file});
  }

  // ------------------------------------------------------------------
  // Weeks -> Levels
  // ------------------------------------------------------------------
  public function convertWeeks(dir:String, out:Dynamic):Void
  {
    var weeksRoot:String = 'mods/$dir/data/weeks';
    if (!util.pathExists('$weeksRoot/weeks')) return;

    // Map display names to song ids.
    var songIdMap:Dynamic = {};
    for (songId in out.songs)
    {
      set(songIdMap, util.normalizeId(songId), songId);
    }

    var order:Array<String> = [];
    var seen:Dynamic = {};
    if (util.fileExists('$weeksRoot/weeks.txt'))
    {
      var orderText:String = util.readText('$weeksRoot/weeks.txt');
      var lines:Array<String> = orderText.split('\n');
      for (lineRaw in lines)
      {
        var line:String = StringTools.trim(lineRaw);
        if (line == '' || StringTools.startsWith(line, '#')) continue;
        var key:String = line;
        if (StringTools.endsWith(key.toLowerCase(), '.xml')) key = key.substring(0, key.length - 4);
        order.push(line);
        set(seen, key, true);
      }
    }
    // weeks.txt is often just a template for sorting - ALWAYS also load the
    // actual week XMLs on disk that were not listed there.
    var weekFiles:Array<String> = util.listDir('$weeksRoot/weeks');
    for (weekFile in weekFiles)
    {
      if (!StringTools.endsWith(weekFile.toLowerCase(), '.xml')) continue;
      var weekKey:String = weekFile.substring(0, weekFile.length - 4);
      if (get(seen, weekKey) == true) continue;
      order.push(weekFile);
      set(seen, weekKey, true);
    }

    for (weekEntry in order)
    {
      var weekId:String = weekEntry;
      if (StringTools.endsWith(weekId.toLowerCase(), '.xml')) weekId = weekId.substring(0, weekId.length - 4);
      var xmlText:String = util.readText('$weeksRoot/weeks/$weekId.xml');
      if (xmlText == null) continue; // e.g. 'template' listed in weeks.txt without an XML

      var levelSongs:Array<String> = [];
      var songBodies:Array<String> = extractTags(xmlText, 'song');
      var songContents:Array<String> = extractElementTexts(xmlText, 'song');
      for (si in 0...songBodies.length)
      {
        var body:String = songBodies[si];
        var hide:String = attr(body, 'hide');
        if (hide == 'true') continue;
        var name:String = '';
        if (si < songContents.length) name = StringTools.trim(songContents[si]);
        if (name == '') continue;
        var lookup:String = util.normalizeId(name);
        var songId:Null<String> = get(songIdMap, lookup);
        if (songId == null || songId == '' || songId == 'null') songId = lookup;
        if (levelSongs.indexOf(songId) == -1) levelSongs.push(songId);
      }

      var displayName:String = attr(extractFirstTag(xmlText, 'week'), 'name');
      if (displayName == null || displayName == '') displayName = weekId;
      var bgColor:String = attr(extractFirstTag(xmlText, 'week'), 'bgColor');
      if (bgColor == null || bgColor == '') bgColor = '#F9CF51';

      // A week id another imported mod already claimed would shadow its level
      // in the shared LevelRegistry - namespace it like the other ids.
      weekId = util.disambiguateId('levels', dir, weekId);
      if (weekId == '') continue;

      var levelData:Dynamic = {
        version: '1.0.0',
        name: displayName,
        titleAsset: 'storymenu/titles/$weekId',
        props: [],
        background: bgColor,
        songs: levelSongs
      };
      addText(out, util.dataTextKeys('levels/$weekId.json'), util.stringify(levelData));
      out.levels.push(weekId);
      util.claimForeign('levels', weekId);
    }
  }

  // ------------------------------------------------------------------
  // Tiny XML helpers (no Xml API needed)
  // ------------------------------------------------------------------

  // Attr-body of every occurrence of <tagName ...>.
  public function extractTags(xml:String, tagName:String):Array<String>
  {
    var result:Array<String> = [];
    var pos:Int = 0;
    var openTag:String = '<' + tagName;
    while (pos < xml.length)
    {
      var o:Int = xml.indexOf(openTag, pos);
      if (o < 0) break;
      var b:String = xml.charAt(o + openTag.length);
      if (b != ' ' && b != '>' && b != '/' && b != '\t' && b != '\n' && b != '\r')
      {
        pos = o + openTag.length;
        continue;
      }
      var g:Int = xml.indexOf('>', o);
      if (g < 0) break;
      result.push(xml.substring(o + openTag.length, g));
      pos = g + 1;
    }
    return result;
  }

  // Text content of every <tagName>...</tagName> element.
  public function extractElementTexts(xml:String, tagName:String):Array<String>
  {
    var result:Array<String> = [];
    var pos:Int = 0;
    var openTag:String = '<' + tagName;
    var closeTag:String = '</' + tagName;
    while (pos < xml.length)
    {
      var o:Int = xml.indexOf(openTag, pos);
      if (o < 0) break;
      var g:Int = xml.indexOf('>', o);
      if (g < 0) break;
      var c:Int = xml.indexOf(closeTag, g + 1);
      if (c < 0) break;
      result.push(xml.substring(g + 1, c));
      pos = c + closeTag.length;
    }
    return result;
  }

  public function extractFirstTag(xml:String, tagName:String):String
  {
    var tags:Array<String> = extractTags(xml, tagName);
    if (tags.length == 0) return '';
    return tags[0];
  }

  // Extract create()-time sprite overrides from a codename song script
  // (the "hidethings" pattern):
  //   var table = stage.getSprite("table");
  //   table.visible = false;
  //   crack.alpha = 0.0;
  // Returns {spriteName: alpha}. Only the create() function is scanned.
  public function scriptSpriteOverrides(scriptText:String):Dynamic
  {
    var result:Dynamic = {};
    if (scriptText == null) return result;
    var startIdx:Int = scriptText.indexOf('function create(');
    if (startIdx < 0) return result;
    var endIdx:Int = scriptText.indexOf('function ', startIdx + 1);
    if (endIdx < 0) endIdx = scriptText.length;
    var body:String = scriptText.substring(startIdx, endIdx);

    // Map script variable names to sprite names.
    var varToSprite:Dynamic = {};
    var pos:Int = 0;
    var needle:String = 'stage.getSprite(';
    while (pos < body.length)
    {
      var g:Int = body.indexOf(needle, pos);
      if (g < 0) break;
      var eq:Int = body.lastIndexOf('=', g);
      if (eq >= 0)
      {
        var vstart:Int = body.lastIndexOf(';', eq) + 1;
        var vname:String = StringTools.trim(body.substring(vstart, eq));
        if (StringTools.startsWith(vname.toLowerCase(), 'var ')) vname = StringTools.trim(vname.substring(4));
        var q1:Int = body.indexOf('"', g + needle.length);
        var q2:Int = body.indexOf('"', q1 + 1);
        if (vname != '' && q1 >= 0 && q2 > q1)
        {
          set(varToSprite, vname, body.substring(q1 + 1, q2));
        }
      }
      pos = g + 1;
    }

    for (field in ReflectUtil.fields(varToSprite))
    {
      var spriteName:String = Std.string(get(varToSprite, field));
      if (spriteName == '') continue;
      var hidden:Bool = body.indexOf('$field.visible = false') >= 0 || body.indexOf('$field.visible=false') >= 0;
      var alphaVal:Float = -1;
      var aIdx:Int = body.indexOf('$field.alpha = ');
      if (aIdx < 0) aIdx = body.indexOf('$field.alpha=');
      if (aIdx >= 0)
      {
        var rest:String = body.substring(aIdx + ('$field.alpha = ').length);
        if (rest.length == 0) continue;
        var num:String = '';
        for (ci in 0...rest.length)
        {
          var cc:Int = rest.charCodeAt(ci);
          if ((cc >= 48 && cc <= 57) || cc == 46 || cc == 45) num += rest.charAt(ci);
          else break;
        }
        var av:Float = Std.parseFloat(num);
        if (!Math.isNaN(av)) alphaVal = av;
      }
      else if (hidden)
      {
        alphaVal = 0;
      }
      if (alphaVal >= 0)
      {
        set(result, spriteName, alphaVal);
      }
    }

    // Character anchors are referenced directly in scripts (not via
    // stage.getSprite): 'dad.visible = false', 'gf.visible = false', etc.
    var charRefs:Array<String> = ['dad', 'boyfriend', 'gf', 'girlfriend', 'player', 'opponent'];
    for (ref in charRefs)
    {
      if (get(result, ref) != null) continue;
      var hidden2:Bool = body.indexOf('$ref.visible = false') >= 0 || body.indexOf('$ref.visible=false') >= 0;
      var alphaVal2:Float = -1;
      var aIdx2:Int = body.indexOf('$ref.alpha = ');
      if (aIdx2 < 0) aIdx2 = body.indexOf('$ref.alpha=');
      if (aIdx2 >= 0)
      {
        var rest2:String = body.substring(aIdx2 + ('$ref.alpha = ').length);
        if (rest2.length > 0)
        {
          var num2:String = '';
          for (ci in 0...rest2.length)
          {
            var cc2:Int = rest2.charCodeAt(ci);
            if ((cc2 >= 48 && cc2 <= 57) || cc2 == 46 || cc2 == 45) num2 += rest2.charAt(ci);
            else break;
          }
          var av2:Float = Std.parseFloat(num2);
          if (!Math.isNaN(av2)) alphaVal2 = av2;
        }
      }
      else if (hidden2)
      {
        alphaVal2 = 0;
      }
      if (alphaVal2 >= 0)
      {
        set(result, ref, alphaVal2);
      }
    }
    return result;
  }

  // Sprite-hide effects of script functions that are called within the FIRST
  // THIRD of the song (the intro/flash choreography). Returns {sprite: 0}.
  // Scripts reference stage sprites through file-scoped vars
  // ('var x = stage.getSprite("name")') and their functions toggle
  // visibility; 'HScript Call' chart events name the functions and their
  // times. Sprites whose hiding function fires early in the song are intro
  // overlays (e.g. backrooms' Kane logo fade-black) - default them to hidden
  // so they do not linger on screen, since the reveal events themselves
  // cannot run in V-Slice.
  public function scriptIntroHides(scriptTexts:Array<String>, rawEvents:Array<Dynamic>, songLenMs:Float):Dynamic
  {
    var result:Dynamic = {};
    if (songLenMs <= 0) return result;

    // Earliest invocation time per script function name.
    var callTimes:Dynamic = {};
    for (ev in rawEvents)
    {
      if (ev == null) continue;
      var evName:String = util.getString(get(ev, 'name'), '');
      if (evName != 'HScript Call') continue;
      var evParams:Dynamic = get(ev, 'params');
      if (evParams == null || evParams.length < 1) continue;
      var fnName:String = Std.string(evParams[0]);
      if (fnName == null || fnName == '') continue;
      var evTime:Float = util.getFloat(get(ev, 'time'), -1);
      var seen:Float = util.getFloat(get(callTimes, fnName), -1);
      if (seen < 0 || (evTime >= 0 && evTime < seen)) set(callTimes, fnName, evTime);
    }
    var introLimit:Float = songLenMs * 0.3;

    for (sti in 0...scriptTexts.length)
    {
      var text:String = scriptTexts[sti];
      if (text == null || text == '') continue;

      // File-scope sprite-var map ('var x = stage.getSprite("name")').
      var vmap:Dynamic = {};
      var pos:Int = 0;
      while (pos < text.length)
      {
        var g:Int = text.indexOf('stage.getSprite(', pos);
        if (g < 0) break;
        var eq:Int = text.lastIndexOf('=', g);
        if (eq >= 0)
        {
          var vstart:Int = text.lastIndexOf(';', eq) + 1;
          var vname:String = StringTools.trim(text.substring(vstart, eq));
          if (StringTools.startsWith(vname.toLowerCase(), 'var ')) vname = StringTools.trim(vname.substring(4));
          var q1:Int = text.indexOf('"', g + 'stage.getSprite('.length);
          var q2:Int = text.indexOf('"', q1 + 1);
          if (vname != '' && q1 >= 0 && q2 > q1) set(vmap, vname, text.substring(q1 + 1, q2));
        }
        pos = g + 1;
      }

      // Function blocks: name + body text.
      var fnIdx:Int = 0;
      while (true)
      {
        var fs:Int = text.indexOf('function ', fnIdx);
        if (fs < 0) break;
        var fe:Int = text.indexOf('function ', fs + 1);
        if (fe < 0) fe = text.length;
        var block:String = text.substring(fs, fe);
        var pOpen:Int = block.indexOf('(');
        var fnName2:String = '';
        if (pOpen >= 0)
        {
          fnName2 = StringTools.trim(block.substring('function '.length, pOpen));
        }
        if (fnName2 != '')
        {
          var callT:Float = util.getFloat(get(callTimes, fnName2), -1);
          if (callT >= 0 && callT <= introLimit)
          {
            for (field in ReflectUtil.fields(vmap))
            {
              var sprName:String = Std.string(get(vmap, field));
              if (sprName == '' || get(result, sprName) != null) continue;
              var hide:Bool = block.indexOf('$field.visible = false') >= 0 || block.indexOf('$field.visible=false') >= 0;
              hide = hide || block.indexOf('$field.alpha = 0') >= 0 || block.indexOf('$field.alpha=0') >= 0;
              // Tweens: FlxTween.tween(x, {alpha: 0.0}, ...) fades the sprite out.
              hide = hide || block.indexOf('$field, {alpha: 0') >= 0;
              if (hide) set(result, sprName, 0);
            }
          }
        }
        fnIdx = fe;
      }
    }
    return result;
  }

  // Attr-body of every occurrence of <tagName ...>, sorted by document order,
  // for any of the given tag names. Each entry also carries openEnd/closePos
  // (the index range of the element's child content) so callers can parse
  // child elements like <anim> that live after the tag's '>'.
  public function orderedTags(xml:String, tagNames:Array<String>):Array<Dynamic>
  {
    var result:Array<Dynamic> = [];
    var pos:Int = 0;
    while (pos < xml.length)
    {
      // Find the earliest occurrence of any requested tag.
      var bestIdx:Int = -1;
      var bestName:String = '';
      for (tn in tagNames)
      {
        var o:Int = xml.indexOf('<' + tn, pos);
        if (o >= 0 && (bestIdx < 0 || o < bestIdx))
        {
          bestIdx = o;
          bestName = tn;
        }
      }
      if (bestIdx < 0) break;
      var openTag:String = '<' + bestName;
      var b:String = xml.charAt(bestIdx + openTag.length);
      if (b != ' ' && b != '>' && b != '/' && b != '\t' && b != '\n' && b != '\r')
      {
        pos = bestIdx + openTag.length;
        continue;
      }
      var g:Int = xml.indexOf('>', bestIdx);
      if (g < 0) break;
      var openEnd:Int = g + 1;
      var closePos:Int = openEnd;
      if (g > bestIdx && xml.charAt(g - 1) == '/')
      {
        // Self-closing element: no children beyond the open tag.
        pos = openEnd;
      }
      else
      {
        var closeTag:String = '</' + bestName + '>';
        var c:Int = xml.indexOf(closeTag, openEnd);
        if (c < 0)
        {
          // Unclosed element - treat the rest of the document as content.
          closePos = xml.length;
          pos = xml.length;
        }
        else
        {
          closePos = c;
          pos = c + closeTag.length;
        }
      }
      result.push({name: bestName, body: xml.substring(bestIdx + openTag.length, g), openEnd: openEnd, closePos: closePos});
    }
    return result;
  }

  // Read key="value" from an attr-body string. The key match is spaced
  // (not a bare substring): 'x=' must not match inside 'camx='/'scalex=',
  // otherwise characters that omit an 'x' attribute inherit their camx.
  public function attr(body:String, name:String):Null<String>
  {
    if (body == null) return null;
    var needle:String = name + '=';
    var idx:Int = body.indexOf(needle);
    while (idx >= 0)
    {
      var prevChar:String = idx > 0 ? body.charAt(idx - 1) : ' ';
      var boundary:Bool = !((prevChar >= 'a' && prevChar <= 'z') || (prevChar >= 'A' && prevChar <= 'Z') || (prevChar >= '0' && prevChar <= '9') || prevChar == '_');
      if (boundary) break;
      idx = body.indexOf(needle, idx + 1);
    }
    if (idx < 0) return null;
    var rest:String = body.substring(idx + needle.length);
    if (rest.length == 0) return null;
    var quote:String = rest.charAt(0);
    if (quote != '"' && quote != "'") return null;
    var end:Int = rest.indexOf(quote, 1);
    if (end < 0) return null;
    return rest.substring(1, end);
  }

  // Expand codename-style indices ("2..12,0,1") into an int array.
  public function expandIndices(raw:String):Array<Int>
  {
    var result:Array<Int> = [];
    var parts:Array<String> = raw.split(',');
    for (pi in 0...parts.length)
    {
      var part:String = StringTools.trim(parts[pi]);
      if (part == '') continue;
      var dot:Int = part.indexOf('..');
      if (dot >= 0)
      {
        var a:Int = Std.parseInt(StringTools.trim(part.substring(0, dot)));
        var b:Int = Std.parseInt(StringTools.trim(part.substring(dot + 2)));
        if (a == null) a = 0;
        if (b == null) b = 0;
        var step:Int = a <= b ? 1 : -1;
        var cur:Int = a;
        while (step > 0 ? cur <= b : cur >= b)
        {
          result.push(cur);
          cur += step;
        }
      }
      else
      {
        var v:Int = Std.parseInt(part);
        if (v != null) result.push(v);
      }
    }
    return result;
  }

  // Map a Codename strumline to the V-Slice character slot it drives.
  // Codename resolves the slot from the strumline's `position` STRING
  // ("boyfriend"/"girlfriend"/"dad") and only falls back to the numeric
  // `type` when position is absent - a girlfriend line can carry type 0
  // (e.g. gumballs' "memory card"), so keying off type alone would clobber
  // the opponent slot with the gf character.
  public function strumlineCharSlot(line:Dynamic, lineType:Int):String
  {
    var posRaw:Dynamic = get(line, 'position');
    if (posRaw != null && posRaw != '')
    {
      var pos:String = Std.string(posRaw).toLowerCase();
      if (pos == 'boyfriend' || pos == 'player' || pos == 'bf') return 'boyfriend';
      if (pos == 'girlfriend' || pos == 'gf') return 'girlfriend';
      if (pos == 'dad' || pos == 'opponent') return 'dad';
      // Custom named anchor - V-Slice only has 3 character slots, so
      // treat anything else as the opponent slot.
      return 'dad';
    }
    if (lineType == 1) return 'boyfriend';
    if (lineType == 2) return 'girlfriend';
    return 'dad';
  }

  public function convertSongs(dir:String, out:Dynamic):Void
  {
    var songsRoot:String = 'mods/$dir/songs';
    if (!util.pathExists(songsRoot)) return;
    var songDirs:Array<String> = util.listDir(songsRoot);
    for (songFolder in songDirs)
    {
      if (!util.pathExists('$songsRoot/$songFolder')) continue;
      var songBase:String = '$songsRoot/$songFolder';
      if (!util.pathExists('$songBase/charts')) continue;
      // Song scripts (notes/*.hx etc.) are HScript - data imports fine but
      // the scripts themselves cannot run in V-Slice.
      var songScripts:Array<String> = util.listDir('$songBase/scripts');
      for (scriptFile in songScripts)
      {
        if (StringTools.endsWith(scriptFile.toLowerCase(), '.hx'))
        {
          util.warn('Codename: song script $songFolder/scripts/$scriptFile is not portable to V-Slice (HScript)');
        }
      }
      // V-Slice lowercases song ids when building audio keys (Paths.inst /
      // Paths.voices), and data lookups use the id verbatim - so the
      // registered id and all injected keys must be lowercase. The original
      // folder name is still used for on-disk reads (songBase above).
      var songId:String = songFolder.toLowerCase();

      var metaJson:Dynamic = util.readJson('$songBase/meta.json');
      if (metaJson == null) metaJson = {};

      // Length (ms) of this song's instrumental, used below to drop notes
      // charted past the end of the audio (see probeInstEndMs).
      var instEndMs:Null<Float> = probeInstEndMs(dir, songFolder, metaJson);

      // Difficulties: meta list, or chart file names.
      var difficulties:Array<String> = [];
      var metaDiffs:Dynamic = get(metaJson, 'difficulties');
      if (metaDiffs != null && metaDiffs.length > 0)
      {
        for (di in 0...metaDiffs.length)
        {
          difficulties.push(Std.string(metaDiffs[di]));
        }
      }
      else
      {
        var chartFiles:Array<String> = util.listDir('$songBase/charts');
        for (chartFile in chartFiles)
        {
          if (!StringTools.endsWith(chartFile.toLowerCase(), '.json')) continue;
          difficulties.push(chartFile.substring(0, chartFile.length - 5));
        }
      }

      // Parse each chart difficulty.
      var notesJson:Dynamic = {};
      var flatEvents:Array<Dynamic> = []; // shared across difficulties (native format)
      var seenEvents:Dynamic = {};
      var scrollSpeeds:Dynamic = {};
      var timeChangeEvents:Array<Dynamic> = [];

      if (difficulties.length == 0)
      {
        util.warn('Codename: song $songId has no chart difficulties, skipping');
        continue;
      }

      // Only import difficulties that actually have a chart file.
      // V-Slice difficulty ids are lowercase (easy/normal/hard/erect/...),
      // while Codename names them "Normal"/"Hard"/"Normal-Erect". Chart
      // FILES keep their original names on disk; the converted metadata and
      // chart JSON use the mapped lowercase ids so freeplay's difficulty
      // filtering (which is case-sensitive) matches the base game ids.
      //
      // Chart file lookup is case-insensitive: some mods mix case between
      // meta.json and the chart files on disk.
      var chartFilesOnDisk:Dynamic = {};
      var listedChartFiles:Array<String> = util.listDir('$songBase/charts');
      for (cf in listedChartFiles)
      {
        if (!StringTools.endsWith(cf.toLowerCase(), '.json')) continue;
        var cfBase:String = cf.substring(0, cf.length - 5);
        set(chartFilesOnDisk, cfBase.toLowerCase(), cfBase);
      }
      var realDifficulties:Array<String> = [];
      var diffIds:Array<String> = [];
      for (di in 0...difficulties.length)
      {
        var diffName:String = difficulties[di];
        if (diffName == null || StringTools.trim(diffName) == '') continue;
        var actualName:String = diffName;
        if (!util.fileExists('$songBase/charts/$diffName.json'))
        {
          var match:Null<String> = get(chartFilesOnDisk, StringTools.trim(diffName).toLowerCase());
          if (match == null || match == '')
          {
            util.warn('Codename: $songId lists difficulty "$diffName" but has no chart file');
            continue;
          }
          actualName = match;
        }
        var mapped:String = vsliceDiffId(diffName);
        if (mapped == '' || diffIds.indexOf(mapped) != -1) continue;
        realDifficulties.push(actualName);
        diffIds.push(mapped);
      }
      difficulties = realDifficulties;
      if (difficulties.length == 0)
      {
        util.warn('Codename: song $songId has no importable chart files, skipping');
        continue;
      }

      // A mod song whose id matches a built-in V-Slice song (e.g. a
      // "bopeebo" remake) would fight the vanilla metadata/chart/audio for
      // the same asset keys and break the mod song. Import it under a
      // suffixed id and key EVERY emitted asset (metadata, chart, audio)
      // under the new id; on-disk reads above keep the original folder name.
      var emitId:String = songId;
      if (util.fileExists('assets/data/songs/$songId/$songId-metadata.json'))
      {
        emitId = songId + '-fc';
        util.warn('Codename: song "$songId" collides with a built-in V-Slice song - importing the mod version as "$emitId" (assets keyed under the new id too)');
      }
      if (util.isForeignTaken('songs', emitId))
      {
        emitId = emitId + '-' + util.modSlug(dir);
        util.warn('Codename: song "$songId" is also defined by another imported mod - importing this mod version as "$emitId" (assets keyed under the new id too)');
      }

      var bpm:Float = util.getFloat(get(metaJson, 'bpm'), 100);

      // Global events (shared across difficulties).
      var globalEvents:Array<Dynamic> = [];
      var globalEventsFile:Dynamic = util.readJson('$songBase/events.json');
      if (globalEventsFile != null)
      {
        var globalList:Dynamic = get(globalEventsFile, 'events');
        if (globalList != null)
        {
          for (gi in 0...globalList.length)
          {
            globalEvents.push(globalList[gi]);
          }
        }
      }

      for (di in 0...difficulties.length)
      {
        var diff:String = difficulties[di]; // original file name on disk
        var diffId:String = diffIds[di]; // mapped vslice id for output
        var chart:Dynamic = util.readJson('$songBase/charts/$diff.json');
        if (chart == null) continue;

        var notesArr:Array<Dynamic> = [];
        var eventsArr:Array<Dynamic> = [];
        var trimmedNotes:Int = 0;
        var scrollSpeed:Float = util.getFloat(get(chart, 'scrollSpeed'), 1);
        var warnedNoteTypes:Dynamic = {};
        var noteTypesRaw:Array<Dynamic> = get(chart, 'noteTypes');
        if (noteTypesRaw == null && get(chart, 'meta') != null) noteTypesRaw = get(get(chart, 'meta'), 'noteTypes');
        // Alt Animation Toggle spans, folded into per-note kinds below.
        var altSpans:Array<Dynamic> = buildAltSpans(chart);

        // Codename mods may embed legacy/psych-format charts; the engine
        // converts them at runtime. We do the same conversion ourselves.
        if (get(chart, 'codenameChart') != true)
        {
          var songObj:Dynamic = chart;
          if (get(chart, 'song') != null && !isPrimitive(get(chart, 'song'))) songObj = get(chart, 'song');
          var legacyTimeChanges:Array<Dynamic> = [];
          convertLegacyChart(songObj, bpm, notesArr, eventsArr, legacyTimeChanges, instEndMs);
          if (get(songObj, 'speed') != null) scrollSpeed = util.getFloat(get(songObj, 'speed'), scrollSpeed);
          // BPM changes from long chart sections.
          for (tc in legacyTimeChanges)
          {
            timeChangeEvents.push(tc);
          }
          // Legacy events are psych-style tuples.
          eventsArr = convertLegacyEvents(get(songObj, 'events'));
          set(notesJson, diffId, notesArr);
          appendUnique(flatEvents, seenEvents, eventsArr);
          set(scrollSpeeds, diffId, scrollSpeed);
          continue;
        }

        var strumLines:Array<Dynamic> = get(chart, 'strumLines');
        if (strumLines != null)
        {
          for (sl in 0...strumLines.length)
          {
            var line:Dynamic = strumLines[sl];
            if (line == null) continue;
            var lineType:Int = util.getInt(get(line, 'type'), 0);
            // Warn once per difficulty on non-4K charts - lane math assumes 4K.
            var keyCount:Int = util.getInt(get(line, 'keyCount'), 4);
            if (keyCount != 4)
            {
              util.warn('Codename: $keyCountK strumline in $songId ($diff) is approximated as 4K');
            }
            // Warn about extra characters on a strumline - V-Slice only
            // renders one sprite per slot.
            var lineChars:Dynamic = get(line, 'characters');
            if (lineChars != null && lineChars.length > 1)
            {
              util.warn('Codename: extra characters on a strumline in $songId ($diff) are not rendered');
            }
            // V-Slice has no playable third strumline, but it does have a GF
            // character target. Preserve GF-line notes as animation events so
            // extra singers (notably GF-position characters) still animate;
            // their per-character vocal track is registered normally below.
            if (strumlineCharSlot(line, lineType) == 'girlfriend')
            {
              var gfNotes:Dynamic = get(line, 'notes');
              if (gfNotes != null)
              {
                for (gni in 0...gfNotes.length)
                {
                  var gfNote:Dynamic = gfNotes[gni];
                  if (gfNote == null) continue;
                  var gfTime:Float = util.getFloat(get(gfNote, 'time'), 0);
                  var gfId:Int = util.getInt(get(gfNote, 'id'), 0);
                  var gfType:Int = util.getInt(get(gfNote, 'type'), 0);
                  if (gfType == 0)
                    eventsArr.push({time: gfTime, name: 'Play Animation', params: [2, codenameSingAnim(gfId)]});
                }
              }
              continue;
            }
            var sideOffset:Int = 0;
            // V-Slice lane convention: player strumline = data 0-3, opponent
            // strumline = data 4-7 (getStrumlineIndex()==0 routes to the
            // player). Codename is the opposite (type 1 = player, on the
            // right) - so player lines get 0-3 and opponent lines get 4-7.
            if (lineType != 1) sideOffset = 4;
            var lineNotes:Array<Dynamic> = get(line, 'notes');
            if (lineNotes != null)
            {
              for (ni in 0...lineNotes.length)
              {
                var note:Dynamic = lineNotes[ni];
                if (note == null) continue;
                var t:Float = util.getFloat(get(note, 'time'), 0);
                var id:Int = util.getInt(get(note, 'id'), 0);
                var sLen:Float = util.getFloat(get(note, 'sLen'), 0);
                // Codename note types: 0 = normal; other types map via noteTypes array to vslice kind param.
                var noteType:Int = util.getInt(get(note, 'type'), 0);
                var noteKind:String = '';
                if (noteType != 0)
                {
                  if (noteTypesRaw != null && noteType < noteTypesRaw.length && noteTypesRaw[noteType] != null) noteKind = Std.string(noteTypesRaw[noteType]);
                  else if (noteType == 1) noteKind = 'Alt Animation';
                  else noteKind = 'type$noteType';
                  if (get(warnedNoteTypes, 't$noteType') == null)
                  {
                    set(warnedNoteTypes, 't$noteType', true);
                    util.warn('Codename: note type $noteType ($noteKind) in $songId ($diff) preserved as kind "$noteKind"');
                  }
                }
                // Notes charted past the end of the audio can never be hit
                // (V-Slice ends the song when the music completes), but they
                // still count against the results-screen completion percent.
                if (instEndMs != null && t > instEndMs)
                {
                  trimmedNotes++;
                  continue;
                }
                var noteObj:Dynamic = {t: t, d: sideOffset + id};
                // Notes inside an Alt Animation Toggle span play '-alt'
                // animations via the layer's 'alt' note kind (unless the note
                // already has a specialised kind of its own).
                if (noteKind == '' && inAltSpan(altSpans, sl, t)) noteObj.k = 'alt';
                if (sLen > 0)
                {
                  // The song ends when the instrumental ends; clip hold
                  // tails that would stretch past it.
                  if (instEndMs != null && t + sLen > instEndMs) sLen = Math.max(0, instEndMs - t);
                  if (sLen > 0) noteObj.l = sLen;
                }
                if (noteKind != '' && noteKind.toLowerCase() != 'normal' && noteKind.toLowerCase() != '0')
                {
                  var kToSet:String = noteKind;
                  if (kToSet.toLowerCase() == 'alt animation') kToSet = 'alt';
                  noteObj.k = kToSet;
                }
                notesArr.push(noteObj);
              }
            }
          }
        }

        if (trimmedNotes > 0)
        {
          util.warn('Codename: $songId ($diffId): $trimmedNotes note(s) lie after the instrumental (${Math.round(instEndMs / 100) / 10}s) - the song ends when the audio does, so they were dropped (they could never be hit and only lowered the clear percentage)');
        }

        // Chart-local events.
        var chartEvents:Dynamic = get(chart, 'events');
        if (chartEvents != null)
        {
          for (ei in 0...chartEvents.length)
          {
            eventsArr.push(chartEvents[ei]);
          }
        }
        // Global events for this difficulty.
        for (gi in 0...globalEvents.length)
        {
          eventsArr.push(globalEvents[gi]);
        }

        set(notesJson, diffId, notesArr);
        appendUnique(flatEvents, seenEvents, mapEvents(eventsArr, songId, diffId, timeChangeEvents, bpm));
        set(scrollSpeeds, diffId, scrollSpeed);
      }

      var runBpm:Float = bpm;
      var timeChanges:Array<Dynamic> = [{t: 0, b: 0, bpm: runBpm, bt: [4, 4, 4, 4]}];
      for (tc in timeChangeEvents)
      {
        var t:Float = util.getFloat(get(tc, 't'), 0);
        if (Math.abs(t) < 0.001) continue;
        var bpmVal:Float = util.getFloat(get(tc, 'bpm'), -1);
        if (bpmVal > 0) runBpm = bpmVal;
        var entry:Dynamic = {t: t, bpm: runBpm, bt: [4, 4, 4, 4]};
        if (get(tc, 'bt') != null) entry.bt = get(tc, 'bt');
        timeChanges.push(entry);
      }

      // Characters from strumlines. Codename only spawns characters that
      // have a strumline - a song without a girlfriend strumline has NO
      // girlfriend. V-Slice shares that convention: girlfriend == '' means
      // the GF is skipped entirely (see PlayState.initCharacters).
      var chart0:Dynamic = util.readJson('$songBase/charts/${difficulties[0]}.json');
      var playerChar:String = 'bf';
      var opponentChar:String = 'dad';
      var gfChar:String = '';
      var hasGfLine:Bool = false;
      if (chart0 != null)
      {
        // Legacy/psych charts declare characters directly.
        if (get(chart0, 'player1') != null)
        {
          playerChar = Std.string(get(chart0, 'player1'));
        }
        if (get(chart0, 'player2') != null)
        {
          opponentChar = Std.string(get(chart0, 'player2'));
        }
        var gfRaw:Dynamic = get(chart0, 'gfVersion');
        if (gfRaw != null)
        {
          gfChar = Std.string(gfRaw);
          hasGfLine = true;
        }
        var lines:Array<Dynamic> = get(chart0, 'strumLines');
        if (lines != null)
        {
          for (sl in 0...lines.length)
          {
            var line:Dynamic = lines[sl];
            if (line == null) continue;
            var lineType:Int = util.getInt(get(line, 'type'), 0);
            var chars:Dynamic = get(line, 'characters');
            if (chars != null && chars.length > 0)
            {
              var first:String = Std.string(chars[0]);
              // Codename resolves the character slot from the strumline's
              // `position` STRING ("boyfriend"/"girlfriend"/"dad") and only
              // falls back to `type` when position is absent - a GF line can
              // carry type 0 (e.g. gumballs' "memory card"), so keying off
              // type alone would clobber the opponent with the gf character.
              var slot:String = strumlineCharSlot(line, lineType);
              if (slot == 'boyfriend')
              {
                playerChar = first;
              }
              else if (slot == 'girlfriend')
              {
                gfChar = first;
                hasGfLine = true;
              }
              else
              {
                opponentChar = first;
              }
            }
          }
        }
      }
      // No usable gf anywhere in the chart: emit an empty girlfriend so
      // V-Slice doesn't spawn a default GF on stages that have an anchor.
      if (!hasGfLine) gfChar = '';

      // Apply built-in collisions (a mod-defined 'gf-car' must not resolve to
      // the vanilla character).
      playerChar = resolveCharId(dir, playerChar);
      opponentChar = resolveCharId(dir, opponentChar);
      if (gfChar != '') gfChar = resolveCharId(dir, gfChar);

      var stageId:String = 'mainStage';
      var stageBaseId:String = '';
      if (chart0 != null)
      {
        var stageVal:String = util.getString(get(chart0, 'stage'), '');
        if (stageVal != null && stageVal != '')
        {
          stageId = stageVal;
          // Canonical form: the chart's reference is what the runtime fetches
          // (StageRegistry.fetchEntry is a raw map lookup), and stage
          // conversion keys match by lowercased file name - so lowercase BOTH
          // sides here. The vanilla 'mainStage' fallback keeps its casing.
          stageId = stageId.toLowerCase();
        }
      }
      stageBaseId = stageId;
      // A stage also defined by an earlier imported mod would fight for the
      // same registry entry and stage-art cache keys. Namespace it and key
      // every emitted stage asset under the new id (see convertStages).
      if (stageId != '' && stageId != 'mainStage')
      {
        stageId = resolveStageId(dir, stageId);
      }
      if (stageId != '') set(usedStageIds, stageId, true);

      // Preserve portable Codename HScript Call events for the generated
      // stage. This is intentionally keyed by the resolved stage id, so
      // namespaced stages still receive their original chart callbacks.
      if (stageId != '')
      {
        var calls:Array<Dynamic> = get(stageCallEvents, stageId);
        if (calls == null) calls = [];
        var rawStageEvents:Array<Dynamic> = [];
        var chartStageEvents:Dynamic = chart0 == null ? null : get(chart0, 'events');
        if (chartStageEvents != null)
        {
          for (chartEvent in chartStageEvents) rawStageEvents.push(chartEvent);
        }
        for (globalEvent in globalEvents) rawStageEvents.push(globalEvent);
        for (rawCall in rawStageEvents)
        {
          if (rawCall == null) continue;
          if (util.getString(get(rawCall, 'name'), '') != 'HScript Call') continue;
          var callParams:Dynamic = get(rawCall, 'params');
          if (callParams == null || callParams.length < 1) continue;
          var callFn:String = util.getString(callParams[0], '');
          if (callFn == '') continue;
          var callTime:Float = util.getFloat(get(rawCall, 'time'), 0);
          var duplicate:Bool = false;
          for (existing in calls)
          {
            if (existing != null
              && util.getFloat(get(existing, 't'), -1) == callTime
              && util.getString(get(existing, 'fn'), '') == callFn)
            {
              duplicate = true;
              break;
            }
          }
          if (!duplicate)
            calls.push({t: callTime, step: eventStep(callTime, bpm, timeChangeEvents), fn: callFn, args: callParams});
        }
        set(stageCallEvents, stageId, calls);
      }

      // Portable song choreography (script-created actors, beat-triggered
      // tweens/flips, event-driven animations) from the song's HScript.
      // Played back at runtime by the layer's FunkyCompatChoreo event.
      var choreo:Dynamic = extractCodenameChoreo(dir, songFolder, stageId, stageBaseId);
      if (choreo != null
        && (get(choreo, 'sprites').length > 0 || get(choreo, 'characters').length > 0
          || get(choreo, 'beats').length > 0 || get(choreo, 'camAnims').length > 0
          || ReflectUtil.fields(get(choreo, 'calls')).length > 0))
      {
        flatEvents.push({t: 0, e: 'FunkyCompatChoreo', v: choreo});
        trace('[FUNKY-COMPAT] Codename choreography for "$songId": ' + get(choreo, 'sprites').length + ' sprites, ' + get(choreo, 'characters').length + ' chars, ' + get(choreo, 'beats').length + ' beat groups, ' + get(choreo, 'camAnims').length + ' cam-anims, ' + ReflectUtil.fields(get(choreo, 'calls')).length + ' call fn(s)');
      }

      // Square/4:3-era mods framed their stages for a narrower view. The
      // framed width comes from an explicit config override (modAspects /
      // stageBias.<id>.aspect) or, when unset, from the automatically
      // detected stage-layout signature (detectStageAspect). Emit a
      // FunkyCompatAspect event at t=0 that pillar-boxes the world camera
      // to that width; the scripted event class ships with the layer mod.
      var aspectW:Int = util.aspectViewW(dir, [stageId, stageBaseId]);
      if (aspectW <= 0) aspectW = this.detectedAspect;
      if (aspectW > 0 && aspectW < 1280)
      {
        flatEvents.push({t: 0, e: 'FunkyCompatAspect', v: {w: aspectW, h: 720}});
        util.warn('Codename: song "$songId" uses a non-16:9 stage ("$stageId", view ${aspectW}x720) - emitting aspect re-framing event');
      }

      var displayName:String = util.getString(get(metaJson, 'displayName'), songId);

      // Custom note styles: Codename charts carry a noteStyle string; the
      // mod's notes/splashes assets are swept from images/ notes and splashes
      // folders. Default to the vanilla skin.
      var noteStyle:String = 'funkin';
      if (chart0 != null)
      {
        var nsRaw:Dynamic = get(chart0, 'noteStyle');
        if (nsRaw != null && Std.string(nsRaw) != '') noteStyle = Std.string(nsRaw);
      }
      if (noteStyle == 'default') noteStyle = 'funkin';

      var ratings:Dynamic = {};
      for (di in 0...diffIds.length)
      {
        set(ratings, diffIds[di], 0);
      }

      var needsVoices:Bool = util.getBool(get(metaJson, 'needsVoices'), true);

      // Per-character vocal tracks (Psych-style Voices-<name>.ogg, which
      // dual-format mods like awesomemod ship instead of a single
      // Voices.ogg). Register each under its own key; V-Slice will then play
      // every track through the player voice list. Falls back to the
      // character id when no per-char vocals exist (single combined track).
      var voiceNames:Array<String> = registerCodenameVoices(dir, songFolder, emitId, out);
      var playerVocals:Array<String> = (voiceNames.length > 0) ? voiceNames : [playerChar];
      var opponentVocals:Array<String> = (voiceNames.length > 0) ? [] : [opponentChar];

      var metadata:Dynamic = {
        version: '2.2.4',
        songName: displayName,
        artist: 'Unknown',
        charter: 'funky-compat import',
        generatedBy: 'funky-compat (codename import)',
        playData: {
          difficulties: diffIds,
          characters: {
            player: playerChar,
            opponent: opponentChar,
            girlfriend: gfChar,
            playerVocals: playerVocals,
            opponentVocals: opponentVocals
          },
          stage: stageId,
          noteStyle: noteStyle,
          ratings: ratings
        },
        timeChanges: timeChanges
      };

      var chartData:Dynamic = {
        version: '2.0.0',
        scrollSpeed: scrollSpeeds,
        events: flatEvents,
        notes: notesJson,
        generatedBy: 'funky-compat (codename import)'
      };

      addText(out, util.dataTextKeys('songs/$emitId/$emitId-metadata.json'), util.stringify(metadata));
      addText(out, util.dataTextKeys('songs/$emitId/$emitId-chart.json'), util.stringify(chartData));

      // Remember which characters the first song uses on this stage, so the
      // stage converter knows which sprites its anchors describe.
      if (stageId != '' && get(stageCharHints, stageId) == null)
      {
        set(stageCharHints, stageId, {bf: playerChar, dad: opponentChar, gf: gfChar});
      }

      // Collect create()-time sprite visibility overrides from this song's
      // scripts (the "hidethings" pattern) for the stage it uses.
      if (stageId != '' && get(stageSpritePatch, stageId) == null)
      {
        var patch:Dynamic = {};
        var scriptFiles:Array<String> = util.listDir('$songBase/scripts');
        var scriptTexts:Array<String> = [];
        for (scriptFile in scriptFiles)
        {
          if (!StringTools.endsWith(scriptFile.toLowerCase(), '.hx')) continue;
          var scriptText:String = util.readText('$songBase/scripts/$scriptFile');
          scriptTexts.push(scriptText);
          var overrides:Dynamic = scriptSpriteOverrides(scriptText);
          for (key in ReflectUtil.fields(overrides))
          {
            var spriteName:String = Std.string(key);
            if (get(patch, spriteName) == null) set(patch, spriteName, get(overrides, spriteName));
          }
        }
        // Intro/flash sprites that are VISIBLE at create() but hidden a few
        // seconds into the song (e.g. backrooms' Kane logo fade-black) would
        // linger forever because the HScript Call events that fade them cannot
        // run here. If a stage sprite is hidden ONLY by script functions that
        // are called within the first third of the song, default it to hidden
        // too - keeps intro overlays off the screen without hiding scene-
        // transition props (basement etc.) that stay up most of the song.
        var songLenMs:Float = 0;
        for (ev in globalEvents)
        {
          if (ev == null) continue;
          var et:Float = util.getFloat(get(ev, 'time'), 0);
          if (et > songLenMs) songLenMs = et;
        }
        var introHides:Dynamic = scriptIntroHides(scriptTexts, globalEvents, songLenMs);
        for (key2 in ReflectUtil.fields(introHides))
        {
          var spriteName2:String = Std.string(key2);
          if (get(patch, spriteName2) == null) set(patch, spriteName2, get(introHides, spriteName2));
        }
        set(stageSpritePatch, stageId, patch);
      }

      addCodenameAudio(dir, songFolder, emitId, playerChar, opponentChar, metaJson, out);

      // Only characters actually used as the player are selectable.
      if (playerChar != null && playerChar != '' && out.playerChars.indexOf(playerChar) == -1)
      {
        out.playerChars.push(playerChar);
      }

      out.songs.push(emitId);
      util.claimForeign('songs', emitId);
    }
  }

  // Scan the song's audio folder for per-character vocal files
  // (Voices-<name>.ogg / Voices-<name>.mp3) and register each under its own
  // song-audio key so V-Slice's voice resolution can find them. Returns the
  // lowercased vocal names that were registered (empty when only a combined
  // Voices.ogg exists - that path stays on addCodenameAudio).
  public function registerCodenameVoices(dir:String, folder:String, songId:String, out:Dynamic):Array<String>
  {
    var result:Array<String> = [];
    var audioBase:String = 'mods/$dir/songs/$folder/song';
    if (!util.pathExists(audioBase)) return result;
    var voices:Array<Dynamic> = util.scanVoiceFiles(out, audioBase);
    for (v in voices)
    {
      var name:String = util.getString(get(v, 'name'), '');
      if (name == '') continue;
      addSound(out, util.songAudioKeys(songId, 'Voices-$name.ogg'), get(v, 'entry'));
      addSound(out, util.songAudioKeys(songId, 'Voices-$name.mp3'), get(v, 'entry'));
      result.push(name);
    }
    return result;
  }

  // Namespace a stage id that an earlier imported mod already claimed.
  // Deterministic with convertStages (ids are only claimed by earlier mods).
  public function resolveStageId(dir:String, stageId:String):String
  {
    if (stageId == null || stageId == '') return stageId;
    if (util.isForeignTaken('stages', stageId))
    {
      var renamed:String = stageId + '-' + util.modSlug(dir);
      util.warn('Codename: stage "$stageId" is also defined by another imported mod - importing this mod version as "$renamed"');
      return renamed;
    }
    return stageId;
  }

  // Convert an event timestamp to the conductor step at which Codename
  // dispatches it. This accounts for BPM changes, unlike t/(beat length).
  public function eventStep(t:Float, baseBpm:Float, changes:Array<Dynamic>):Int
  {
    var step:Float = 0;
    var prev:Float = 0;
    var currentBpm:Float = baseBpm;
    for (change in changes)
    {
      if (change == null) continue;
      var ct:Float = util.getFloat(get(change, 't'), 0);
      if (ct <= prev || ct > t) continue;
      step += (ct - prev) / (60000 / currentBpm / 4);
      prev = ct;
      var nextBpm:Float = util.getFloat(get(change, 'bpm'), -1);
      if (nextBpm > 0) currentBpm = nextBpm;
    }
    if (t > prev) step += (t - prev) / (60000 / currentBpm / 4);
    return Std.int(Math.floor(step + 0.0001));
  }

  // The BPM in effect at an absolute time (ms), walking accumulated changes.
  public function songBpmAt(t:Float, baseBpm:Float, changes:Array<Dynamic>):Float
  {
    var bpm:Float = baseBpm;
    if (changes != null)
    {
      for (change in changes)
      {
        var ct:Float = util.getFloat(get(change, 't'), 0);
        if (ct > t) continue;
        var nextBpm:Float = util.getFloat(get(change, 'bpm'), -1);
        if (nextBpm > 0) bpm = nextBpm;
      }
    }
    return bpm;
  }

  // Milliseconds per step (a step is a quarter beat) at an absolute time.
  public function stepLengthMsAt(t:Float, baseBpm:Float, changes:Array<Dynamic>):Float
  {
    return 60000.0 / songBpmAt(t, baseBpm, changes) / 4;
  }

  // Map codename events to vslice events. baseBpm is the song's starting BPM
  // (timeChangeOut accumulates 'BPM Change'/'Time Signature Change' entries
  // and is used to convert Codename's step/measure durations to real time).
  public function mapEvents(raw:Array<Dynamic>, songId:String, diff:String, timeChangeOut:Array<Dynamic>, baseBpm:Float = 100):Array<Dynamic>
  {
    var result:Array<Dynamic> = [];
    for (ei in 0...raw.length)
    {
      var ev:Dynamic = raw[ei];
      if (ev == null) continue;
      var name:String = util.getString(get(ev, 'name'), '');
      var t:Float = util.getFloat(get(ev, 'time'), 0);
      var params:Array<Dynamic> = get(ev, 'params');
      if (params == null) params = [];

      if (name == 'BPM Change')
      {
        if (params.length > 0)
        {
          timeChangeOut.push({t: t, bpm: util.getFloat(params[0], 100)});
        }
        continue;
      }
      if (name == 'Time Signature Change')
      {
        var num:Int = 4;
        var den:Int = 4;
        var isSPB:Bool = false;
        if (params.length > 0) num = util.getInt(params[0], 4);
        if (params.length > 1) den = util.getInt(params[1], 4);
        if (params.length > 2) isSPB = util.getBool(params[2], false);
        // Codename's 3rd param indicates denom is stepsPerBeat; V-Slice bt expects beats tuple.
        if (isSPB) timeChangeOut.push({t: t, bpm: -1, bt: [num, den, num, den]});
        else timeChangeOut.push({t: t, bpm: -1, bt: [num, den, num, den]});
        continue;
      }
      if (name == 'Camera Movement')
      {
        // Codename targets the STRUMLINE (0 = dad/opponent, 1 = player,
        // 2 = girlfriend); V-Slice's FocusCamera uses its own char enum
        // (0 = player, 1 = opponent/dad, 2 = girlfriend) - swap 0 and 1.
        var charIdx:Int = 1;
        if (params.length > 0) charIdx = util.getInt(params[0], 1);
        if (charIdx == 1) charIdx = 0;
        else if (charIdx == 0) charIdx = 1;
        // Duration is in steps (time change in params[2]).
        var duration:Float = 4;
        if (params.length > 2) duration = Math.max(0.25, util.getFloat(params[2], 4));
        var ease:String = 'CLASSIC';
        var easeDir:String = 'In';
        if (params.length > 3 && params[3] != null && Std.string(params[3]).toLowerCase() != 'classic')
        {
          ease = mapEaseName(Std.string(params[3]));
          if (params.length > 4) easeDir = Std.string(params[4]);
        }
        if (easeDir == null || easeDir == '') easeDir = 'In';
        result.push({t: t, e: 'FocusCamera', v: {char: charIdx, duration: duration, ease: ease, easeDir: easeDir}});
        continue;
      }
      if (name == 'Camera Position')
      {
        // Codename params: [x, y, tween, time, ease, easeDir, isOffset].
        // Absolute positions map to V-Slice's static focus (char = -1);
        // relative offsets depend on the live camera position so they can't
        // be precomputed here.
        if (params.length > 6 && params[6] == true)
        {
          util.warn('Codename: relative Camera Position skipped in $songId ($diff) (depends on live camera position)');
        }
        else if (params.length >= 2)
        {
          var px:Float = util.getFloat(params[0], 0);
          var py:Float = util.getFloat(params[1], 0);
          var posDur:Float = 4;
          if (params.length > 3) posDur = Math.max(0.25, util.getFloat(params[3], 4));
          var posEase:String = 'quad';
          if (params.length > 4 && params[4] != null && Std.string(params[4]).toLowerCase() == 'classic') posEase = 'CLASSIC';
          else if (params.length > 4 && params[4] != null) posEase = mapEaseName(Std.string(params[4]));
          var posEaseDir:String = 'InOut';
          if (params.length > 5) posEaseDir = Std.string(params[5]);
          if (posEaseDir == null || posEaseDir == '') posEaseDir = 'InOut';
          result.push({t: t, e: 'FocusCamera', v: {char: -1, x: px, y: py, duration: posDur, ease: posEase, easeDir: posEaseDir}});
        }
        continue;
      }
      if (name == 'Camera Zoom')
      {
        // Codename params: [tween?, zoom, camera, time(steps), ease, easeDir, mode, relative].
        // When tween is false Codename snaps the zoom instantly.
        var zoom:Float = 1;
        var duration:Float = 4;
        var ease:String = 'linear';
        var easeDir:String = 'InOut';
        if (params.length > 1) zoom = util.getFloat(params[1], 1);
        if (params.length > 3) duration = Math.max(0.25, util.getFloat(params[3], 4));
        if (params.length > 4) ease = mapEaseName(Std.string(params[4]));
        if (params.length > 5) easeDir = Std.string(params[5]);
        if (easeDir == null || easeDir == '') easeDir = 'InOut';
        var shouldTween:Bool = true;
        if (params.length > 0) shouldTween = util.getBool(params[0], true);
        if (!shouldTween) duration = 0;
        // Pass the codename mode through: 'direct' and 'stage' mean the same
        // thing in V-Slice (zoom x defaultZoom / zoom x stageZoom).
        var mode:String = 'direct';
        if (params.length > 6 && Std.string(params[6]) == 'stage') mode = 'stage';
        result.push({t: t, e: 'ZoomCamera', v: {zoom: zoom, duration: duration, ease: ease, easeDir: easeDir, mode: mode}});
        continue;
      }
      if (name == 'Add Camera Zoom')
      {
        // Codename increments the CURRENT zoom (camera.zoom += amount). V-Slice
        // has no increment event; approximate with a stage-relative step so the
        // direction and rough magnitude match the modest in/out panning intent.
        var amount:Float = 0.015;
        if (params.length > 0) amount = util.getFloat(params[0], 0.015);
        result.push({t: t, e: 'ZoomCamera', v: {zoom: 1 + amount, duration: 1, ease: 'linear', easeDir: 'InOut', mode: 'direct'}});
        continue;
      }
      if (name == 'Set Camera Zoom')
      {
        // Codename: instant absolute zoom (params: [zoom, tween?, duration?]).
        var zoom:Float = 1;
        if (params.length > 0) zoom = util.getFloat(params[0], 1);
        result.push({t: t, e: 'ZoomCamera', v: {zoom: zoom, duration: 0, ease: 'linear', easeDir: 'InOut', mode: 'direct'}});
        continue;
      }
      if (name == 'Tween Camera')
      {
        // Codename: params [target, value, duration(steps), ease, easeDir].
        // Only the zoom variant is portable; position tweens are skipped.
        var tweenTarget:String = params.length > 0 ? Std.string(params[0]) : '';
        if (tweenTarget != null && tweenTarget.toLowerCase() == 'zoom' && params.length > 1)
        {
          var zoom:Float = util.getFloat(params[1], 1);
          var duration:Float = 4;
          if (params.length > 2) duration = Math.max(0.25, util.getFloat(params[2], 4));
          var ease:String = 'linear';
          var easeDir:String = 'InOut';
          if (params.length > 3) ease = mapEaseName(Std.string(params[3]));
          if (params.length > 4) easeDir = Std.string(params[4]);
          if (easeDir == null || easeDir == '') easeDir = 'InOut';
          result.push({t: t, e: 'ZoomCamera', v: {zoom: zoom, duration: duration, ease: ease, easeDir: easeDir, mode: 'direct'}});
        }
        else
        {
          util.warn('Codename: non-zoom Tween Camera skipped in $songId ($diff)');
        }
        continue;
      }
      if (name == 'Camera Bop')
      {
        var intensity:Float = 1;
        if (params.length > 0) intensity = util.getFloat(params[0], 1);
        result.push({t: t, e: 'SetCameraBop', v: {rate: 1, offset: 0, intensity: intensity}});
        continue;
      }
      if (name == 'Scroll Speed Change')
      {
        var scroll:Float = 1;
        var duration:Float = 4;
        var absolute:Bool = true;
        if (params.length > 1) scroll = util.getFloat(params[1], 1);
        if (params.length > 2) duration = Math.max(0.25, util.getFloat(params[2], 4));
        if (params.length > 5) absolute = !util.getBool(params[5], false);
        result.push({t: t, e: 'ScrollSpeed', v: {scroll: scroll, duration: duration, absolute: absolute, strumline: 'both'}});
        continue;
      }
      if (name == 'Play Animation')
      {
        var target:String = 'boyfriend';
        var anim:String = 'idle';
        var force:Bool = true;
        if (params.length > 0) target = strumlineName(util.getInt(params[0], 1));
        if (params.length > 1) anim = Std.string(params[1]);
        if (params.length > 2) force = util.getBool(params[2], true);
        result.push({t: t, e: 'PlayAnimation', v: {target: target, anim: anim, force: force}});
        continue;
      }
      if (name == 'Camera Flash' || name == 'Fancy Camera Flash')
      {
        // Codename params: [reversed, colorHex, durationSteps, camera?]
        // The duration is in STEPS; convert to seconds with the step length
        // in effect at this event's time (BPM changes included).
        var color:String = '#FFFFFF';
        var duration:Float = 0.5;
        var target:String = 'game';
        if (params.length > 1 && params[1] != null) color = Std.string(params[1]);
        if (params.length > 2 && params[2] != null)
        {
          var flashSteps:Float = Math.max(1, util.getFloat(params[2], 1));
          duration = Math.max(0.05, flashSteps * stepLengthMsAt(t, baseBpm, timeChangeOut) / 1000.0);
        }
        if (params.length > 3 && params[3] != null) target = Std.string(params[3]);
        if (color == null || color == '') color = '#FFFFFF';
        result.push({t: t, e: 'FunkyCompatFlash', v: {color: color, duration: duration, target: target}});
        continue;
      }
      if (name == 'Camera Modulo Change')
      {
        // Codename params: [interval, strength, type(BEAT/STEP/MEASURE), offset].
        // Zooms the camera ONCE PER interval; V-Slice's SetCameraBop rate is
        // in beats (and 1 beat = 4 steps = 1/4 of a measure), so normalize
        // the interval/offset into beats.
        var interval:Float = 4;
        var strength:Float = 1;
        var offset:Float = 0;
        var modUnit:String = 'BEAT';
        if (params.length > 0) interval = Math.max(0.25, util.getFloat(params[0], 4));
        if (params.length > 1) strength = util.getFloat(params[1], 1);
        if (params.length > 2 && params[2] != null) modUnit = Std.string(params[2]).toUpperCase();
        if (params.length > 3) offset = util.getFloat(params[3], 0);
        if (modUnit == 'STEP')
        {
          interval = interval / 4;
          offset = offset / 4;
        }
        else if (modUnit == 'MEASURE')
        {
          interval = interval * 4;
          offset = offset * 4;
        }
        result.push({t: t, e: 'SetCameraBop', v: {rate: interval, intensity: strength, offset: offset}});
        continue;
      }
      if (name == 'Alt Animation Toggle')
      {
        // The SING half is folded into per-note kinds at conversion time
        // (buildAltSpans); the IDLE half is a runtime character property, so
        // it is emitted as the layer's FunkyCompatAltIdle event (on and off).
        if (params.length > 1 && params[1] != null)
        {
          var idleToggle:Bool = util.getBool(params[1], false);
          var toggleLine:Int = params.length > 2 ? util.getInt(params[2], 0) : 0;
          result.push({t: t, e: 'FunkyCompatAltIdle', v: {line: toggleLine, on: idleToggle}});
        }
        continue;
      }
      if (name == 'Continuous BPM Change')
      {
        // Interpolate BPM linearly from current to target over steps.
        var targetBpm:Float = params.length > 0 ? util.getFloat(params[0], 100) : 100;
        var steps:Float = params.length > 1 ? util.getFloat(params[1], 4) : 4;
        // Approximate by inserting intermediate timeChange at end of interpolation
        timeChangeOut.push({t: t, bpm: targetBpm});
        continue;
      }
      if (name == 'HScript Call')
      {
        // Fired as a dedicated event so the song-choreography player can
        // replay the portable actions extracted from the named function
        // body (DynStage separately replays stage-scope calls).
        var callFn:String = params.length > 0 ? Std.string(params[0]) : '';
        if (callFn != '') result.push({t: t, e: 'FunkyCompatChoreoCall', v: {fn: callFn}});
        continue;
      }
      if (name == 'Move Strumline' || name == 'Cinematics' || name == 'camera_captain')
      {
        // Cinematics already handled as stepFx cinematic; Move Strumline is HUD layout - skip with low warning.
        continue;
      }
      // Custom events: forward as generic vslice event to allow mods to handle via custom handlers.
      if (name != null && name != '')
      {
        // Try to preserve params generically
        var v:Dynamic = {};
        for (pi in 0...params.length) ReflectUtil.setAnonymousField(v, 'p' + pi, params[pi]);
        result.push({t: t, e: name, v: v});
        continue;
      }
      util.warn('Codename: unhandled event "$name" in $songId ($diff)');
    }
    return result;
  }

  public function codenameSingAnim(id:Int):String
  {
    switch (id % 4)
    {
      case 0: return 'singLEFT';
      case 1: return 'singDOWN';
      case 2: return 'singUP';
      default: return 'singRIGHT';
    }
  }

  public function strumlineName(idx:Int):String
  {
    if (idx == 0) return 'dad';
    if (idx == 2) return 'girlfriend';
    return 'boyfriend';
  }

  // 'Alt Animation Toggle' events flip a strumline's notes to '-alt'
  // animations from the toggle until the NEXT toggle for that strumline (or
  // the chart end). Fold this into V-Slice's per-note kind mechanism: return
  // [{line, s, e}] spans; notes inside get the layer's 'alt' note kind
  // (registered separately), whose suffix makes characters play their
  // '-alt' sing animations. Strstumline indices follow the chart's strumLines
  // array (0 = opponent/dad, 1 = player, 2 = girlfriend).
  public function buildAltSpans(chart:Dynamic):Array<Dynamic>
  {
    var spans:Array<Dynamic> = [];
    var events:Dynamic = chart == null ? null : get(chart, 'events');
    if (events == null) return spans;
    var toggles:Array<Dynamic> = [];
    for (evt in events)
    {
      if (evt == null) continue;
      if (util.getString(get(evt, 'name'), '') != 'Alt Animation Toggle') continue;
      var tp:Dynamic = get(evt, 'params');
      if (tp == null || tp.length < 1) continue;
      toggles.push({line: tp.length > 2 ? util.getInt(tp[2], 0) : 0, t: util.getFloat(get(evt, 'time'), 0), sing: util.getBool(tp[0], false)});
    }
    if (toggles.length == 0) return spans;
    toggles.sort(function(a:Dynamic, b:Dynamic):Int
    {
      var ta:Float = util.getFloat(get(a, 't'), 0);
      var tb:Float = util.getFloat(get(b, 't'), 0);
      if (ta < tb) return -1;
      if (ta > tb) return 1;
      return 0;
    });

    // An open-ended toggle runs to the chart's last note (+5s safety tail).
    var chartEndMs:Float = 600000;
    var lastNoteTime:Float = 0;
    var lines:Dynamic = chart == null ? null : get(chart, 'strumLines');
    if (lines != null)
    {
      for (ln in lines)
      {
        var lnNotes:Dynamic = ln == null ? null : get(ln, 'notes');
        if (lnNotes == null) continue;
        for (n in lnNotes)
        {
          if (n == null) continue;
          var nt:Float = util.getFloat(get(n, 'time'), 0);
          if (nt > lastNoteTime) lastNoteTime = nt;
        }
      }
    }
    if (lastNoteTime > 0) chartEndMs = lastNoteTime + 5000;

    // Flip on/off per strumline.
    var open:Dynamic = {};
    for (tg in toggles)
    {
      var line:Int = util.getInt(get(tg, 'line'), 0);
      var sing:Bool = get(tg, 'sing') == true;
      var t:Float = util.getFloat(get(tg, 't'), 0);
      var prev:Dynamic = get(open, line);
      if (prev != null)
      {
        if (get(prev, 'sing') == true) spans.push({line: line, s: util.getFloat(get(prev, 't'), 0), e: t});
        set(open, line, null);
      }
      if (sing) set(open, line, tg);
    }
    for (lineKey in ReflectUtil.fields(open))
    {
      var remaining:Dynamic = get(open, lineKey);
      if (remaining != null && get(remaining, 'sing') == true)
      {
        spans.push({line: Std.parseInt(lineKey), s: util.getFloat(get(remaining, 't'), 0), e: chartEndMs});
      }
    }
    return spans;
  }

  // Whether a note (strumline index + time in ms) falls inside an alt span.
  public function inAltSpan(spans:Array<Dynamic>, line:Int, t:Float):Bool
  {
    if (spans == null) return false;
    for (span in spans)
    {
      if (span == null) continue;
      if (util.getInt(get(span, 'line'), -1) != line) continue;
      if (t >= util.getFloat(get(span, 's'), 0) - 0.001 && t <= util.getFloat(get(span, 'e'), 0)) return true;
    }
    return false;
  }

  // V-Slice chart events are a single flat array shared by every difficulty
  // (SongChartData.events). Codename charts carry per-difficulty events, so
  // merge them all and drop exact duplicates (e.g. the same global event
  // appearing in each difficulty's list).
  public function appendUnique(target:Array<Dynamic>, seen:Dynamic, items:Array<Dynamic>):Void
  {
    if (items == null) return;
    for (item in items)
    {
      if (item == null) continue;
      var key:String = Std.string(get(item, 't')) + '|' + Std.string(get(item, 'e')) + '|' + util.stringify(get(item, 'v'));
      if (get(seen, key) == true) continue;
      set(seen, key, true);
      target.push(item);
    }
  }

  // Map a Codename difficulty name to a V-Slice difficulty id: lowercase,
  // non-alphanumerics collapsed to single hyphens ("Normal-Erect" ->
  // "normal-erect"). The base ids easy/normal/hard/erect/nightmare come out
  // identical to the game's built-in ids, so the freeplay difficulty filter
  // matches them.
  public function vsliceDiffId(raw:String):String
  {
    if (raw == null) return '';
    var lower:String = raw.toLowerCase();
    var out:String = '';
    var pendingDash:Bool = false;
    for (i in 0...lower.length)
    {
      var ch:String = lower.charAt(i);
      var ok:Bool = (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9');
      if (ok)
      {
        if (pendingDash && out != '') out += '-';
        pendingDash = false;
        out += ch;
      }
      else
      {
        pendingDash = true;
      }
    }
    return out;
  }

  public function isPrimitive(v:Dynamic):Bool
  {
    return (v == null || Std.isOfType(v, String) || Std.isOfType(v, Float) || Std.isOfType(v, Int) || v == true || v == false);
  }

  // Legacy psych-format sections -> vslice notes + time changes.
  // instEndMs: instrumental length (ms) or null - notes past it are dropped
  // (unreachable once the song ends with the audio; see probeInstEndMs).
  public function convertLegacyChart(song:Dynamic, startBpm:Float, notesOut:Array<Dynamic>, eventsOut:Array<Dynamic>, timeChangesOut:Array<Dynamic>, instEndMs:Null<Float> = null):Void
  {
    var sections:Array<Dynamic> = get(song, 'notes');
    if (sections == null) return;

    var trimmedNotes:Int = 0;

    var currentBpm:Float = startBpm;
    var currentTime:Float = 0.0;
    var currentBeat:Float = 0.0;
    var lastCamChar:Int = -99;

    // Same old-format detection as the Psych importer: OLD-format charts
    // (17Bucks-style) keep the whole melody on data 0-3 and let mustHitSection
    // flip which side is the player's - the 4-7 lane is barely used. MODERN
    // psych charts author a full opponent part on 4-7 (comparable note counts
    // to the 0-3 lane), so flipping those would swap the opponent's part onto
    // the player's side. Flip only when 4-7 carries clearly the minority of
    // the chart (below 75% of the 0-3 count; all classic charts sit well
    // under, modern ones near/above parity - e.g. GUNLICK's philly nice).
    var flipSections:Bool = false;
    var totalLow:Int = 0;
    var totalHigh:Int = 0;
    for (se0 in sections)
    {
      if (se0 == null) continue;
      var sn0:Array<Dynamic> = get(se0, 'sectionNotes');
      if (sn0 == null) continue;
      for (ni1 in 0...sn0.length)
      {
        var nd0:Int = util.getInt(sn0[ni1][1], 0);
        if (nd0 >= 4) totalHigh++; else totalLow++;
      }
    }
    if (totalLow > 0 && totalHigh < totalLow * 0.75) flipSections = true;

    for (si in 0...sections.length)
    {
      var section:Dynamic = sections[si];
      if (section == null) continue;

      var beats:Int = util.getInt(get(section, 'sectionBeats'), 4);
      if (beats <= 0) beats = 4;

      var changeBpm:Bool = util.getBool(get(section, 'changeBPM'), false);
      var newBpm:Float = util.getFloat(get(section, 'bpm'), currentBpm);
      if (changeBpm && newBpm > 0)
      {
        timeChangesOut.push({t: currentTime, b: currentBeat, bpm: newBpm, bt: [4, 4, 4, 4]});
        currentBpm = newBpm;
      }

      // Classic Psych charts drive the CAMERA from mustHitSection instead of
      // chart events - emit a FocusCamera event at each section boundary
      // (0 = bf, 1 = dad) so V-Slice follows the source engine's focus.
      var camChar:Int = util.getBool(get(section, 'mustHitSection'), false) ? 0 : 1;
      if (camChar != lastCamChar)
      {
        eventsOut.push({t: currentTime, e: 'FocusCamera', v: {char: camChar, duration: 2, ease: 'sine', easeDir: 'InOut'}});
        lastCamChar = camChar;
      }

      var sectionNotes:Array<Dynamic> = get(section, 'sectionNotes');
      if (sectionNotes != null)
      {
        for (ni in 0...sectionNotes.length)
        {
          var note:Dynamic = sectionNotes[ni];
          if (note == null) continue;
          var t:Float = util.getFloat(note[0], 0);
          var d:Int = util.getInt(note[1], 0);
          var sus:Float = util.getFloat(note[2], 0);
          // Per-note psych types (defaultNoteTypes): 4 = 'GF Sing' (the
          // girlfriend sings this note), 5 = 'No Animation'.
          var noteType:Null<String> = null;
          if (note.length > 3 && get(note, 3) != null)
          {
            var ntr:Dynamic = get(note, 3);
            if (Std.isOfType(ntr, Int) || Std.isOfType(ntr, Float))
            {
              switch (util.getInt(ntr, 0))
              {
                case 4: noteType = 'GF Sing';
                case 5: noteType = 'No Animation';
              }
            }
            else noteType = Std.string(ntr);
          }
          // Both engines use the same lane convention: noteData < 4 is the
          // PLAYER's strumline (Psych: mustPress = data < 4; V-Slice:
          // getStrumlineIndex = floor(data/4), 0 = player). Old-format charts
          // flip the player side with mustHitSection, so remap per section.
          var vsliceD:Int = d;
          if (flipSections && !util.getBool(get(section, 'mustHitSection'), false))
          {
            vsliceD = (d + 4) % 8;
          }
          // Psych gfNote mechanic: in gfSection sections the notes on the
          // must-hit side are sung by the girlfriend - animate the gf slot.
          if (noteType == 'GF Sing' || (util.getBool(get(section, 'gfSection'), false) && util.getBool(get(section, 'mustHitSection'), false) == (d < 4)))
          {
            var gfAnim:String = 'singRIGHT';
            switch (d % 4)
            {
              case 0: gfAnim = 'singLEFT';
              case 1: gfAnim = 'singDOWN';
              case 2: gfAnim = 'singUP';
            }
            eventsOut.push({t: t, e: 'PlayAnimation', v: {target: 'gf', anim: gfAnim, force: true}});
          }
          var noteObj:Dynamic = {t: t, d: vsliceD};
          if (sus > 0)
          {
            // Clip hold tails that would stretch past the audio's end; see
            // probeInstEndMs - the song ends when the instrumental does.
            if (instEndMs != null && t + sus > instEndMs) sus = Math.max(0, instEndMs - t);
            if (sus > 0) noteObj.l = sus;
          }
          if (noteType == 'No Animation') noteObj.k = 'noanim';
          // Notes charted past the end of the audio can never be hit, but
          // still count against the results-screen completion percent.
          if (instEndMs != null && t > instEndMs)
          {
            trimmedNotes++;
            continue;
          }
          notesOut.push(noteObj);
        }
      }

      var beatMs:Float = 60000.0 / currentBpm;
      currentTime += beats * beatMs;
      currentBeat += beats;
    }
    if (trimmedNotes > 0)
    {
      util.warn('Codename: legacy chart trimmed $trimmedNotes note(s) past the instrumental end (unreachable, would only lower the clear percentage)');
    }
  }

  // Legacy psych event tuples (time, [[name, v1, v2], ...]) -> vslice events.
  public function convertLegacyEvents(rawEvents:Dynamic):Array<Dynamic>
  {
    var result:Array<Dynamic> = [];
    if (rawEvents == null) return result;
    for (ei in 0...rawEvents.length)
    {
      var entry:Dynamic = rawEvents[ei];
      if (entry == null) continue;
      var t:Float = util.getFloat(entry[0], 0);
      var list:Dynamic = entry[1];
      if (list == null) continue;
      for (ii in 0...list.length)
      {
        var item:Dynamic = list[ii];
        if (item == null) continue;
        var name:String = util.getString(item[0], '');
        var converted:Null<Dynamic> = mapLegacyEvent(name, item[1], item[2]);
        if (converted != null)
        {
          converted.t = t;
          result.push(converted);
        }
      }
    }
    return result;
  }

  public function mapLegacyEvent(name:String, v1:Dynamic, v2:Dynamic):Null<Dynamic>
  {
    if (name == 'Set Camera Target')
    {
      var char:Int = 1;
      if (v1 == null) char = 1;
      else if (Std.isOfType(v1, Int) || Std.isOfType(v1, Float)) char = util.getInt(v1, 1);
      else
      {
        var raw:String = Std.string(v1).toLowerCase();
        if (raw == 'dad' || raw == 'opponent') char = 0;
        if (raw == 'gf' || raw == 'girlfriend') char = 2;
      }
      return {e: 'FocusCamera', v: {char: char}};
    }
    if (name == 'Set Camera Zoom')
    {
      var zoom:Float = util.getFloat(v1, 1);
      var duration:Float = 4;
      if (v2 != null)
      {
        var parts:Array<String> = Std.string(v2).split(',');
        var dur:Float = Std.parseFloat(StringTools.trim(parts[0]));
        if (!Math.isNaN(dur)) duration = dur;
      }
      return {e: 'ZoomCamera', v: {zoom: zoom, duration: duration, ease: 'linear', mode: 'direct'}};
    }
    if (name == 'Hey!')
    {
      var target:String = 'boyfriend';
      var raw:String = Std.string(v1).toLowerCase();
      if (raw == 'dad' || raw == 'opponent') target = 'dad';
      if (raw == 'gf' || raw == 'girlfriend') target = 'girlfriend';
      return {e: 'PlayAnimation', v: {target: target, anim: 'hey', force: true}};
    }
    return null;
  }

  public function mapEaseName(nameRaw:String):String
  {
    var name:String = StringTools.trim(nameRaw).toLowerCase();
    // V-Slice composes 'ease' + 'easeDir' into the FlxEase symbol, so this
    // returns the BASE name ('quad' + 'Out' -> FlxEase.quadOut). Baked
    // directions in the source ('sineInOut') are stripped back to the base.
    if (name == '' || name == 'classic') return 'linear';
    if (name == 'linear') return 'linear';
    if (StringTools.endsWith(name, 'inout')) name = name.substring(0, name.length - 5);
    else if (StringTools.endsWith(name, 'out')) name = name.substring(0, name.length - 3);
    else if (StringTools.endsWith(name, 'in') && name.length > 3) name = name.substring(0, name.length - 2);
    switch (name)
    {
      case 'cubic': return 'cube';
      case 'smoothstep': return 'smoothStep';
      case 'smootherstep': return 'smootherStep';
      default: return name;
    }
  }

  // ------------------------------------------------------------------
  // Audio length probing
  // ------------------------------------------------------------------

  // Some Codename charts outlive their audio (the track was shortened after
  // charting, e.g. gumballs' "memory card"). V-Slice - like Codename itself -
  // ends the song when the instrumental completes, so notes past the end are
  // unreachable, yet they still count against the results screen's completion
  // percentage, capping a perfect run below 100%. Resolve the instrumental
  // the same way addCodenameAudio does and return its length in ms, or null
  // when it can't be determined (missing audio, non-OGG container).
  public function probeInstEndMs(dir:String, folder:String, meta:Dynamic):Null<Float>
  {
    var songBase:String = 'mods/$dir/songs/$folder/song';
    var instSuffix:String = util.getString(get(meta, 'instSuffix'), '');
    var instFile:String = 'Inst.ogg';
    if (instSuffix != null && instSuffix != '') instFile = 'Inst-$instSuffix.ogg';
    var bytes:ByteArray = util.readBytes('$songBase/$instFile');
    if (bytes == null && instFile != 'Inst.ogg') bytes = util.readBytes('$songBase/Inst.ogg');
    if (bytes == null || bytes.length < 40) return null;
    return probeOggMs(bytes);
  }

  // Vorbis duration from the OGG container: walk the pages and take the last
  // granule position (total decoded samples), divided by the sample rate from
  // the identification header. Returns ms, or null if the file isn't a valid
  // Vorbis stream. Mirrors a plain OGG page walk: 'OggS' header, granule at
  // 6..14, segment count at 26, lacing table, then the page body.
  function probeOggMs(bytes:ByteArray):Null<Float>
  {
    if (bytes.get(0) != 0x4F || bytes.get(1) != 0x67 || bytes.get(2) != 0x67 || bytes.get(3) != 0x53) return null; // 'OggS'

    // Sample rate: the vorbis identification packet ('\x01vorbis', version,
    // channels, then a 4-byte sample rate) starts after the first page's
    // 27-byte header and its lacing table.
    var segCount:Int = bytes.get(26);
    var ident:Int = 27 + segCount;
    var sampleRate:Int = 0;
    if (ident + 16 < bytes.length && bytes.get(ident) == 0x01 && bytes.get(ident + 1) == 0x76 && bytes.get(ident + 2) == 0x6F
      && bytes.get(ident + 3) == 0x72 && bytes.get(ident + 4) == 0x62 && bytes.get(ident + 5) == 0x69 && bytes.get(ident + 6) == 0x73)
    {
      sampleRate = le32(bytes, ident + 12);
    }
    if (sampleRate <= 0) return null;

    var pos:Int = 0;
    var lastGranule:Float = -1;
    while (pos + 27 <= bytes.length)
    {
      if (bytes.get(pos) != 0x4F || bytes.get(pos + 1) != 0x67 || bytes.get(pos + 2) != 0x67 || bytes.get(pos + 3) != 0x53) break;
      var segs:Int = bytes.get(pos + 26);
      var pageLen:Int = 27 + segs;
      if (pos + pageLen > bytes.length) break;
      for (s in 0...segs)
      {
        pageLen += bytes.get(pos + 27 + s);
      }
      if (pos + pageLen > bytes.length) break;

      // Granule is a 64-bit unsigned sample count; combine hi/lo as Float so
      // no precision is lost well past any song length.
      var lo:Int = le32(bytes, pos + 6);
      var hi:Int = le32(bytes, pos + 10);
      var granule:Float = hi * 4294967296.0 + (lo >= 0 ? lo : lo + 4294967296.0);
      if (granule > 0) lastGranule = granule;
      pos += pageLen;
    }
    if (lastGranule <= 0) return null;
    return lastGranule / sampleRate * 1000.0;
  }

  // Little-endian 32-bit read (ByteArray alignment-independent).
  function le32(bytes:ByteArray, off:Int):Int
  {
    return bytes.get(off) | (bytes.get(off + 1) << 8) | (bytes.get(off + 2) << 16) | (bytes.get(off + 3) << 24);
  }

  public function addCodenameAudio(dir:String, folder:String, songId:String, player:String, opponent:String, meta:Dynamic, out:Dynamic):Void
  {
    var songBase:String = 'mods/$dir/songs/$folder/song';

    var instSuffix:String = util.getString(get(meta, 'instSuffix'), '');
    var instFile:String = 'Inst.ogg';
    if (instSuffix != null && instSuffix != '') instFile = 'Inst-$instSuffix.ogg';
    var instEntry:Dynamic = util.resolveFileEntry(out, '$songBase/$instFile');
    if (instEntry == null && instFile != 'Inst.ogg')
    {
      instSuffix = '';
      instFile = 'Inst.ogg';
      instEntry = util.resolveFileEntry(out, '$songBase/Inst.ogg');
    }
    if (instEntry == null) instEntry = util.resolveFileEntry(out, '$songBase/Inst.mp3');
    if (instEntry != null)
    {
      addSound(out, util.songAudioKeys(songId, 'Inst.ogg'), instEntry);
      if (instFile != 'Inst.ogg')
      {
        addSound(out, util.songAudioKeys(songId, instFile), instEntry);
      }
    }

    var vocalsSuffix:String = util.getString(get(meta, 'vocalsSuffix'), '');
    var voicesFile:String = 'Voices.ogg';
    if (vocalsSuffix != null && vocalsSuffix != '') voicesFile = 'Voices-$vocalsSuffix.ogg';
    var voicesEntry:Dynamic = util.resolveFileEntry(out, '$songBase/$voicesFile');
    if (voicesEntry == null && voicesFile != 'Voices.ogg') voicesEntry = util.resolveFileEntry(out, '$songBase/Voices.ogg');
    if (voicesEntry != null)
    {
      addSound(out, util.songAudioKeys(songId, 'Voices-$player.ogg'), voicesEntry);
      addSound(out, util.songAudioKeys(songId, 'Voices-$opponent.ogg'), voicesEntry);
      addSound(out, util.songAudioKeys(songId, 'Voices.ogg'), voicesEntry);
    }
  }

  // ------------------------------------------------------------------
  // Characters (XML -> JSON)
  // ------------------------------------------------------------------

  public function convertCharacters(dir:String, out:Dynamic):Void
  {
    var charsRoot:String = 'mods/$dir/data/characters';
    if (!util.pathExists(charsRoot)) return;
    var charFiles:Array<String> = util.listDir(charsRoot);
    for (charFile in charFiles)
    {
      if (!StringTools.endsWith(charFile.toLowerCase(), '.xml')) continue;
      // Raw base name = on-disk file -> also the sprite sheet's default name.
      // resolveCharId may rename the CHARACTER id (e.g. 'bf' -> 'bf-fc') to
      // dodge a built-in collision, but the SPRITE folder keeps the raw name.
      var rawCharId:String = charFile.substring(0, charFile.length - 4);
      charId = resolveCharId(dir, rawCharId);
      var xmlText:String = util.readText('$charsRoot/$charFile');
      if (xmlText == null) continue;

      var root:String = extractFirstTag(xmlText, 'character');
      var spriteName:String = attr(root, 'sprite');
      if (spriteName == null || spriteName == '') spriteName = rawCharId;

      // When the character id was namespaced (built-in or cross-mod
      // collision) the sprite art must be re-keyed too: the shared cache
      // keeps ONE 'characters/<name>.xml/.png' per path, so two mods mustn't
      // both register under the raw sprite name. The frames inside the
      // atlas (and thus the sprite's default name) stay the raw one.
      var artBase:String = spriteName;
      if (charId != rawCharId) artBase = spriteName + charId.substring(rawCharId.length);

      // Codename multi-spritesheet characters: the sprite value is a FOLDER
      // (images/characters/<sprite>/1.png+1.xml, 2.png+2.xml, ...) whose
      // numbered atlases Codename concatenates into one character (its
      // Path.loadFrames scans '<path>/1.png', '<path>/2.png', ...). V-Slice's
      // MultiSparrowCharacter mirrors this: a primary sparrow atlas plus
      // per-animation sub-atlases (combineAtlas). Sheet 1 becomes the primary
      // atlas; every other sheet is attached to the animations whose frame
      // prefixes live there.
      var multiSheets:Array<String> = [];
      var sheetScan:Int = 1;
      while (util.pathExists('mods/$dir/images/characters/$spriteName/$sheetScan.xml'))
      {
        multiSheets.push(Std.string(sheetScan));
        sheetScan++;
      }
      var isMultiSparrow:Bool = multiSheets.length > 1;
      var sheetTexts:Dynamic = {};
      if (isMultiSparrow)
      {
        for (msi in 0...multiSheets.length)
        {
          set(sheetTexts, multiSheets[msi], util.readText('mods/$dir/images/characters/$spriteName/${multiSheets[msi]}.xml'));
        }
      }
      var isAnimateAtlas:Bool = false;
      if (!isMultiSparrow)
      {
        var probeAnim:String = util.readText('mods/$dir/images/characters/$spriteName/Animation.json');
        if (probeAnim != null) isAnimateAtlas = true;
        else if (util.pathExists('mods/$dir/images/characters/$spriteName/spritemap1.json')) isAnimateAtlas = true;
      }

      var animations:Array<Dynamic> = [];
      var animBodies:Array<String> = extractTags(xmlText, 'anim');
      for (ai in 0...animBodies.length)
      {
        var body:String = animBodies[ai];
        var animOut:Dynamic = {
          name: attr(body, 'name'),
          prefix: attr(body, 'anim'),
          frameRate: parseIntAttr(body, 'fps', 24),
          looped: boolAttr(body, 'loop', false),
          animType: isAnimateAtlas ? "symbol" : "framelabel"
        };
        var ax:Int = parseIntAttr(body, 'x', 0);
        var ay:Int = parseIntAttr(body, 'y', 0);
        if (ax != 0 || ay != 0)
        {
          animOut.offsets = [ax, ay];
        }
        var indicesRaw:String = attr(body, 'indices');
        if (indicesRaw != null && indicesRaw != '')
        {
          animOut.frameIndices = expandIndices(indicesRaw);
        }
        if (animOut.name == null || animOut.name == '') animOut.name = 'idle';
        if (animOut.prefix == null || animOut.prefix == '') animOut.prefix = animOut.name;
        if (isMultiSparrow)
        {
          // Route this animation to the numbered sheet that contains its
          // frame prefix (defaults to sheet 1 = the primary atlas).
          for (msi in 0...multiSheets.length)
          {
            var sidx:String = multiSheets[msi];
            if (sidx == '1') continue;
            var sheetText:String = Std.string(get(sheetTexts, sidx));
            if (sheetText != null && sheetText != '' && xmlHasPrefix(sheetText, Std.string(animOut.prefix)))
            {
              animOut.assetPath = 'characters/$artBase/$sidx';
              break;
            }
          }
        }
        animations.push(animOut);
      }

      trace('[FUNKY-COMPAT] character $rawCharId sprite $spriteName isAnimate=$isAnimateAtlas isMulti=$isMultiSparrow');
      var renderTypeStr:String = isMultiSparrow ? 'multisparrow' : (isAnimateAtlas ? 'animateatlas' : 'sparrow');
      var charData:Dynamic = {
        version: '1.0.1',
        name: charId,
        renderType: renderTypeStr,
        // NOTE: no 'shared:' prefix - SparrowCharacter passes assetPath
        // straight into Paths.getSparrowAtlas(), which resolves it against
        // the shared AND preload key forms we cache.
        assetPath: 'characters/$artBase',
        scale: floatAttr(root, 'scale', 1),
        flipX: boolAttr(root, 'flipX', false),
        // Codename uses antialiasing="false" for pixel characters.
        isPixel: boolAttr(root, 'antialiasing', true) == false,
        applyStageMatrix: boolAttr(root, 'applyStageMatrix', false),
        // Codename's root x/y are globalOffset, applied as a flixel OFFSET
        // (offset.x *= (isPlayer != playerOffsets ? 1 : -1), offset.y = -y)
        // which moves the GRAPHIC opposite the sprite position. V-Slice's
        // offsets are globalOffsets, added TO the position - the opposite
        // semantics. Zero them here and bake the effect into each stage
        // anchor instead (see placeAnchor).
        offsets: [0, 0],
        cameraOffsets: [parseIntAttr(root, 'camx', 0), parseIntAttr(root, 'camy', 0)],
        singTime: floatAttr(root, 'holdTime', 8),
        danceEvery: floatAttr(root, 'interval', 1),
        animations: animations
      };
      // Preserve Codename-specific character attributes generically.
      var goc:String = attr(root, 'gameOverChar');
      if (goc != null && goc != '') set(charData, 'gameOverCharacter', goc);
      var colStr:String = attr(root, 'color');
      if (colStr != null && colStr != '') set(charData, 'healthColor', colStr);
      // Generic <property> tags: copy as extra fields so custom scripts can read them.
      var propTags:Array<String> = extractTags(xmlText, 'property');
      for (pt in propTags)
      {
        var pName:String = attr(pt, 'name');
        var pVal:String = attr(pt, 'value');
        var pType:String = attr(pt, 'type');
        if (pName == null || pName == '' || pVal == null) continue;
        var v:Dynamic = pVal;
        if (pType == 'Float' || pType == 'float') v = Std.parseFloat(pVal);
        else if (pType == 'Int' || pType == 'int') v = Std.parseInt(pVal);
        else if (pType == 'Bool' || pType == 'bool') v = (pVal.toLowerCase() == 'true');
        set(charData, pName, v);
      }
      if (animations.length > 0)
      {
        var hasIdle:Bool = false;
        for (a in animations) if (Std.string(get(a, 'name')).toLowerCase() == 'idle') { hasIdle = true; break; }
        if (!hasIdle) set(charData, 'startingAnimation', Std.string(get(animations[0], 'name')));
      }
      // Targeted fix for awesomemod's bf-awesome facing (vslice bf on right should face left)
      if (charId == "bf-awesome") set(charData, 'flipX', true);
      if (isMultiSparrow)
      {
        set(charData, 'renderType', 'multisparrow');
        set(charData, 'assetPath', 'characters/$artBase/1');
      }

      addText(out, util.dataTextKeys('characters/$charId.json'), util.stringify(charData));
      out.chars.push(charId);
      util.claimForeign('chars', charId);

      // Frame dimensions + base scale for stage anchor conversion. Prefer
      // the IDLE frame's size: the character rests on the idle animation, so
      // the feet line (and the stage anchor) follows it, not the first
      // (often a sing) sub-texture.
      var fw:Float = 640;
      var fh:Float = 640;
      var fw0:Float = 640;
      var fh0:Float = 640;
      if (isAnimateAtlas)
      {
        var smJson2:String = util.readText('mods/$dir/images/characters/$spriteName/spritemap1.json');
        if (smJson2 != null)
        {
          if (smJson2.length > 0 && smJson2.charCodeAt(0) == 0xFEFF) smJson2 = smJson2.substring(1);
          try
          {
            var smData:Dynamic = Json.parse(smJson2);
            var atlas:Dynamic = get(smData, 'ATLAS');
            var sprs:Dynamic = null;
            if (atlas != null) sprs = get(atlas, 'SPRITES');
            if (sprs == null) sprs = get(smData, 'SPRITES');
            if (sprs != null && sprs.length > 0)
            {
              var first:Dynamic = sprs[0];
              var spr:Dynamic = get(first, 'SPRITE');
              if (spr == null) spr = first;
              if (spr != null)
              {
                var w:Float = util.getFloat(get(spr, 'w'), 300);
                var h:Float = util.getFloat(get(spr, 'h'), 300);
                if (w > 0) fw = w;
                if (h > 0) fh = h;
                fw0 = fw; fh0 = fh;
              }
            }
          }
          catch (e:Dynamic) { trace('[FUNKY-COMPAT] spritemap parse failed for $spriteName: $e'); }
        }
      }
      else
      {
        var atlasText:String;
        if (isMultiSparrow)
        {
          atlasText = Std.string(get(sheetTexts, '1'));
        }
        else
        {
          atlasText = util.readText('mods/$dir/images/characters/$spriteName.xml');
        }
        if (atlasText != null && atlasText != '')
      {
        var subs:Array<String> = extractTags(atlasText, 'SubTexture');
        if (subs.length > 0)
        {
          // Codename's character HITBOX (which its getMidpoint() uses for the
          // camera) stays on the FIRST sub-texture's source size.
          var firstBw:Float = floatAttr(subs[0], 'frameWidth', 0);
          var firstBh:Float = floatAttr(subs[0], 'frameHeight', 0);
          if (firstBw <= 0) firstBw = floatAttr(subs[0], 'width', 0);
          if (firstBh <= 0) firstBh = floatAttr(subs[0], 'height', 0);
          if (firstBw > 0) fw0 = firstBw;
          if (firstBh > 0) fh0 = firstBh;
          var idleDims:Dynamic = idleFrameDims(subs);
          var bw:Float = 0;
          var bh:Float = 0;
          // Characters without an 'idle' frame - use the first animation's
          // frame prefix (usually the dance/idle pose).
          if (idleDims == null && animations.length > 0)
          {
            var firstPref:String = util.getString(get(animations[0], 'prefix'), '');
            if (firstPref != '') idleDims = prefixFrameDims(subs, firstPref);
          }
          if (idleDims != null)
          {
            bw = util.getFloat(get(idleDims, 'w'), 0);
            bh = util.getFloat(get(idleDims, 'h'), 0);
          }
          else
          {
            bw = floatAttr(subs[0], 'frameWidth', 0);
            bh = floatAttr(subs[0], 'frameHeight', 0);
          }
          if (bw <= 0) bw = floatAttr(subs[0], 'width', 0);
          if (bh <= 0) bh = floatAttr(subs[0], 'height', 0);
          if (bw > 0) fw = bw;
          if (bh > 0) fh = bh;
        }
      }
      }
      set(charMetrics, charId, {
        w: fw,
        h: fh,
        w0: fw0,
        h0: fh0,
        s: floatAttr(root, 'scale', 1),
        // Root globalOffset (ox/oy) and XML isPlayer flag (op), needed to
        // bake Codename's offset-based placement into V-Slice stage anchors.
        ox: floatAttr(root, 'x', 0),
        oy: floatAttr(root, 'y', 0),
        op: boolAttr(root, 'isPlayer', false),
        // Character-level camera offset (camx/camy). Stage scripts may
        // REPLACE it (e.g. 'boyfriend.cameraOffset = FlxPoint.get(...)'), so
        // the stage converter needs to know the original value to diff.
        cx: parseIntAttr(root, 'camx', 0),
        cy: parseIntAttr(root, 'camy', 0)
      });

      if (isAnimateAtlas)
      {
        var animJson:String = util.readText('mods/$dir/images/characters/$spriteName/Animation.json');
        if (animJson != null) out.texts.push({paths: util.imageKeys('characters/$artBase/Animation.json'), content: animJson});
        var sm1Json:String = util.readText('mods/$dir/images/characters/$spriteName/spritemap1.json');
        if (sm1Json != null) out.texts.push({paths: util.imageKeys('characters/$artBase/spritemap1.json'), content: sm1Json});
        addImage(out, dir, 'characters/$spriteName/spritemap1.png', 'characters/$artBase/spritemap1.png');
        var charImageFiles:Array<String> = util.listDir('mods/$dir/images/characters/$spriteName');
        for (cf in charImageFiles)
        {
          var cfl:String = cf.toLowerCase();
          if (cfl == 'animation.json' || cfl == 'spritemap1.json' || cfl == 'spritemap1.png') continue;
          if (StringTools.startsWith(cfl, 'spritemap') && (StringTools.endsWith(cfl, '.json') || StringTools.endsWith(cfl, '.png')))
          {
            if (StringTools.endsWith(cfl, '.png')) addImage(out, dir, 'characters/$spriteName/$cf', 'characters/$artBase/$cf');
            else
            {
              var jt:String = util.readText('mods/$dir/images/characters/$spriteName/$cf');
              if (jt != null) out.texts.push({paths: util.imageKeys('characters/$artBase/$cf'), content: jt});
            }
          }
        }
      }
      else if (isMultiSparrow)
      {
        for (msi in 0...multiSheets.length)
        {
          var sheetN:String = multiSheets[msi];
          addImage(out, dir, 'characters/$spriteName/$sheetN.png', 'characters/$artBase/$sheetN.png');
        }
      }
      else
      {
        addImage(out, dir, 'characters/$spriteName.png', 'characters/$artBase.png');
      }

      // Alias the health icon under V-Slice's expected key. The icon LOOKUP
      // name stays the mod's own (raw) value even when the character id was
      // namespaced - only the registered key follows the renamed id.
      var iconLookup:String = attr(root, 'icon');
      if (iconLookup == null || iconLookup == '') iconLookup = rawCharId;
      addIconAlias(out, dir, iconLookup, charId);
    }
  }

  // A character id that the game also ships as built-in data
  // (assets/data/characters/<id>.json, e.g. 'gf-car') would have the vanilla
  // file win its asset-cache slot, so the mod's character would render as the
  // built-in instead. Import such characters under a suffixed id and rewrite
  // every reference (song metadata, stage hints) to match. Same for ids an
  // EARLIER imported mod already claimed - the shared asset cache holds one
  // entry per path, so a second mod's identically-named character would
  // overwrite the first mod's art everywhere.
  public function resolveCharId(dir:String, charId:String):String
  {
    if (charId == null || charId == '') return charId;
    var finalized:String = charId;
    if (util.fileExists('mods/$dir/data/characters/$charId.xml') && util.fileExists('assets/data/characters/$charId.json'))
    {
      util.warn('Codename: character "$charId" collides with a built-in V-Slice character - importing the mod version as "$charId-fc"');
      finalized = charId + '-fc';
    }
    if (util.isForeignTaken('chars', finalized))
    {
      var renamed:String = finalized + '-' + util.modSlug(dir);
      util.warn('Codename: character "$finalized" is also defined by another imported mod - importing this mod version as "$renamed"');
      return renamed;
    }
    return finalized;
  }

  // True when any sub-texture name in the given sparrow xml starts with the
  // frame prefix (used to route multi-spritesheet animations to their sheet).
  public function xmlHasPrefix(xmlText:String, prefix:String):Bool
  {
    if (xmlText == null || prefix == null || prefix == '') return false;
    var lowerToken:String = prefix.toLowerCase();
    var subs:Array<String> = extractTags(xmlText, 'SubTexture');
    for (sb in subs)
    {
      var nm:String = attr(sb, 'name');
      if (nm != null && nm.toLowerCase().indexOf(lowerToken) == 0) return true;
    }
    return false;
  }

  // Find a sub-texture whose name starts with a prefix (the first
  // animation's frame prefix) and return its frame dims.
  public function prefixFrameDims(subs:Array<String>, prefix:String):Null<Dynamic>
  {
    if (prefix == null || prefix == '') return null;
    var lowerPrefix:String = prefix.toLowerCase();
    for (sb in subs)
    {
      var nm:String = attr(sb, 'name');
      if (nm == null || nm.toLowerCase().indexOf(lowerPrefix) != 0) continue;
      var bw:Float = floatAttr(sb, 'frameWidth', 0);
      var bh:Float = floatAttr(sb, 'frameHeight', 0);
      if (bw <= 0) bw = floatAttr(sb, 'width', 0);
      if (bh <= 0) bh = floatAttr(sb, 'height', 0);
      if (bw > 0 && bh > 0) return {w: bw, h: bh};
    }
    return null;
  }

  // Prefer the IDLE sub-texture's frame size for stage anchor conversion
  // (the character rests on the idle animation). Returns null if no idle
  // sub-texture exists.
  public function idleFrameDims(subs:Array<String>):Null<Dynamic>
  {
    for (sb in subs)
    {
      var nm:String = attr(sb, 'name');
      if (nm != null && nm.toLowerCase().indexOf('idle') >= 0)
      {
        var bw:Float = floatAttr(sb, 'frameWidth', 0);
        var bh:Float = floatAttr(sb, 'frameHeight', 0);
        if (bw <= 0) bw = floatAttr(sb, 'width', 0);
        if (bh <= 0) bh = floatAttr(sb, 'height', 0);
        if (bw > 0 && bh > 0) return {w: bw, h: bh};
      }
    }
    return null;
  }

  // ------------------------------------------------------------------
  // Song choreography extraction (generic, script-driven)
  // ------------------------------------------------------------------

  // Extract the portable subset of a Codename song's HScript choreography
  // (song scripts/events.hx plus the companion stage script) into data the
  // FunkyCompatChoreo song event can replay: created sprites/characters,
  // beat-triggered visibility/tweens/flips, event-driven playAnim calls and
  // function bodies invoked by 'HScript Call' events. Only these constrained
  // script-lit patterns are recognized - arbitrary code is never executed.
  public function extractCodenameChoreo(dir:String, songFolder:String, stageId:String, stageBaseId:String):Dynamic
  {
    var program:Dynamic = {sprites: [], characters: [], beats: [], camAnims: [], calls: {}, order: []};
    var text:String = '';
    // Stage script first: its create()-time actors (like the "guy in the
    // wall") are pushed before the song script's loop-created actors, and
    // runtime array indexing relies on that same creation order.
    var stageText:String = stageScriptText(dir, stageId);
    if ((stageText == null || stageText == '') && stageBaseId != null && stageBaseId != '' && stageBaseId != stageId) stageText = stageScriptText(dir, stageBaseId);
    if (stageText != null) text += stageText + '\n';
    var songScripts:Array<String> = util.listDir('mods/$dir/songs/$songFolder/scripts');
    for (sFile in songScripts)
    {
      if (!StringTools.endsWith(sFile.toLowerCase(), '.hx')) continue;
      var t:String = util.readText('mods/$dir/songs/$songFolder/scripts/$sFile');
      if (t != null) text += t + '\n';
    }
    if (text == '') return program;

    extractChoreoProgram(text, program);
    trace('[FUNKY-COMPAT] choreo($songFolder) -> sprites=' + get(program, 'sprites').length + ' chars=' + get(program, 'characters').length + ' beats=' + get(program, 'beats').length + ' cam=' + get(program, 'camAnims').length + ' order=' + get(program, 'order').length);
    return program;
  }

  // Line-scan a combined HScript body for the portable choreography patterns.
  function extractChoreoProgram(text:String, program:Dynamic):Void
  {
    var lines:Array<String> = text.split('\n');

    // Constant array-of-arrays tables (e.g. 'var offsets = [[..],[..]]')
    // used by loop-driven choreography (dupe/sign placement). Tables may
    // span several lines, so join from 'var NAME = [' until brackets close.
    var tables:Dynamic = {};
    var tableAcc:Dynamic = null;
    var tableAccName:String = '';
    var tableDepth:Int = 0;
    for (raw in lines)
    {
      var line:String = StringTools.trim(raw);
      if (tableAcc != null)
      {
        tableAcc += line + ' ';
        tableDepth += countChar(line, '[') - countChar(line, ']');
        if (tableDepth <= 0)
        {
          var parsed:Array<Dynamic> = parseConstTable(tableAcc);
          if (parsed != null && parsed.length > 0) set(tables, tableAccName, parsed);
          tableAcc = null;
          tableAccName = '';
        }
        continue;
      }
      if (StringTools.startsWith(line, 'var '))
      {
        var eq:Int = line.indexOf('=');
        if (eq > 4)
        {
          var varName:String = StringTools.trim(line.substring(4, eq));
          // Type-annotated declarations ('var dupes:Array<Character> = []') or
          // other non-identifier names are not loop tables.
          if (!isPlainIdent(varName)) continue;
          var inner:String = StringTools.trim(line.substring(eq + 1));
          if (inner == '[')
          {
            tableAcc = inner;
            tableAccName = varName;
            tableDepth = 1;
            continue;
          }
          if (StringTools.endsWith(inner, ';')) inner = StringTools.trim(inner.substring(0, inner.length - 1));
          if (inner.length >= 2 && inner.charAt(0) == '[' && inner.charAt(inner.length - 1) == ']')
          {
            var parsedOne:Array<Dynamic> = parseConstTable(inner);
            if (parsedOne != null && parsedOne.length > 0) set(tables, varName, parsedOne);
          }
        }
      }
    }

    // Loop tables also travel with the program: per-entry tween values and
    // delays ('dad.y + offsets[a][3]') resolve against them at play time.
    if (ReflectUtil.fields(tables).length > 0) set(program, 'tables', tables);

    var activeFn:String = '';
    var fnDepth:Int = 0;
    var inBeatHit:Bool = false;
    var beatCase:Int = -1;
    var loopVar:String = '';
    var loopList:String = '';
    var loopCount:Int = -1;
    // Branch condition for table-loop creations ('if (!o[6])' / 'else'):
    // creations inside only apply to entries matching the test.
    var condIdx:Int = -1;
    var condWant:Bool = true;
    var condActive:Bool = false;
    var condDepth:Int = 0;
    var condTbl:String = '';

    for (raw in lines)
    {
      var line:String = StringTools.trim(raw);
      if (line == '') continue;
      if (line.indexOf('function ') == 0)
      {
        var open:Int = line.indexOf('(');
        var name:String = open > 9 ? StringTools.trim(line.substring(9, open)) : '';
        activeFn = name;
        inBeatHit = (name == 'beatHit');
        beatCase = -1;
        fnDepth = countChar(line, '{') - countChar(line, '}');
        if (fnDepth <= 0) fnDepth = 1;
        loopVar = '';
        loopList = '';
        loopCount = -1;
        condActive = false;
        condIdx = -1;
        condTbl = '';
        continue;
      }
      if (activeFn == '') continue;

      // Branch-condition tracking for table-loop creations.
      if (condActive && fnDepth < condDepth) condActive = false;
      if (StringTools.startsWith(line, 'if (') || StringTools.startsWith(line, '} else if ('))
      {
        var test:Dynamic = parseTableBranchTest(line);
        if (test != null)
        {
          condIdx = Std.int(util.getInt(get(test, 'col'), -1));
          condTbl = Std.string(get(test, 'tbl'));
          condWant = get(test, 'want') == true;
          condActive = true;
          condDepth = fnDepth + countChar(line, '{') - countChar(line, '}');
          if (condDepth < fnDepth + 1) condDepth = fnDepth + 1;
        }
      }
      else if (condActive && line.indexOf('} else {') >= 0)
      {
        condWant = !condWant;
      }

      if (inBeatHit)
      {
        var caseIdx:Int = line.indexOf('case ');
        if (caseIdx >= 0)
        {
          var caseText:String = StringTools.trim(line.substring(caseIdx + 5));
          var colonIdx:Int = caseText.indexOf(':');
          var caseNumText:String = colonIdx > 0 ? StringTools.trim(caseText.substring(0, colonIdx)) : '';
          if (isIntText(caseNumText)) beatCase = Std.parseInt(caseNumText);
        }
      }

      if (line.indexOf('for (') == 0)
      {
        var lp:Int = line.indexOf('(');
        var la:Int = line.indexOf('in', lp);
        if (lp >= 0 && la > lp)
        {
          loopVar = StringTools.trim(line.substring(lp + 1, la));
          loopList = '';
          loopCount = -1;
          var lRest:String = StringTools.trim(line.substring(la + 2));
          if (lRest.indexOf('...') < 0)
          {
            // The header's closing paren is its LAST ')' (a list may contain
            // calls like stage.getSprite('door1')).
            var semi:Int = lRest.lastIndexOf(')');
            if (semi >= 0) lRest = StringTools.trim(lRest.substring(0, semi));
            if (get(tables, lRest) != null)
            {
              loopList = lRest;
              loopCount = get(tables, lRest).length;
            }
            else if (StringTools.startsWith(lRest, '[') && StringTools.endsWith(lRest, ']'))
            {
              // 'for (a in [door1, door2])' or '[...getSprite('door1')...]'
              // - literal actor list.
              var listName:String = '__list_' + loopVar + '_';
              var listItems:Array<Dynamic> = [];
              for (li in splitTopLevel(lRest.substring(1, lRest.length - 1)))
              {
                var item:String = StringTools.trim(li);
                if (item == '') continue;
                // 'stage.getSprite('door1')' -> 'door1'
                var gs:Int = item.indexOf("getSprite('");
                if (gs >= 0)
                {
                  var gq:Int = item.indexOf("'", gs + 10);
                  var gq2:Int = gq < 0 ? -1 : item.indexOf("'", gq + 1);
                  if (gq2 > gq) item = item.substring(gq + 1, gq2);
                }
                if (item != '') listItems.push(item);
              }
              if (listItems.length > 0)
              {
                set(tables, listName, listItems);
                loopList = listName;
                loopCount = listItems.length;
              }
            }
          }
          else
          {
            var dots:Int = lRest.indexOf('...');
            var nText:String = StringTools.trim(lRest.substring(dots + 3));
            nText = StringTools.trim(nText.split(')')[0]);
            if (isIntText(nText)) loopCount = Std.parseInt(nText);
          }
        }
      }

      extractChoreoLine(program, tables, line, activeFn, beatCase, loopVar, loopList, loopCount, condActive, condIdx, condWant, condTbl);
      fnDepth += countChar(line, '{') - countChar(line, '}');
      if (fnDepth <= 0) activeFn = '';
    }
  }

  // Identifier character helpers for name scanning.
  function isIdentChar(c:String):Bool
  {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
  }

  // The identifier immediately before a position (e.g. 'dupes' in
  // 'dupes.push(').
  function lastIdentifier(s:String):String
  {
    var t:String = StringTools.trim(s);
    var i:Int = t.length - 1;
    while (i >= 0 && isIdentChar(t.charAt(i))) i--;
    return t.substring(i + 1);
  }

  // The last identifier-ish token of an expression, ignoring punctuation and
  // digit-only tokens ('dupes[dupes.push(dupe) - 1]' -> 'dupe').
  function lastIdentName(s:String):String
  {
    var t:String = StringTools.trim(s);
    var i:Int = t.length - 1;
    while (i >= 0 && !(isIdentChar(t.charAt(i)) && !isDigitChar(t.charAt(i)))) i--;
    if (i < 0) return '';
    var end:Int = i + 1;
    while (i >= 0 && isIdentChar(t.charAt(i))) i--;
    var name:String = t.substring(i + 1, end);
    if (name == '') return '';
    var allDigits:Bool = true;
    for (c in 0...name.length)
    {
      var ch:String = name.charAt(c);
      if (ch < '0' || ch > '9') allDigits = false;
    }
    return allDigits ? '' : name;
  }

  function isDigitChar(c:String):Bool
  {
    return c >= '0' && c <= '9';
  }

  // A plain identifier (no type annotations, no punctuation).
  function isPlainIdent(s:String):Bool
  {
    if (s == '') return false;
    for (i in 0...s.length)
    {
      var c:String = s.charAt(i);
      if (i == 0)
      {
        if (!(c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) return false;
      }
      else if (!isIdentChar(c)) return false;
    }
    return true;
  }

  // The loop-table name before a cell access 'TBL[..][K]': skips any
  // bracket segments between the identifier and the cell
  // ('offsets[a][6]' -> 'offsets', 'o[6]' -> 'o').
  function tableNameBefore(s:String, cellBracket:Int):String
  {
    var nameEnd:Int = cellBracket - 1;
    var skipping:Bool = true;
    while (skipping && nameEnd >= 0)
    {
      if (s.charAt(nameEnd) == ']')
      {
        var openB:Int = s.lastIndexOf('[', nameEnd);
        if (openB < 0) break;
        nameEnd = openB - 1;
      }
      else skipping = false;
    }
    var nameStart:Int = nameEnd;
    while (nameStart >= 0 && isIdentChar(s.charAt(nameStart))) nameStart--;
    return s.substring(nameStart + 1, nameEnd + 1);
  }

  // Parse the table/column test of a branch condition: '!o[6]',
  // '!offsets[a][6]' or 'offsets[a][5] == 0'. Only the 'if (...)' condition
  // is scanned, so table refs inside the statement body (tween startDelay
  // cells, etc.) never shadow the test. Returns {tbl, col, want} or null.
  function parseTableBranchTest(line:String):Dynamic
  {
    var ifOpen:Int = line.indexOf('if (');
    if (ifOpen < 0) return null;
    var condEnd:Int = matchCloseParen(line, ifOpen + 3);
    if (condEnd < 0) return null;
    var cond:String = line.substring(ifOpen + 3, condEnd);
    var bestCol:Int = -1;
    var bestTbl:String = '';
    var bestBracket:Int = -1;
    var i:Int = 0;
    while (i < cond.length)
    {
      var oi:Int = cond.indexOf('[', i);
      if (oi < 0) break;
      var oc:Int = cond.indexOf(']', oi);
      if (oc < 0) break;
      var k:Int = Std.parseInt(cond.substring(oi + 1, oc));
      if (k != null && !Math.isNaN(k))
      {
        var tbl:String = tableNameBefore(cond, oi);
        if (tbl != '')
        {
          bestCol = k;
          bestTbl = tbl;
          bestBracket = oi;
        }
      }
      i = oc + 1;
    }
    if (bestCol < 0 || bestTbl == '') return null;
    var want:Bool = true;
    // '!TBL[...][K]' negates the desired value.
    var neg:Int = cond.indexOf('!');
    if (neg >= 0 && neg < bestBracket) want = false;
    // 'TBL[...][K] == 0' / '== false' also select the falsy rows.
    var eqPos:Int = bestBracket > 0 ? cond.indexOf('==', bestBracket) : -1;
    if (eqPos > bestBracket)
    {
      var rhs:String = StringTools.trim(cond.substring(eqPos + 2));
      if (rhs == '0' || rhs == 'false') want = false;
    }
    return {tbl: bestTbl, col: bestCol, want: want};
  }

  function extractChoreoLine(program:Dynamic, tables:Dynamic, line:String, fn:String, beatCase:Int, loopVar:String, loopList:String, loopCount:Int, condActive:Bool, condIdx:Int, condWant:Bool, condTbl:String):Void
  {
    // ---- creation: sprites (FlxSprite/FunkinSprite) and characters ----
    var kind:String = '';
    var newIdx:Int = -1;
    if (line.indexOf('new FunkinSprite(') >= 0) { newIdx = line.indexOf('new FunkinSprite('); kind = 'sprite'; }
    else if (line.indexOf('new FlxSprite(') >= 0) { newIdx = line.indexOf('new FlxSprite('); kind = 'sprite'; }
    else if (line.indexOf('new Character(') >= 0) { newIdx = line.indexOf('new Character('); kind = 'char'; }
    if (newIdx >= 0)
    {
      var eq4:Int = line.indexOf('=');
      if (eq4 >= 0 && eq4 < newIdx)
      {
        var vName:String = StringTools.trim(line.substring(0, eq4));
        var vColon:Int = vName.indexOf(':');
        if (vColon > 0) vName = StringTools.trim(vName.substring(0, vColon));
        var vVar:Int = vName.indexOf('var ');
        if (vVar >= 0) vName = StringTools.trim(vName.substring(vVar + 4));
        var open4:Int = line.indexOf('(', newIdx);
        var close4:Int = matchCloseParen(line, open4);
        if (vName != '' && vName != 'if' && open4 >= 0 && close4 > open4)
        {
          // Nested creations ('insert(..., rompstar = new FunkinSprite(...)')
          // leave the name embedded in an expression - keep the last token.
          if (vName.indexOf('(') >= 0 || vName.indexOf(')') >= 0 || vName.indexOf(',') >= 0)
          {
            var lastComma:Int = vName.lastIndexOf(',');
            var lastSpace:Int = vName.lastIndexOf(' ');
            var cut:Int = lastComma > lastSpace ? lastComma : lastSpace;
            if (cut >= 0) vName = StringTools.trim(vName.substring(cut + 1));
          }
          var argsText:String = line.substring(open4 + 1, close4);
          var comma1:Int = argsText.indexOf(',');
          var comma2:Int = comma1 < 0 ? -1 : argsText.indexOf(',', comma1 + 1);
          var xText:String = comma1 >= 0 ? StringTools.trim(argsText.substring(0, comma1)) : '0';
          var yText:String = comma2 >= 0 ? StringTools.trim(argsText.substring(comma1 + 1, comma2)) : '0';
          var charId:String = '';
          var imgArg:String = '';
          if (kind == 'char') charId = comma2 >= 0 ? stripQuotes(StringTools.trim(argsText.substring(comma2 + 1))) : '';
          else imgArg = StringTools.trim(argsText);
          emitCreated(program, tables, kind, vName, xText, yText, charId, imgArg, loopVar, loopList, loopCount, condActive, condIdx, condWant);
          // Some creations set scale inline at the end of the statement:
          // 'insert(..., sign = new FunkinSprite(...)).scale.set(0.85, 0.85)'.
          var ssi:Int = line.indexOf('.scale.set(', close4);
          if (ssi > 0)
          {
            var sso2:Int = line.indexOf('(', ssi);
            var ssc2:Int = line.indexOf(')', sso2);
            if (sso2 >= 0 && ssc2 > sso2)
            {
              var sp2:Array<String> = splitTopLevel(line.substring(sso2 + 1, ssc2));
              if (sp2.length >= 1) applyChoreoAttr(program, tables, vName, 'scaleX', StringTools.trim(sp2[0]), loopVar, loopList, loopCount);
              if (sp2.length >= 2) applyChoreoAttr(program, tables, vName, 'scaleY', StringTools.trim(sp2[1]), loopVar, loopList, loopCount);
            }
          }
        }
      }
    }

    // ---- per-created attributes ----
    var eq5:Int = line.indexOf('=');
    var dot5:Int = line.indexOf('.');
    if (dot5 > 0 && eq5 > dot5)
    {
      var attrTarget:String = StringTools.trim(line.substring(0, dot5));
      var attrName:String = StringTools.trim(line.substring(dot5 + 1, eq5));
      var attrValue:String = StringTools.trim(line.substring(eq5 + 1));
      if (StringTools.endsWith(attrValue, ';')) attrValue = StringTools.trim(attrValue.substring(0, attrValue.length - 1));
      if (attrName == 'visible' || attrName == 'flipX' || attrName == 'antialiasing' || attrName == 'alpha' || attrName == 'x' || attrName == 'y')
        applyChoreoAttr(program, tables, attrTarget, attrName, attrValue, loopVar, loopList, loopCount);
      else if (StringTools.startsWith(attrName, 'scale'))
        applyChoreoAttr(program, tables, attrTarget, 'scaleX', attrValue, loopVar, loopList, loopCount);
    }
    // scale.set(a, b)
    var ssIdx:Int = line.indexOf('.scale.set(');
    if (ssIdx > 0)
    {
      var sso:Int = line.indexOf('(', ssIdx);
      var ssc:Int = line.indexOf(')', sso);
      if (sso >= 0 && ssc > sso)
      {
        var sParts:Array<String> = splitTopLevel(line.substring(sso + 1, ssc));
        if (sParts.length >= 1) applyChoreoAttr(program, tables, StringTools.trim(line.substring(0, ssIdx)), 'scaleX', StringTools.trim(sParts[0]), loopVar, loopList, loopCount);
        if (sParts.length >= 2) applyChoreoAttr(program, tables, StringTools.trim(line.substring(0, ssIdx)), 'scaleY', StringTools.trim(sParts[1]), loopVar, loopList, loopCount);
      }
    }
    // frames = Paths.getSparrowAtlas('...')
    var atIdx:Int = line.indexOf('.frames = Paths.getSparrowAtlas(');
    if (atIdx > 0)
    {
      var atlasName:String = extractPathCall(line, 'getSparrowAtlas(');
      if (atlasName != '') applyChoreoAttr(program, tables, StringTools.trim(line.substring(0, atIdx)), 'atlas', atlasName, loopVar, loopList, loopCount);
    }
    // addAnim('name', 'prefix', fps, loop...)
    var animIdx:Int = line.indexOf('.addAnim(');
    if (animIdx > 0)
    {
      var animTarget:String = StringTools.trim(line.substring(0, animIdx));
      var ao:Int = line.indexOf('(', animIdx);
      if (ao >= 0)
      {
        var aParts:Array<String> = splitTopLevel(line.substring(ao + 1, line.lastIndexOf(')')));
        if (aParts.length >= 2)
        {
          var animName:String = stripQuotes(StringTools.trim(aParts[0]));
          var animPrefix:String = stripQuotes(StringTools.trim(aParts[1]));
          var animFps:Float = aParts.length > 2 ? Std.parseFloat(StringTools.trim(aParts[2])) : 24;
          if (Math.isNaN(animFps) || animFps <= 0) animFps = 24;
          applyChoreoAnim(program, tables, animTarget, animName, animPrefix, animFps, loopVar, loopList, loopCount);
        }
      }
    }

    // ---- insertion order: insert(members.indexOf(stage.getSprite('P')) + N, NAME) ----
    var insIdx:Int = line.indexOf('stage.getSprite(');
    if (insIdx >= 0)
    {
      var s2:Int = line.indexOf("'", insIdx);
      var e2:Int = s2 < 0 ? -1 : line.indexOf("'", s2 + 1);
      if (e2 > s2)
      {
        var beforeProp:String = line.substring(s2 + 1, e2);
        var zParsed:Int = 2;
        var plusIdx:Int = line.indexOf('+', e2);
        if (plusIdx >= 0)
        {
          var zText2:String = '';
          var cIdx:Int = plusIdx + 1;
          while (cIdx < line.length && line.charCodeAt(cIdx) == 32) cIdx++;
          while (cIdx < line.length && line.charCodeAt(cIdx) >= 48 && line.charCodeAt(cIdx) <= 57) { zText2 += line.charAt(cIdx); cIdx++; }
          if (zText2 != '') zParsed = Std.parseInt(zText2);
        }
        // The inserted actor is either the trailing name of the insert call
        // ('insert(..., name)') or, for nested creations
        // ('insert(..., dupe = new Character(...))'), the identifier right
        // before the '='.
        var candidates:Array<String> = [];
        var rev:Int = line.lastIndexOf(',');
        if (rev >= 0)
        {
          var tail:String = StringTools.trim(line.substring(rev + 1));
          tail = StringTools.trim(tail.split(')')[0]);
          var colonI:Int = tail.indexOf(':');
          if (colonI > 0) tail = StringTools.trim(tail.substring(colonI + 1));
          if (tail != '') candidates.push(tail);
        }
        var eqI2:Int = line.indexOf('=');
        if (eqI2 > 0)
        {
          var commaBefore:Int = line.lastIndexOf(',', eqI2);
          if (commaBefore >= 0)
          {
            var preEq:String = StringTools.trim(line.substring(commaBefore + 1, eqI2));
            if (preEq != '' && candidates.indexOf(preEq) == -1) candidates.push(preEq);
          }
        }
        for (cand in candidates)
        {
          var hit:Dynamic = null;
          findChoreoRefs(program, tables, cand, loopVar, loopList, loopCount, function(r:Dynamic):Void
          {
            set(r, 'before', beforeProp);
            set(r, 'z', zParsed);
            hit = r;
          });
          if (hit != null) break;
        }
      }
    }

    // ---- array membership ----
    // 'arr.push(actor)' (also 'arr[arr.push(actor) - 1]' nested inside another
    // push): record which runtime arrays hold loop-created actors, so the
    // runtime can expand 'arr[a]' loop-var targets onto the right group.
    var ps:Int = 0;
    while (line.indexOf('.push(', ps) >= 0)
    {
      var pIdx:Int = line.indexOf('.push(', ps);
      // The '(' sits right after the 5-char '.push' marker; a nested push call
      // can sit between the parens ('characters.push(dupes[dupes.push(dupe) - 1])').
      var pc:Int = matchCloseParen(line, pIdx + 5);
      if (pc < 0) break;
      var argText:String = StringTools.trim(line.substring(pIdx + 6, pc));
      var recv:String = lastIdentifier(line.substring(0, pIdx));
      var pushed:String = lastIdentName(argText);
      if (recv != '' && pushed != '' && recv != 'null' && pushed != 'null')
      {
        var pushedRefs:Array<Dynamic> = choreoRefsNamed(program, pushed, loopVar, loopList, loopCount);
        for (pr in pushedRefs)
        {
          if (pr == null) continue;
          var groups:Array<Dynamic> = get(pr, 'groups');
          if (groups == null)
          {
            groups = [];
            set(pr, 'groups', groups);
          }
          if (groups.indexOf(recv) < 0) groups.push(recv);
        }
      }
      // Continue INSIDE the call too, so a nested push
      // ('arr[arr.push(x) - 1]') is visited as well.
      ps = pIdx + 6;
    }

    // ---- beat ops ----
    if (beatCase >= 0)
    {
      var vDot:Int = line.indexOf('.visible');
      if (vDot > 0 && line.indexOf('=') > vDot)
      {
        var eqV:Int = line.indexOf('=', vDot);
        var valV:String = StringTools.trim(line.substring(eqV + 1));
        valV = StringTools.trim(valV.split(';')[0]);
        if (valV == 'true' || valV == 'false')
          addBeatOp(program, beatCase, resolveLoopTarget(line.substring(0, vDot), loopVar, loopList, loopCount), 'visible', valV == 'true');
      }
      var fDot:Int = line.indexOf('.flipX');
      if (fDot > 0 && line.indexOf('=') > fDot)
      {
        var eqF:Int = line.indexOf('=', fDot);
        var valF:String = StringTools.trim(line.substring(eqF + 1));
        valF = StringTools.trim(valF.split(';')[0]);
        if (valF == 'true' || valF == 'false')
          addBeatOp(program, beatCase, resolveLoopTarget(line.substring(0, fDot), loopVar, loopList, loopCount), 'flipX', valF == 'true');
      }
      if (line.indexOf('.swapLeftRightAnimations()') >= 0)
        addBeatOp(program, beatCase, resolveLoopTarget(line.substring(0, line.indexOf('.swap')), loopVar, loopList, loopCount), 'swapLR', true);
      // (the finishCallback line's inner playAnim is captured separately as
      // a 'nextAnim' op - skip it here so it isn't double-captured).
      var paIdx:Int = line.indexOf('.playAnim(');
      if (paIdx > 0 && line.indexOf('.animation.finishCallback') < 0)
      {
        var pao:Int = line.indexOf('(', paIdx);
        var pac:Int = line.indexOf(')', pao);
        if (pao >= 0 && pac > pao)
        {
          var paAnim:String = StringTools.trim(line.substring(pao + 1, pac));
          if (paAnim.length >= 2 && paAnim.charAt(0) == "'" && paAnim.charAt(paAnim.length - 1) == "'")
            addBeatOp(program, beatCase, resolveLoopTarget(line.substring(0, paIdx), loopVar, loopList, loopCount), 'playAnim', stripQuotes(paAnim));
        }
      }
      if (line.indexOf('FlxTween.tween(') >= 0) extractChoreoTween(program, tables, line, beatCase, loopVar, loopList, loopCount, condActive, condIdx, condWant, condTbl);
    }

    // ---- sequential animation on completion ----
    // 'target.animation.finishCallback = () -> target.playAnim('next')'
    // (Codename plays a follow-up animation when the current, non-looping
    // one ends - e.g. madstage's inv -> shake). Emitted as a 'nextAnim' op
    // so the runtime attaches the completion hook after the paired playAnim.
    var fcIdx:Int = line.indexOf('.animation.finishCallback');
    if (fcIdx > 0)
    {
      var fcTarget:String = StringTools.trim(line.substring(0, fcIdx));
      var fcPlay:Int = fcIdx > 0 ? line.indexOf('.playAnim(', fcIdx) : -1;
      if (fcPlay > 0)
      {
        var fcOpen:Int = line.indexOf('(', fcPlay);
        var fcClose:Int = fcOpen < 0 ? -1 : line.indexOf(')', fcOpen);
        if (fcClose > fcOpen)
        {
          var fcAnimRaw:String = StringTools.trim(line.substring(fcOpen + 1, fcClose));
          if (fcAnimRaw.length >= 2 && fcAnimRaw.charAt(0) == "'" && fcAnimRaw.charAt(fcAnimRaw.length - 1) == "'")
          {
            var fcAnim:String = stripQuotes(fcAnimRaw);
            var fcResolved:String = resolveLoopTarget(fcTarget, loopVar, loopList, loopCount);
            if (beatCase >= 0) addBeatOp(program, beatCase, fcResolved, 'nextAnim', fcAnim);
            else if (fn != '' && fn != 'create' && fn != 'postCreate' && fn != 'beatHit' && fn != 'onEvent' && fn != 'update') addCallOp(program, fn, fcResolved, 'nextAnim', fcAnim);
          }
        }
      }
    }

    // ---- camera event-driven playAnim (stage onEvent) ----
    if (fn == 'onEvent' && line.indexOf('.playAnim(') > 0)
    {
      var tIdx:Int = line.indexOf('.playAnim(');
      var tOpen:Int = line.indexOf('(', tIdx);
      var tClose:Int = line.indexOf(')', tOpen);
      if (tClose > tOpen)
      {
        var args3:String = line.substring(tOpen + 1, tClose);
        var qIdx:Int = args3.indexOf('?');
        var colonT:Int = args3.indexOf(':', qIdx);
        if (qIdx >= 0 && colonT > qIdx)
        {
          // Ternary 'COND ? TRUE : FALSE' - the TRUE branch is BETWEEN the
          // '?' and ':', the FALSE branch after the ':'.
          var animTrue:String = stripQuotes(StringTools.trim(args3.substring(qIdx + 1, colonT)));
          var animFalse:String = stripQuotes(StringTools.trim(args3.substring(colonT + 1)));
          var evTarget:String = StringTools.trim(line.substring(0, tIdx));
          // The common guard is 'e.event.params[0] != 0': camera line 0
          // (opponent) takes the FALSE branch, every other line the TRUE one.
          if (animFalse != '') get(program, 'camAnims').push({param: 0, target: evTarget, anim: animFalse});
          if (animTrue != '') get(program, 'camAnims').push({param: -1, target: evTarget, anim: animTrue});
        }
      }
    }

    // ---- call bodies (HScript Call playback) ----
    if (fn != '' && fn != 'create' && fn != 'postCreate' && fn != 'beatHit' && fn != 'onEvent' && fn != 'update')
    {
      var cDot:Int = line.indexOf('.visible');
      if (cDot > 0 && line.indexOf('=') > cDot)
      {
        var eqC:Int = line.indexOf('=', cDot);
        var valC:String = StringTools.trim(line.substring(eqC + 1));
        valC = StringTools.trim(valC.split(';')[0]);
        if (valC == 'true' || valC == 'false')
          addCallOp(program, fn, StringTools.trim(line.substring(0, cDot)), 'visible', valC == 'true');
      }
      var gIdx:Int = line.indexOf('.playAnim(');
      if (gIdx > 0 && line.indexOf('.animation.finishCallback') < 0)
      {
        var go:Int = line.indexOf('(', gIdx);
        var gc:Int = line.indexOf(')', go);
        if (go >= 0 && gc > go)
        {
          var animG:String = StringTools.trim(line.substring(go + 1, gc));
          if (animG.length >= 2 && animG.charAt(0) == "'" && animG.charAt(animG.length - 1) == "'")
            addCallOp(program, fn, StringTools.trim(line.substring(0, gIdx)), 'playAnim', stripQuotes(animG));
        }
      }
    }
  }

  // The paren matching an opening paren (depth scan), or -1.
  function matchCloseParen(s:String, open:Int):Int
  {
    if (open < 0) return -1;
    var depth:Int = 0;
    for (i in open...s.length)
    {
      var c:String = s.charAt(i);
      if (c == '(') depth++;
      else if (c == ')')
      {
        depth--;
        if (depth == 0) return i;
      }
    }
    return -1;
  }

  // Create one program instance per loop iteration (or one when no loop).
  function emitCreated(program:Dynamic, tables:Dynamic, kind:String, vName:String, xText:String, yText:String, charId:String, imgArg:String, loopVar:String, loopList:String, loopCount:Int, condActive:Bool, condIdx:Int, condWant:Bool):Void
  {
    var count:Int = loopCount > 0 ? loopCount : 1;
    var emitted:Int = 0;
    for (i in 0...count)
    {
      var entry:Dynamic = loopList != '' && loopList != 'null' ? get(tables, loopList)[i] : null;
      // Only entries matching the enclosing 'if (!o[K])' / 'else' branch.
      if (condActive && condIdx >= 0)
      {
        if (entry == null) continue;
        var bit:Dynamic = entry[condIdx];
        var isTrue:Bool = bit == true || bit == 1;
        if (isTrue != condWant) continue;
      }
      var xPos:Dynamic = evalChoreoPos(xText, entry, tables);
      var yPos:Dynamic = evalChoreoPos(yText, entry, tables);
      var instance:Dynamic = null;
      if (kind == 'char')
      {
        instance = {name: vName, charId: charId, x: util.getFloat(get(xPos, 'off'), 0), y: util.getFloat(get(yPos, 'off'), 0), xRef: Std.string(get(xPos, 'ref')), visible: true, flipX: false, scaleX: 1, scaleY: 1, antialias: true, before: '', z: 150};
        get(program, 'characters').push(instance);
      }
      else
      {
        instance = {name: vName, x: util.getFloat(get(xPos, 'off'), 0), y: util.getFloat(get(yPos, 'off'), 0), xRef: Std.string(get(xPos, 'ref')), img: evalChoreoImg(imgArg, entry), atlas: '', anims: [], visible: true, flipX: false, scaleX: 1, scaleY: 1, antialias: true, before: '', z: 150};
        get(program, 'sprites').push(instance);
      }
      if (count > 1)
      {
        // Loop-expanded instances are addressable by base name AND by their
        // linear creation order; scripts index loop-created actors through
        // arrays ('for (a in 0...dupes.length) dupes[a].visible = true'),
        // and creation order matches the script's push order.
        set(instance, 'name', vName + emitted);
        set(instance, 'ord', emitted);
        set(instance, 'fromLoop', true);
        // The loop-table row this instance was created from; per-entry tween
        // values and delays read their own row through it at runtime.
        set(instance, 'loopIdx', i);
      }
      set(instance, 'base', vName);
      get(program, 'order').push(instance);
      emitted++;
    }
  }

  // Apply an attribute to every created instance matching the target name.
  function applyChoreoAttr(program:Dynamic, tables:Dynamic, target:String, attr:String, value:String, loopVar:String, loopList:String, loopCount:Int):Void
  {
    if (target == '') return;
    var refs:Array<Dynamic> = choreoRefsNamed(program, target, loopVar, loopList, loopCount);
    for (r in refs)
    {
      if (r == null) continue;
      if (attr == 'visible') set(r, 'visible', value == 'true');
      else if (attr == 'flipX')
      {
        if (value == 'true') set(r, 'flipX', true);
        else if (value == 'false') set(r, 'flipX', false);
        else if (value.indexOf('!') >= 0)
        {
          // '!o[4]' style: evaluate against the table entry when possible.
          var idxOpen:Int = value.indexOf('[');
          var idxClose:Int = value.indexOf(']', idxOpen);
          var k:Int = idxOpen >= 0 && idxClose > idxOpen ? Std.parseInt(value.substring(idxOpen + 1, idxClose)) : -1;
          if (k >= 0 && loopList != '')
          {
            // Evaluate against the instance's OWN table row (loopIdx), not
            // the first entry - each loop-created actor mirrors per its row.
            var rowIdx:Int = Std.int(util.getFloat(get(r, 'loopIdx'), 0));
            var entry:Dynamic = get(tables, loopList)[rowIdx];
            if (entry != null)
            {
              var bit:Dynamic = util.getBool(entry[k], false);
              set(r, 'flipX', !bit);
            }
          }
        }
      }
      else if (attr == 'antialiasing') set(r, 'antialias', boolVal(value));
      else if (attr == 'alpha') set(r, 'alpha', Std.parseFloat(value));
      else if (attr == 'scaleX')
      {
        var sv:Float = Std.parseFloat(value);
        if (!Math.isNaN(sv)) set(r, 'scaleX', sv);
      }
      else if (attr == 'scaleY')
      {
        var sv2:Float = Std.parseFloat(value);
        if (!Math.isNaN(sv2)) set(r, 'scaleY', sv2);
      }
      else if (attr == 'atlas') set(r, 'atlas', value);
    }
  }

  // Parse a boolean attribute value, honoring '!': '!(sign.visible = false)'
  // reads the inner assignment's value (false) and negates it (true).
  function boolVal(v:String):Bool
  {
    var t:String = StringTools.trim(v);
    var neg:Bool = t.indexOf('!') >= 0;
    var base:Bool = t == 'true';
    if (t.indexOf('true') >= 0) base = true;
    else if (t.indexOf('false') >= 0) base = false;
    return neg ? !base : base;
  }

  function applyChoreoAnim(program:Dynamic, tables:Dynamic, target:String, animName:String, prefix:String, fps:Float, loopVar:String, loopList:String, loopCount:Int):Void
  {
    if (animName == '' || prefix == '') return;
    var refs:Array<Dynamic> = choreoRefsNamed(program, target, loopVar, loopList, loopCount);
    for (r in refs)
    {
      if (r == null) continue;
      var anims:Array<Dynamic> = get(r, 'anims');
      if (anims == null) continue;
      var dup:Bool = false;
      for (existing in anims)
      {
        if (existing != null && Std.string(get(existing, 'name')) == animName) dup = true;
      }
      if (!dup) anims.push({name: animName, prefix: prefix, fps: fps, loop: false});
    }
  }

  // Instances matching a target name (with loop-expansion).
  function choreoRefsNamed(program:Dynamic, target:String, loopVar:String, loopList:String, loopCount:Int):Array<Dynamic>
  {
    var result:Array<Dynamic> = [];
    var order:Array<Dynamic> = get(program, 'order');
    if (order == null) return result;
    for (r in order)
    {
      if (r == null) continue;
      if (Std.string(get(r, 'name')) == target || Std.string(get(r, 'base')) == target) result.push(r);
    }
    return result;
  }

  function findChoreoRefs(program:Dynamic, tables:Dynamic, target:String, loopVar:String, loopList:String, loopCount:Int, cb:Dynamic):Void
  {
    var refs:Array<Dynamic> = choreoRefsNamed(program, target, loopVar, loopList, loopCount);
    for (r in refs)
    {
      if (r != null) cb(r);
    }
  }

  function resolveLoopTarget(rawTarget:String, loopVar:String, loopList:String, loopCount:Int):String
  {
    var t:String = StringTools.trim(rawTarget);
    if (t == '') return '';
    // 'arr[i]' where i is the current loop counter -> per-entry address that
    // the runtime maps onto the ordered created instances.
    var br:Int = t.indexOf('[');
    if (br > 0 && t.indexOf(']') > br)
    {
      var idxText:String = StringTools.trim(t.substring(br + 1, t.indexOf(']', br)));
      if (idxText == loopVar && loopCount > 0)
      {
        // Keep the bracket form; the runtime resolves 'base[i]' by order.
        return t;
      }
      var idxNum:Int = idxText != '' ? Std.parseInt(idxText) : -1;
      if (idxNum >= 0) return t;
    }
    return t;
  }

  function addBeatOp(program:Dynamic, beat:Int, target:String, op:String, value:Dynamic):Void
  {
    if (target == '' || target == 'null') return;
    var beats:Array<Dynamic> = get(program, 'beats');
    var entry:Dynamic = null;
    for (b in beats)
    {
      if (b != null && Std.int(util.getFloat(get(b, 'beat'), -1)) == beat) entry = b;
    }
    if (entry == null)
    {
      entry = {beat: beat, ops: []};
      beats.push(entry);
    }
    get(entry, 'ops').push({target: target, op: op, value: value});
  }

  // Expand a loop-variable target onto its concrete actors (a literal list
  // like 'for (a in [door1, door2])'), emitting one op per actor.
  function addBeatOpLoop(program:Dynamic, beat:Int, target:String, op:String, value:Dynamic, loopVar:String, loopList:String, tables:Dynamic):Void
  {
    if (target == loopVar && loopList != '' && StringTools.startsWith(loopList, '__list_'))
    {
      var items:Array<Dynamic> = get(tables, loopList);
      if (items != null)
      {
        for (item in items)
        {
          var name:String = Std.string(item);
          if (name != '' ) addBeatOp(program, beat, name, op, value);
        }
        return;
      }
    }
    addBeatOp(program, beat, target, op, value);
  }

  function addCallOp(program:Dynamic, fn:String, target:String, op:String, value:Dynamic):Void
  {
    if (target == '') return;
    var calls:Dynamic = get(program, 'calls');
    var ops:Array<Dynamic> = get(calls, fn);
    if (ops == null)
    {
      ops = [];
      set(calls, fn, ops);
    }
    ops.push({target: target, op: op, value: value});
  }

  // Loosely parse a constant nested array: [[-500,100,...],[...]].
  function parseConstTable(src:String):Array<Dynamic>
  {
    var result:Array<Dynamic> = [];
    var stack:Array<Dynamic> = [];
    var token:String = '';
    try
    {
      for (i in 0...src.length)
      {
        var c:String = src.charAt(i);
        if (c == '[')
        {
          // A pending token gluing to the bracket (line joins can attach a
          // comment to the following row) must be flushed BEFORE opening the
          // new row, or it swallows the row's first value.
          var pre:String = StringTools.trim(token);
          token = '';
          if (pre != '' && stack.length > 0)
          {
            var pv:Dynamic = constTableValue(pre);
            if (pv != null) stack[stack.length - 1].push(pv);
          }
          stack.push([]);
        }
        else if (c == ']' || c == ',')
        {
          var tt:String = StringTools.trim(token);
          token = '';
          if (tt != '' && stack.length > 0)
          {
            var val:Dynamic = constTableValue(tt);
            if (val != null) stack[stack.length - 1].push(val);
          }
          if (c == ']' && stack.length > 0)
          {
            var row:Dynamic = stack.pop();
            if (stack.length > 0) stack[stack.length - 1].push(row);
            else result.push(row);
          }
        }
        else token += c;
      }
    }
    catch (e:Dynamic)
    {
      return null;
    }
    // A top-level '[ [...] ]' yields a single wrapper array holding the
    // rows; callers expect the row list itself, so unwrap it.
    if (result.length == 1 && Std.isOfType(result[0], Array))
    {
      var child:Array<Dynamic> = result[0];
      var rowsOnly:Bool = child.length > 0;
      for (r in child)
      {
        if (r == null || !Std.isOfType(r, Array)) rowsOnly = false;
      }
      if (rowsOnly) result = child;
    }
    return result.length > 0 ? result : null;
  }

  function constTableValue(tt:String):Dynamic
  {
    if (tt == 'true') return true;
    if (tt == 'false') return false;
    var n:Float = Std.parseFloat(tt);
    if (!Math.isNaN(n)) return n;
    return null;
  }

  // Evaluate a choreography position expression to {off, ref}.
  function evalChoreoPos(text:String, entry:Dynamic, tables:Dynamic):Dynamic
  {
    var result:Dynamic = {off: 0.0, ref: ''};
    var t:String = StringTools.trim(text);
    if (t == '' || t == 'null') return result;
    // '<ref>.x + <rest>' (runtime-relative, e.g. 'dad.x + o[0]')
    var dotPos:Int = t.indexOf('.x');
    if (dotPos > 0)
    {
      var refName:String = StringTools.trim(t.substring(0, dotPos));
      var rest:String = StringTools.trim(t.substring(dotPos + 2));
      var rp:Int = rest.indexOf('+');
      if (rp >= 0) rest = StringTools.trim(rest.substring(rp + 1));
      set(result, 'ref', refName);
      var off:Float = valChoreoToken(rest, entry);
      if (!Math.isNaN(off)) set(result, 'off', off);
      return result;
    }
    var num:Float = valChoreoToken(t, entry);
    if (!Math.isNaN(num)) set(result, 'off', num);
    return result;
  }

  // One numeric token: plain number or 'NAME[K]' ('o[K]') reading the loop
  // table entry (the prefix is the loop variable name, e.g. 'o').
  function valChoreoToken(t:String, entry:Dynamic):Float
  {
    t = StringTools.trim(t);
    if (t == '') return Math.NaN;
    var n:Float = Std.parseFloat(t);
    if (!Math.isNaN(n)) return n;
    var oi:Int = t.indexOf('[');
    if (oi >= 0)
    {
      var oc:Int = t.indexOf(']', oi);
      var k:Int = oc > oi ? Std.parseInt(t.substring(oi + 1, oc)) : -1;
      if (k >= 0 && entry != null)
      {
        var v:Dynamic = entry[k];
        if (v != null && (Std.isOfType(v, Float) || Std.isOfType(v, Int))) return v;
        if (v == true) return 1;
      }
    }
    return Math.NaN;
  }

  // Evaluate a Paths.image(...) argument: literal or `base' + (o[K] ? 'A' : '')`.
  function evalChoreoImg(imgArg:String, entry:Dynamic):String
  {
    var t:String = StringTools.trim(imgArg);
    if (t == '') return '';
    var imgName:String = extractPathCall(t, 'Paths.image(');
    if (imgName == '') return '';
    var q:Int = imgName.indexOf("'");
    var base:String = '';
    var condRest:String = '';
    if (q >= 0)
    {
      var q2:Int = imgName.indexOf("'", q + 1);
      if (q2 > q) base = imgName.substring(q + 1, q2);
      condRest = StringTools.trim(imgName.substring(q2 + 1));
    }
    else
    {
      base = imgName;
    }
    var condA:String = '';
    var condB:String = '';
    var condIdx:Int = -1;
    var qm:Int = condRest.indexOf('?');
    var cl:Int = condRest.indexOf(':');
    if (qm >= 0 && cl > qm)
    {
      var skip:Int = condRest.indexOf('[');
      if (skip >= 0 && skip < qm)
      {
        var cl2:Int = condRest.indexOf(']', skip);
        if (cl2 > skip) condIdx = Std.parseInt(condRest.substring(skip + 1, cl2));
      }
      condA = stripQuotes(StringTools.trim(condRest.substring(qm + 1, cl)));
      condB = stripQuotes(StringTools.trim(condRest.substring(cl + 1)));
    }
    var useAlt:Bool = false;
    if (condIdx >= 0 && entry != null)
    {
      var cv:Dynamic = entry[condIdx];
      useAlt = cv == true || cv == 1;
    }
    if (condA != '' || condB != '')
    {
      return base + (useAlt ? condA : condB);
    }
    return base;
  }

  // Split a string on top-level commas (ignoring brackets/quotes).
  function splitTopLevel(s:String):Array<String>
  {
    var parts:Array<String> = [];
    var depth:Int = 0;
    var cur:String = '';
    var quote:String = '';
    for (i in 0...s.length)
    {
      var c:String = s.charAt(i);
      if (quote != '')
      {
        cur += c;
        if (c == quote) quote = '';
        continue;
      }
      if (c == "'" || c == '"') { quote = c; cur += c; continue; }
      if (c == '[' || c == '{' || c == '(') depth++;
      else if (c == ']' || c == '}' || c == ')') depth--;
      if (c == ',' && depth == 0)
      {
        parts.push(cur);
        cur = '';
      }
      else cur += c;
    }
    parts.push(cur);
    return parts;
  }

  function isIntText(t:String):Bool
  {
    if (t == '' || t == null) return false;
    for (i in 0...t.length)
    {
      var c:String = t.charAt(i);
      if (c < '0' || c > '9') return false;
    }
    return true;
  }

  // Tween extraction for a beat-case line.
  function extractChoreoTween(program:Dynamic, tables:Dynamic, line:String, beatCase:Int, loopVar:String, loopList:String, loopCount:Int, condActive:Bool, condIdx:Int, condWant:Bool, condTbl:String):Void
  {
    // Inline completion lambdas ('onComplete: function(_) {') leave the paren
    // balance open on the same line (the lambda body closes on later lines);
    // the callback body is not portable, so close both the options object and
    // the tween call at the lambda and parse only the header before it.
    var workLine:String = line;
    var ocIdx:Int = workLine.indexOf('onComplete:');
    if (ocIdx >= 0) workLine = workLine.substring(0, ocIdx) + '})';
    var callIdx:Int = workLine.indexOf('FlxTween.tween(');
    var open:Int = callIdx + 'FlxTween.tween('.length - 1;
    var close:Int = matchCloseParen(workLine, open);
    if (open < 0 || close <= open) return;
    var args:String = workLine.substring(open + 1, close);
    var parts:Array<String> = splitTopLevel(args);
    if (parts.length < 3) return;
    var targetText:String = StringTools.trim(parts[0]);
    var fieldsText:String = StringTools.trim(parts[1]);
    var durText:String = StringTools.trim(parts[2]);
    var optsText:String = parts.length > 3 ? StringTools.trim(parts[3]) : '';
    var ease:String = attrFromObj(optsText, 'ease');
    // FlxEase symbols come through verbatim ('FlxEase.cubeOut' or 'cubeOut');
    // the runtime resolves them against FlxEase directly.
    var fx:Int = ease.indexOf('FlxEase.');
    if (fx >= 0) ease = ease.substring(fx + 8);
    var delay:Float = numFromObj(optsText, 'startDelay', 0);
    // Per-entry start delays: 'startDelay: offsets[a][5]'.
    var delayTbl:String = '';
    var delayCol:Int = -1;
    var delayRef:Dynamic = parseTweenRefExpr(attrFromObj(optsText, 'startDelay'), loopVar, tables);
    if (delayRef != null)
    {
      delayTbl = Std.string(get(delayRef, 'tbl'));
      delayCol = Std.int(util.getFloat(get(delayRef, 'col'), -1));
    }
    // Per-entry branch predicate: 'if (!offsets[a][6]) FlxTween.tween(...)'.
    var condTbl2:String = '';
    if (condActive && condIdx >= 0 && loopVar != '' && loopVar != 'null' && condTbl != '') condTbl2 = condTbl;

    // Scale-target tweens: 'FlxTween.tween(dupes[a].scale, {x: 1, y: 1}, ...)'.
    var scaleTarget:Bool = false;
    if (StringTools.endsWith(targetText, '.scale'))
    {
      scaleTarget = true;
      targetText = StringTools.trim(targetText.substring(0, targetText.length - 6));
    }

    var fLo:Int = fieldsText.indexOf('{');
    var fHi:Int = fieldsText.lastIndexOf('}');
    if (fLo < 0 || fHi <= fLo) return;
    var fieldParts:Array<String> = splitTopLevel(fieldsText.substring(fLo + 1, fHi));

    var targets:Array<String> = [];
    var targetDurs:Array<Float> = [];
    // '[bf, gf][a]' with the loop variable as index: one target per entry.
    if (targetText.indexOf('[') == 0)
    {
      var br:Int = targetText.indexOf(']');
      var listCore:String = StringTools.trim(targetText.substring(1, br));
      var idxExpr:String = StringTools.trim(targetText.substring(br + 2, targetText.length - 1));
      var items:Array<String> = listCore.split(',');
      var iCount:Int = items.length;
      for (li in 0...iCount)
      {
        targets.push(StringTools.trim(items[li]));
      }
      if (idxExpr == loopVar && loopCount > 0) iCount = loopCount;
      // per-entry durations: '[3.167, 2.6][a]'
      var durList:Array<Float> = [];
      if (durText.indexOf('[') >= 0)
      {
        var dInner:String = StringTools.trim(durText.substring(1, durText.indexOf(']')));
        for (dp in dInner.split(','))
        {
          var dv:Float = Std.parseFloat(StringTools.trim(dp));
          if (Math.isNaN(dv)) dv = 1;
          durList.push(dv);
        }
      }
      for (ti in 0...targets.length)
      {
        var perDur:Float = Std.parseFloat(durText);
        if (Math.isNaN(perDur))
        {
          perDur = durList.length > ti ? durList[ti] : 1;
        }
        targetDurs.push(perDur);
      }
    }
    else
    {
      targets.push(resolveLoopTarget(targetText, loopVar, loopList, loopCount));
      var durN:Float = Std.parseFloat(durText);
      if (Math.isNaN(durN)) durN = 1;
      targetDurs.push(durN);
    }

    for (ti in 0...targets.length)
    {
      var target:String = targets[ti];
      if (target == '') continue;
      var dur:Float = targetDurs[ti];
      for (fp in fieldParts)
      {
        var eqF:Int = fp.indexOf(':');
        if (eqF < 0) continue;
        var fieldName:String = StringTools.trim(fp.substring(0, eqF));
        var fieldExpr:String = StringTools.trim(fp.substring(eqF + 1));
        // Runtime-relative, table-driven values: 'dad.y + offsets[a][3]' (and
        // bare 'offsets[a][K]' cells) are emitted as tweenRef ops so the
        // runtime can resolve each actor's own row.
        var delta:Float = exprDelta(fieldExpr);
        var refVal:Dynamic = parseTweenRefExpr(fieldExpr, loopVar, tables);
        if (scaleTarget && (fieldName == 'x' || fieldName == 'y'))
        {
          if (refVal == null && Math.isNaN(delta)) continue;
          var stOp:Dynamic = {f: fieldName, dur: dur, ease: ease, delay: delay};
          if (refVal != null)
          {
            set(stOp, 'tbl', get(refVal, 'tbl'));
            set(stOp, 'col', get(refVal, 'col'));
          }
          else set(stOp, 'v', delta);
          if (delayTbl != '')
          {
            set(stOp, 'delayTbl', delayTbl);
            set(stOp, 'delayCol', delayCol);
          }
          if (condTbl2 != '')
          {
            set(stOp, 'ifTbl', condTbl2);
            set(stOp, 'ifCol', condIdx);
            set(stOp, 'ifWant', condWant);
          }
          addBeatOpLoop(program, beatCase, target, 'scaleTo', stOp, loopVar, loopList, tables);
        }
        else if (fieldName == 'x' || fieldName == 'y')
        {
          if (refVal != null)
          {
            var twOp:Dynamic = {field: fieldName, dur: dur, ease: ease, delay: delay};
            if (get(refVal, 'abs') == true)
            {
              set(twOp, 'tbl', get(refVal, 'tbl'));
              set(twOp, 'col', get(refVal, 'col'));
            }
            else
            {
              set(twOp, 'ref', get(refVal, 'ref'));
              set(twOp, 'refField', get(refVal, 'refField'));
              set(twOp, 'tbl', get(refVal, 'tbl'));
              set(twOp, 'col', get(refVal, 'col'));
              set(twOp, 'sign', get(refVal, 'sign'));
            }
            if (delayTbl != '')
            {
              set(twOp, 'delayTbl', delayTbl);
              set(twOp, 'delayCol', delayCol);
            }
            if (condTbl2 != '')
            {
              set(twOp, 'ifTbl', condTbl2);
              set(twOp, 'ifCol', condIdx);
              set(twOp, 'ifWant', condWant);
            }
            addBeatOpLoop(program, beatCase, target, 'tweenRef', twOp, loopVar, loopList, tables);
          }
          else if (!Math.isNaN(delta))
          {
            addBeatOpLoop(program, beatCase, target, 'tween', {field: fieldName, delta: delta, dur: dur, ease: ease, delay: delay}, loopVar, loopList, tables);
          }
        }
      }
    }
  }

  // Resolve a tween field expression driven by a loop-table cell:
  // 'dad.y + offsets[a][3]' or a bare 'offsets[a][2]'. Returns
  // {tbl, col, abs, ref, refField, sign} or null when not table-based (the
  // caller then falls back to static delta extraction).
  function parseTweenRefExpr(expr:String, loopVar:String, tables:Dynamic):Dynamic
  {
    if (loopVar == '' || loopVar == 'null' || expr == '') return null;
    var t:String = StringTools.trim(expr);
    var lv:String = '[' + loopVar + ']';
    var lvPos:Int = t.indexOf(lv);
    if (lvPos < 0) return null;
    // The cell must immediately follow: 'TBL[loopVar][K]'.
    var cellOpen:Int = lvPos + lv.length;
    if (cellOpen >= t.length || t.charAt(cellOpen) != '[') return null;
    var cellClose:Int = t.indexOf(']', cellOpen);
    if (cellClose < 0) return null;
    var col:Int = Std.parseInt(t.substring(cellOpen + 1, cellClose));
    if (col == null || col < 0) return null;
    var tStart:Int = lvPos - 1;
    while (tStart >= 0 && isIdentChar(t.charAt(tStart))) tStart--;
    var tbl:String = t.substring(tStart + 1, lvPos);
    if (tbl == '' || get(tables, tbl) == null) return null;
    var result:Dynamic = {tbl: tbl, col: col, abs: true, ref: '', refField: '', sign: '+'};
    // 'REF.field +/- TBL[loopVar][K]' (value relative to a runtime actor).
    var left:String = StringTools.trim(t.substring(0, tStart + 1));
    var opIdx:Int = -1;
    for (li in 1...left.length)
    {
      if (left.charAt(li) == '+' || left.charAt(li) == '-') opIdx = li;
    }
    if (opIdx > 0)
    {
      var sign:String = left.charAt(opIdx) == '-' ? '-' : '+';
      var refExpr:String = StringTools.trim(left.substring(0, opIdx));
      var dot:Int = refExpr.indexOf('.');
      if (dot > 0)
      {
        var ref:String = StringTools.trim(refExpr.substring(0, dot));
        var refField:String = StringTools.trim(refExpr.substring(dot + 1));
        if (ref != '' && refField != '')
        {
          set(result, 'abs', false);
          set(result, 'ref', ref);
          set(result, 'refField', refField);
          set(result, 'sign', sign);
        }
      }
    }
    return result;
  }

  // Delta of a tween field expression: '<ref>.<dir> - 455' -> -455.
  function exprDelta(expr:String):Float
  {
    var t:String = StringTools.trim(expr);
    var lastOp:Int = -1;
    for (i in 1...t.length)
    {
      if (t.charAt(i) == '+' || t.charAt(i) == '-') lastOp = i;
    }
    if (lastOp > 0)
    {
      var tail:String = StringTools.trim(t.substring(lastOp + 1));
      var n:Float = Std.parseFloat(tail);
      if (!Math.isNaN(n)) return t.charAt(lastOp) == '-' ? -n : n;
    }
    var direct:Float = Std.parseFloat(t);
    return Math.isNaN(direct) ? Math.NaN : direct;
  }

  // Read an 'ease: X' field from a tween options object.
  function attrFromObj(opts:String, key:String):String
  {
    if (opts == '') return '';
    var keyIdx:Int = opts.indexOf(key + ':');
    if (keyIdx < 0) return '';
    var rest:String = StringTools.trim(opts.substring(keyIdx + key.length + 1));
    if (rest == '') return '';
    var cut:Int = rest.indexOf(',');
    if (cut < 0) cut = rest.indexOf('}');
    if (cut < 0) cut = rest.length;
    var val:String = StringTools.trim(rest.substring(0, cut));
    return stripQuotes(val);
  }

  function numFromObj(opts:String, key:String, fallback:Float):Float
  {
    var s:String = attrFromObj(opts, key);
    if (s == '') return fallback;
    var n:Float = Std.parseFloat(s);
    return Math.isNaN(n) ? fallback : n;
  }

  // Extract the quoted argument of a path call like Paths.image('...').
  function extractPathCall(text:String, callName:String):String
  {
    var ci:Int = text.indexOf(callName);
    if (ci < 0) return '';
    var p:Int = text.indexOf('(', ci);
    if (p < 0) return '';
    var rest:String = text.substring(p + 1);
    var q1:Int = rest.indexOf("'");
    var quote:String = "'";
    var qAlt:Int = rest.indexOf('"');
    if (qAlt >= 0 && (q1 < 0 || qAlt < q1)) { q1 = qAlt; quote = '"'; }
    if (q1 < 0) return '';
    var q2:Int = rest.indexOf(quote, q1 + 1);
    if (q2 <= q1) return '';
    return rest.substring(q1 + 1, q2);
  }

  // ------------------------------------------------------------------
  // Stages (XML -> JSON)
  // ------------------------------------------------------------------
  public function convertStages(dir:String, out:Dynamic):Void
  {
    var stagesRoot:String = 'mods/$dir/data/stages';
    if (!util.pathExists(stagesRoot)) return;
    var stageFiles:Array<String> = util.listDir(stagesRoot);
    for (stageFile in stageFiles)
    {
      var stageFileLower:String = stageFile.toLowerCase();
      if (StringTools.endsWith(stageFileLower, '.hx'))
      {
        util.warn('Codename: stage script $stageFile is not portable to V-Slice (HScript) - only the XML stage data will be imported');
        continue;
      }
      if (!StringTools.endsWith(stageFileLower, '.xml')) continue;
      var stageId:String = stageFile.substring(0, stageFile.length - 4);
      // Canonical lowercase id - must exactly match what songs request (see
      // convertSongs) since StageRegistry.fetchEntry is a raw map lookup.
      stageId = stageId.toLowerCase();
      // Cross-mod collision: a stage also defined by an earlier imported mod
      // gets a namespaced id here AND in convertSongs (same helper, so both
      // sides agree). Keeps the registry entry and every stage-art cache key
      // unique per mod.
      var stageFileBase:String = stageId;
      stageId = resolveStageId(dir, stageId);
      // Only convert stages that imported songs actually reference - the art
      // for unused stages was decoded at boot anyway (some mods ship several
      // unused full-size stages, costing gigabytes of RAM).
      if (get(usedStageIds, stageId) != true)
      {
        util.warn('Codename: skipping stage $stageFile (not referenced by any imported song)');
        continue;
      }
      var xmlText:String = util.readText('$stagesRoot/$stageFile');
      if (xmlText == null) continue;

      var root:String = extractFirstTag(xmlText, 'stage');
      var folderAttr:String = attr(root, 'folder');
      if (folderAttr == null) folderAttr = '';

      var props:Array<Dynamic> = [];
      var characters:Dynamic = {};
      // (name, bottom, scroll) of already-built props - used to rebase a
      // misaligned prop's vertical parallax to the ground element below it.
      var builtPropBottoms:Array<Dynamic> = [];

      // zIndex mirrors the Codename XML layering: sprites and character
      // anchors keep their document order (lower zIndex renders behind, just
      // like the XML sequence). Codename's default stage zoom is applied to
      // the stage entry below.
      var charTagToSlot:Dynamic = {girlfriend: 'gf', boyfriend: 'bf', dad: 'dad'};
      var charBodies:Dynamic = {};
      var charZ:Dynamic = {};

      var zOrder:Int = 0;
      var ordered:Array<Dynamic> = orderedTags(xmlText, ['sprite', 'spr', 'sparrow', 'box', 'solid', 'girlfriend', 'boyfriend', 'dad', 'character', 'char']);
      for (entry in ordered)
      {
        zOrder += 10;
        var tagName:String = Std.string(get(entry, 'name'));
        var body:String = Std.string(get(entry, 'body'));
        if (tagName == 'girlfriend' || tagName == 'boyfriend' || tagName == 'dad' || tagName == 'character' || tagName == 'char')
        {
          // Character anchor tags - resolve to a bf/dad/gf slot.
          var slot:Dynamic = get(charTagToSlot, tagName);
          if (slot != null)
          {
            set(charBodies, Std.string(slot), body);
            set(charZ, Std.string(slot), zOrder);
          }
          continue;
        }
        var isSolid:Bool = (tagName == 'box' || tagName == 'solid');

        var name:String = attr(body, 'name');
        if (name == null || name == '') name = 'prop$zOrder';
        var sprite:String = attr(body, 'sprite');
        if (sprite == null || sprite == '') sprite = name;
        if (StringTools.endsWith(sprite.toLowerCase(), '.png')) sprite = sprite.substring(0, sprite.length - 4);

        // The stage folder prefixes the sprite lookup. Some mods write the
        // folder WITHOUT a trailing slash (gumballs: folder="stages/philly") -
        // join with a '/' so the asset becomes stages/philly/sky instead of
        // the malformed stages/phillysky (which silently fails to load, so
        // the whole background vanishes).
        var assetPath:String = sprite;
        if (folderAttr != '')
        {
          assetPath = folderAttr;
          if (!StringTools.endsWith(assetPath, '/')) assetPath += '/';
          assetPath += sprite;
          // Normalize slashes (covers folder plus sprite both ending/starting
          // with a slash).
          while (assetPath.indexOf('//') >= 0)
          {
            assetPath = StringTools.replace(assetPath, '//', '/');
          }
        }
        // Remove trailing slash on folder.
        if (StringTools.endsWith(assetPath, '/')) assetPath = assetPath.substring(0, assetPath.length - 1);
        // The on-disk file keeps its original location; only the registered
        // key may change when the stage id was namespaced.
        var diskRel:String = assetPath;
        // When the stage id was namespaced, re-key every asset under the
        // stage folder ('stages/<base>/...' -> 'stages/<renamed>/...') so the
        // art cannot be overwritten by another mod's identically-named stage.
        if (stageId != stageFileBase && StringTools.startsWith(assetPath, 'stages/$stageFileBase'))
        {
          var segEnd:Int = 'stages/$stageFileBase'.length;
          if (assetPath.length == segEnd || assetPath.charAt(segEnd) == '/')
          {
            assetPath = 'stages/$stageId' + assetPath.substring(segEnd);
          }
        }

        var scrollF:Float = floatAttr(body, 'scroll', 1);
        // Codename supports separate scrollx/scrolly (e.g. high parallax
        // foregrounds); fall back to the single scroll attr.
        var scrollX:Float = floatAttr(body, 'scrollx', scrollF);
        var scrollY:Float = floatAttr(body, 'scrolly', scrollF);
        var scaleX:Float = floatAttr(body, 'scalex', floatAttr(body, 'scale', 1));
        var scaleY:Float = floatAttr(body, 'scaley', floatAttr(body, 'scale', 1));

        // Solid color rectangle (<box> / <solid>) — V-Slice supports assetPath as color.
        if (isSolid)
        {
          var boxW:Float = floatAttr(body, 'width', floatAttr(body, 'w', 100));
          var boxH:Float = floatAttr(body, 'height', floatAttr(body, 'h', 100));
          var boxColor:String = attr(body, 'color');
          if (boxColor == null || boxColor == '') boxColor = '#FFFFFF';
          // Codename stores colors as 0xAARRGGBB or #RRGGBB; normalize to #RRGGBB.
          if (StringTools.startsWith(boxColor, '0x')) boxColor = '#' + boxColor.substring(boxColor.length - 6);
          var boxX:Float = floatAttr(body, 'x', 0);
          var boxY:Float = floatAttr(body, 'y', 0);
          var solidProp:Dynamic = {
            name: name,
            assetPath: boxColor,
            position: [boxX, boxY],
            scale: [boxW, boxH],
            scroll: [scrollX, scrollY],
            flipX: boolAttr(body, 'flipX', false),
            flipY: boolAttr(body, 'flipY', false),
            alpha: floatAttr(body, 'alpha', 1),
            angle: floatAttr(body, 'angle', 0),
            zIndex: zOrder,
            animations: []
          };
          if (boolAttr(body, 'antialiasing', true) == false) solidProp.isPixel = true;
          var blendRaw2:String = attr(body, 'blend');
          if (blendRaw2 != null && blendRaw2 != '') solidProp.blend = blendRaw2;
          props.push(solidProp);
          continue;
        }

        // Stage sprite animations. Codename: <sprite type="beat|loop"> with
        // <anim name=.. anim=.. fps=.. loop=.. x=.. y=../> children. V-Slice
        // plays these through Bopper props (danceEvery + startingAnimation +
        // prefix-based animations).
        var propPngPath:String = 'mods/$dir/images/$diskRel.png';
        var propAtlas:String = util.readText('mods/$dir/images/$diskRel.xml');
        var frameNames:Array<String> = [];
        var subTextures:Array<String> = [];
        // Per-frame trim metadata: (name, frameX, frameY, crop width, crop height).
        // The trim (frameX/frameY + crop size) determines where a frame's CONTENT
        // sits inside its source box; frames whose trim differs vertically from
        // their neighbors render their content on a different baseline.
        var frameTrims:Array<Dynamic> = [];
        if (propAtlas != null)
        {
          subTextures = extractTags(propAtlas, 'SubTexture');
          for (st in subTextures)
          {
            var fn:String = attr(st, 'name');
            if (fn != null && fn != '')
            {
              frameNames.push(fn);
              frameTrims.push({
                name: fn,
                tx: parseIntAttr(st, 'x', 0),
                ty: parseIntAttr(st, 'y', 0),
                fx: parseIntAttr(st, 'frameX', 0),
                fy: parseIntAttr(st, 'frameY', 0),
                cw: parseIntAttr(st, 'width', 0),
                ch: parseIntAttr(st, 'height', 0),
                fw: parseIntAttr(st, 'frameWidth', 0),
                fh: parseIntAttr(st, 'frameHeight', 0)
              });
            }
          }
        }
        // Child <anim> elements live INSIDE the sprite element (after the
        // tag's '>'), not in its attribute body - parse them from the
        // element's content region (tank.xml-style explosions etc.).
        var animBodies:Array<String> = [];
        var childStart:Int = Std.int(get(entry, 'openEnd'));
        var childEnd:Int = Std.int(get(entry, 'closePos'));
        if (childEnd - childStart > 0)
        {
          animBodies = extractTags(xmlText.substring(childStart, childEnd), 'anim');
        }
        var animsOut:Array<Dynamic> = [];
        for (ab in animBodies)
        {
          animsOut.push({
            name: attr(ab, 'name'),
            prefix: attr(ab, 'anim'),
            frameRate: parseIntAttr(ab, 'fps', 24),
            looped: boolAttr(ab, 'loop', false),
            offsets: [parseIntAttr(ab, 'x', 0), parseIntAttr(ab, 'y', 0)]
          });
        }
        // Codename stage sprites default to LOOP (Stage.hx creates them with
        // defaultAnimType LOOP), and a sprite with an atlas but no <anim>
        // children gets an implicit 'idle' over ALL its frames (XMLUtil
        // loadSpriteFromXML). Reproduce both so beat/loop props animate
        // instead of rendering as a static full-sheet texture.
        var spriteType:String = attr(body, 'type');
        if (spriteType == null || spriteType == '') spriteType = 'loop';
        var realignedPropAtlas:String = null;
        if (animsOut.length == 0 && frameNames.length > 0 && spriteType != 'none')
        {
          // Detect pose groups whose trim baseline hops vertically. An atlas
          // whose frames repeat identical drawings (same trim) in runs plays a
          // staccato loop; when two such runs render their content on
          // DIFFERENT baselines (frameY or crop height differ), the loop makes
          // the prop visibly float/jump (gumballs' highschool crowd: pose A
          // offset 10px high + 222-tall crop vs pose B 0px + 232-tall crop).
          // Instead of dropping the animation, RE-ALIGN every pose's draw
          // offset so the content centers coincide - the loop then plays in
          // place as a subtle pulse instead of drifting diagonally.
          var trimGroups:Array<Dynamic> = [];
          var curGroup:Dynamic = null;
          for (ft in frameTrims)
          {
            if (curGroup == null
              || curGroup.fx != ft.fx
              || curGroup.fy != ft.fy
              || curGroup.cw != ft.cw
              || curGroup.ch != ft.ch)
            {
              curGroup = {
                fx: ft.fx,
                fy: ft.fy,
                cw: ft.cw,
                ch: ft.ch,
                frames: 0,
                firstName: ft.name
              };
              trimGroups.push(curGroup);
            }
            curGroup.frames = curGroup.frames + 1;
          }
          var minFy:Int = 9999;
          var maxFy:Int = -9999;
          var minCh:Int = 9999;
          var maxCh:Int = -9999;
          var multiFrame:Array<Dynamic> = [];
          for (g in trimGroups)
          {
            if (g.frames > 1) multiFrame.push(g);
            if (g.fy < minFy) minFy = g.fy;
            if (g.fy > maxFy) maxFy = g.fy;
            if (g.ch < minCh) minCh = g.ch;
            if (g.ch > maxCh) maxCh = g.ch;
          }
          // Multiple repeated poses with a >=8px vertical trim spread.
          var misaligned:Bool = multiFrame.length > 1 && (maxFy - minFy) >= 8;
          if (misaligned)
          {
            // Reference pose = the one closest to an untrimmed box (largest
            // frameY = the standing/grounded pose). The author draws every
            // pose's feet at the sourceSize box BOTTOM (content bottom =
            // offset.y + crop height = frameHeight for all poses - verified:
            // pose A -frameY 10 + crop 222 = 232 = -frameY 0 + 232 of pose B),
            // so the feet NEVER lift. What drifts between poses is the
            // HORIZONTAL placement (pose A is shifted ~36px right of B). Pin
            // every pose's horizontal center to the reference and leave the
            // vertical trims AS AUTHORED - the crowd then bounces in place
            // with planted feet instead of drifting side to side.
            var ref:Dynamic = trimGroups[0];
            for (g in trimGroups)
            {
              if (g.fy > ref.fy || (g.fy == ref.fy && g.ch > ref.ch)) ref = g;
            }
            var refCx:Float = (-ref.fx) + ref.cw / 2;
            // flixel draws the crop at sprite pos + offset, and offset =
            // (-frameX, -frameY) - so content center x = -frameX + cw/2.
            // Pin every frame's horizontal center to the reference's.
            var realignedText:String = propAtlas;
            for (st in subTextures)
            {
              var stName:String = attr(st, 'name');
              if (stName == null || stName == '') continue;
              var stTrim:Dynamic = null;
              for (ft in frameTrims)
              {
                if (ft.name == stName)
                {
                  stTrim = ft;
                  break;
                }
              }
              if (stTrim == null) continue;
              var newFx:Int = Std.int(-Math.round(refCx - stTrim.cw / 2));
              var oldFx:Int = stTrim.fx;
              if (newFx == oldFx) continue;
              var newBody:String = StringTools.replace(st, 'frameX="$oldFx"', 'frameX="$newFx"');
              realignedText = StringTools.replace(realignedText, st, newBody);
            }
            if (realignedText != propAtlas)
            {
              realignedPropAtlas = realignedText;
              util.warn('Codename: stage prop "$name" has poses offset horizontally (${maxFy - minFy}px trim spread) - centered their frames so the animation stays put (feet already share the ground line)');
            }
          }

          // Longest prefix shared by every frame name; addByPrefix picks up
          // all frames starting with it, i.e. the whole sheet in order.
          var commonPrefix:String = frameNames[0];
          for (fi in 1...frameNames.length)
          {
            while (commonPrefix.length > 0 && !StringTools.startsWith(frameNames[fi], commonPrefix))
            {
              commonPrefix = commonPrefix.substring(0, commonPrefix.length - 1);
            }
            if (commonPrefix == '') break;
          }
          if (commonPrefix != '')
          {
            // Play the implicit idle at 12fps, matching how the fork's own
            // vanilla animated props are authored (mainStageErect crowd uses
            // frameRate 12). The source engine hardcodes 24fps here, but at
            // 24fps a two-pose ambient bounce reads as 'floating'; 12fps
            // keeps the same frames at a calmer rate.
            animsOut.push({
              name: 'idle',
              prefix: commonPrefix,
              frameRate: 12,
              looped: spriteType != 'beat',
              offsets: [0, 0]
            });
          }
          else
          {
            util.warn('Codename: stage prop "$name" atlas frames share no common prefix - imported as a static image');
          }
        }

        // Both engines use the official flixel fork, whose draw math is
        //   drawnTL = x - offset + origin*(1-scale)
        // with updateHitbox() setting offset = frame*(1-S)/2 and centering
        // the origin - so AFTER updateHitbox the offset and origin terms
        // cancel and the top-left is drawn EXACTLY at x/y (vanilla mainStage
        // keeps legacy coords like stagefront [-650,600] at scale 1.1 as-is).
        // Codename stage sprites never run updateHitbox (unless the XML asks)
        // so they keep offset (0,0) with a CENTERED origin and draw the
        // top-left at x + frameW*(1-scaleX)/2. Reproduce that exactly:
        //   position = [x + frameW*(1-scaleX)/2, y + frameH*(1-scaleY)/2]
        var propPngPath:String = 'mods/$dir/images/$diskRel.png';
        var propDims:Dynamic = util.spriteDims(propAtlas, propPngPath);
        var px:Float = floatAttr(body, 'x', 0);
        var py:Float = floatAttr(body, 'y', 0);
        if (propDims != null)
        {
          px += util.getFloat(propDims.w, 0) * (1 - scaleX) / 2;
          py += util.getFloat(propDims.h, 0) * (1 - scaleY) / 2;
        }
        // Codename leaves stage sprites at their XML x/y unless the author
        // explicitly requests updateHitbox. V-Slice updates every prop's
        // hitbox before assigning its position. Restore the authored Sparrow
        // source-rectangle placement for the default (no-updateHitbox) case:
        // trimmed frames with negative frameX/frameY otherwise render left/up
        // of their Codename position. This is data-driven and applies to any
        // trimmed stage atlas, not just the highschool crowd.
        if (attr(body, 'updateHitbox') != 'true' && frameTrims != null && frameTrims.length > 0)
        {
          var firstTrim:Dynamic = frameTrims[0];
          px -= util.getFloat(get(firstTrim, 'fx'), 0) * scaleX;
          py -= util.getFloat(get(firstTrim, 'fy'), 0) * scaleY;
        }

        var prop:Dynamic = {
          name: name,
          animType: 'sparrow',
          assetPath: assetPath,
          position: [px, py],
          scale: [scaleX, scaleY],
          scroll: [scrollX, scrollY],
          flipX: boolAttr(body, 'flipX', false),
          flipY: boolAttr(body, 'flipY', false),
          alpha: floatAttr(body, 'alpha', 1),
          angle: floatAttr(body, 'angle', 0),
          zIndex: zOrder,
          animations: animsOut
        };
        // Skew and zoomFactor are Codename-specific and not part of StageData;
        // they are preserved via DynStage dynamicProps when used with camera scroll.
        // Codename: BEAT props bop on the beat, LOOP props play
        // continuously. Mirror that: only beat props get danceEvery; loop
        // props start their animation and keep running (danceEvery 0).
        if (animsOut.length > 0)
        {
          prop.startingAnimation = Std.string(get(animsOut[0], 'name'));
          if (spriteType == 'beat')
          {
            prop.danceEvery = parseIntAttr(body, 'beatInterval', 1);
            if (prop.danceEvery < 1) prop.danceEvery = 1;
          }
        }
        // Optional visual attributes.
        if (boolAttr(body, 'antialiasing', true) == false) prop.isPixel = true;
        var blendRaw:String = attr(body, 'blend');
        if (blendRaw != null && blendRaw != '') prop.blend = blendRaw;
        var colorRaw:String = attr(body, 'color');
        if (colorRaw != null && colorRaw != '') prop.color = colorRaw;

        // Create()-time overrides from the song scripts (sprites hidden until
        // an HScript Call event reveals them) - render them invisible now.
        var spritePatch:Dynamic = get(stageSpritePatch, stageId);
        if (spritePatch != null)
        {
          var pa:Dynamic = get(spritePatch, name);
          if (pa == null) pa = get(spritePatch, sprite);
          if (pa != null) prop.alpha = pa;
        }
        // Misaligned-pose props (realigned above) are crowd/building-adjacent
        // props whose feet already touch their own ground line; the residual
        // 'floating' comes from their feet sitting ABOVE the ground plane the
        // stage paints in front of them at the song's camera. Plant them ON
        // the ground plane: reuse the lowest/front-most element below them
        // (the stage floor) - match ITS parallax and drop the prop's feet to
        // that plane's top edge (the deep ground line where the background
        // meets the floor). The prop then stays glued to the ground at ANY
        // camera height.
        //
        // This is the one deliberate deviation from a strict 1:1 port of
        // Codename's loader (which keeps the author's scroll + y and lets the
        // crowd hover the way it does in the original engine). Set
        // stageBias.<id>.crowdGround=false in the layer config to get the
        // untouched, author-placed version instead.
        // Preserve Codename's authored position by default. Ground-plane
        // correction is an optional compatibility override for stages whose
        // art explicitly requires it; applying it globally moves some props
        // above their original y coordinate.
        var crowdGround:Bool = false;
        var cfgGround:Dynamic = getLayerConfig();
        var stageGroundBias:Dynamic = get(cfgGround, 'stageBias');
        if (stageGroundBias != null)
        {
          var sgGround:Dynamic = get(stageGroundBias, stageId);
          if (sgGround != null && get(sgGround, 'crowdGround') != null)
          {
            crowdGround = util.getFloat(get(sgGround, 'crowdGround'), 1) > 0;
          }
        }
        if (crowdGround && realignedPropAtlas != null && propDims != null)
        {
          // Plant the prop's VISIBLE feet (not its frame box) onto the ground
          // element's VISIBLE surface (not its frame top). Modded crowd art
          // usually has empty padding below the drawn characters (gumballs'
          // highschool crowd: feet ~17px above the frame bottom) and ground
          // art a transparent margin above the drawn surface (floor: ~19px),
          // so planting the bare frames leaves a visible hover gap. Both
          // offsets are measured from the actual PNGs (best-effort; 0 keeps
          // the old frame-based behavior on any read/decode failure).
          var myFeet:Float = py + util.getFloat(propDims.h, 0) * scaleY;
          var ground:Dynamic = null;
          for (b in builtPropBottoms)
          {
            if (util.getFloat(get(b, 'bottom'), 0) > myFeet + 4)
            {
              if (ground == null || util.getFloat(get(b, 'bottom'), 0) > util.getFloat(get(ground, 'bottom'), 0)) ground = b;
            }
          }
          if (ground != null && get(ground, 'topY') != null)
          {
            var feetInset:Float = 0;
            if (frameTrims != null && frameTrims.length > 0)
            {
              feetInset = util.propFeetInset('mods/$dir/images/$diskRel.png', frameTrims);
            }
            var groundScaleY:Float = util.getFloat(get(ground, 'scaleY'), 1);
            var groundInset:Float = util.groundSurfaceInset(Std.string(get(ground, 'pngRel')), get(ground, 'frameRect'));
            var visualFeet:Float = myFeet - feetInset * scaleY;
            var groundTop:Float = util.getFloat(get(ground, 'topY'), 0);
            var groundSurface:Float = groundTop + groundInset * groundScaleY;
            var dy:Float = groundSurface - visualFeet;
            var groundScroll:Float = util.getFloat(get(ground, 'scroll'), 1);
            prop.position = [px, py + dy];
            prop.scroll = [groundScroll, groundScroll];
            util.warn('Codename: stage prop "$name" planted on the ground plane (element "' + Std.string(get(ground, 'name')) + '") - drawn feet moved $dy (art feet inset $feetInset, ground surface inset $groundInset) so the drawn feet touch the drawn ground at any camera');
          }
        }
        props.push(prop);
        if (propDims != null)
        {
          var groundRect:Dynamic = {x: 0, y: 0, w: util.getFloat(propDims.w, 0), h: util.getFloat(propDims.h, 0), fy: 0};
          if (frameTrims != null && frameTrims.length > 0 && get(frameTrims[0], 'fw') != null && util.getFloat(get(frameTrims[0], 'fw'), 0) > 0)
          {
            groundRect = {x: get(frameTrims[0], 'tx'), y: get(frameTrims[0], 'ty'), w: get(frameTrims[0], 'cw'), h: get(frameTrims[0], 'ch'), fy: get(frameTrims[0], 'fy')};
          }
          builtPropBottoms.push({name: name, bottom: py + util.getFloat(propDims.h, 0) * scaleY, scroll: util.getFloat(get(prop, 'scroll')[1], scrollY), topY: py, scaleY: scaleY, pngRel: 'mods/$dir/images/$diskRel.png', frameRect: groundRect});
        }

        addImage(out, dir, '$diskRel.png', '$assetPath.png');
        // The realigned atlas overrides the on-disk one for the fork (the
        // prop's animations play the aligned frames; without this the raw
        // file would re-register over it via addImage above).
        if (realignedPropAtlas != null)
        {
          out.texts.push({paths: util.imageKeys('$assetPath.xml'), content: realignedPropAtlas});
        }
      }

      // Character anchor tags. Codename anchors are the sprite's TOP-LEFT
      // corner (psych heritage: defaults are (770,100)/(100,100)), while
      // V-Slice positions characters by feet/center - so the anchor is
      // shifted by half width / full height of the slot's character, plus
      // the character's baked root offset (see placeAnchor).
      var bfZ:Int = 300; if (get(charZ, 'bf') != null) bfZ = Std.int(get(charZ, 'bf'));
      var dadZ:Int = 200; if (get(charZ, 'dad') != null) dadZ = Std.int(get(charZ, 'dad'));
      var gfZ:Int = 100; if (get(charZ, 'gf') != null) gfZ = Std.int(get(charZ, 'gf'));
      placeAnchor(stageId, get(charBodies, 'bf'), characters, 'bf', bfZ, 770, 100, 1);
      placeAnchor(stageId, get(charBodies, 'dad'), characters, 'dad', dadZ, 100, 100, 1);
      placeAnchor(stageId, get(charBodies, 'gf'), characters, 'gf', gfZ, 400, 130, 0.95);

      if (stageId == 'awesomestage')
      {
        // Hardcode positions for awesomestage to fix floating (universal ground planting broke other stages)
        var bfFix:Dynamic = get(characters, 'bf');
        if (bfFix != null) { var pp:Dynamic = get(bfFix,'position'); if (pp != null) { pp[0]=846; pp[1]=620; } }
        var dadFix:Dynamic = get(characters, 'dad');
        if (dadFix != null) { var pp2:Dynamic = get(dadFix,'position'); if (pp2 != null) { pp2[0]=16; pp2[1]=620; } }
        var gfFix:Dynamic = get(characters, 'gf');
        if (gfFix != null) { var pp3:Dynamic = get(gfFix,'position'); if (pp3 != null) { pp3[0]=400; pp3[1]=620; } }
        trace('[FUNKY-COMPAT] awesomestage fixed bf/dad/gf to 846,620 / 16,620 / 400,620');
        for (k in ['bf', 'dad', 'gf'])
        {
          var ce2:Dynamic = get(characters, k);
          if (ce2 != null) trace('[FUNKY-COMPAT] awesomestage $k pos ' + Std.string(get(ce2, 'position')) + ' cam ' + Std.string(get(ce2, 'cameraOffsets')) + ' scale ' + Std.string(get(ce2, 'scale')));
        }
      }

      // Apply create()-time character visibility from the song script
      // ('dad.visible = false', 'gf.visible = false'...). The reveal events
      // those scripts would fire are HScript and don't run here, so the
      // initial hidden state is what sticks - which matches the create()
      // intent better than showing characters the mod never meant to show.
      var charPatch:Dynamic = get(stageSpritePatch, stageId);
      if (charPatch != null)
      {
        var refToSlot:Dynamic = {boyfriend: 'bf', player: 'bf', dad: 'dad', opponent: 'dad', gf: 'gf', girlfriend: 'gf'};
        for (refName in ReflectUtil.fields(refToSlot))
        {
          var patchAlpha:Dynamic = get(charPatch, refName);
          if (patchAlpha == null) continue;
          var slotName:String = Std.string(get(refToSlot, refName));
          var charEntry:Dynamic = get(characters, slotName);
          if (charEntry != null)
          {
            var curAlpha:Float = util.getFloat(get(charEntry, 'alpha'), 1);
            var newAlpha:Float = util.getFloat(patchAlpha, 0);
            if (newAlpha < curAlpha)
            {
              set(charEntry, 'alpha', newAlpha);
            }
          }
        }
      }

      // Codename's default camera zoom when the stage has no zoom attr.
      var cameraZoom:Float = floatAttr(root, 'zoom', 0.9);
      if (cameraZoom <= 0) cameraZoom = 0.9;
      // create()-time zoom override from the stage script (top-level
      // assignments only - mid-song beatHit changes are time-dependent and
      // not portable).
      var scriptZoom:Float = stageScriptZoom(dir, stageId);
      if (scriptZoom > 0)
      {
        util.warn('Codename: stage "$stageId" script sets a custom camera zoom $scriptZoom');
        cameraZoom = scriptZoom;
      }
      // Per-stage zoom override from the layer config (stageBias.<id>.zoom) -
      // the Uboa-style charts drop very low (0.5x) and some stages need a
      // nudge (+/-) to match the original look.
      var cfg2:Dynamic = getLayerConfig();
      var stageOver2:Dynamic = get(cfg2, 'stageBias');
      if (stageOver2 != null)
      {
        var over2:Dynamic = get(stageOver2, stageId);
        if (over2 != null && get(over2, 'zoom') != null) cameraZoom = util.getFloat(get(over2, 'zoom'), cameraZoom);
      }

      var stageData:Dynamic = {
        version: '1.0.0',
        name: stageId,
        cameraZoom: cameraZoom,
        characters: characters,
        props: props
      };
      addText(out, util.dataTextKeys('stages/$stageId.json'), util.stringify(stageData));
      out.stages.push(stageId);
      util.claimForeign('stages', stageId);

      // Register assets referenced only by stage HScript (for example
      // dynamically-created background atlases). The normal stage XML pass
      // cannot see these, and sweepImages intentionally skips stage PNGs.
      registerStageScriptAssets(dir, stageId, stageFileBase, out);

      // Generate runtime config for the generic FunkyCompatDynStage.
      var dynCfg:Dynamic = buildDynCfg(dir, stageId, stageFileBase, xmlText);
      if (dynCfg != null)
      {
        if (out.stageScripts == null) out.stageScripts = [];
        out.stageScripts.push({id: stageId, cfg: dynCfg});
      }
    }
  }

  // Register PNG/XML pairs referenced directly by a stage HScript. Asset keys
  // follow the converted stage id so namespaced stages resolve correctly at
  // runtime even though the script still contains its original stage path.
  public function registerStageScriptAssets(dir:String, stageId:String, baseId:String, out:Dynamic):Void
  {
    var text:String = stageScriptText(dir, baseId);
    if (text == null || text == '') text = stageScriptText(dir, stageId);
    if (text == null || text == '') return;
    var lines:Array<String> = text.split('\\n');
    for (raw in lines)
    {
      var line:String = StringTools.trim(raw);
      var marker:String = '';
      var p:Int = line.indexOf('Paths.getSparrowAtlas(');
      if (p < 0) p = line.indexOf('Paths.image(');
      if (p < 0) continue;
      var q1:Int = line.indexOf("'", p);
      var quote:String = "'";
      var qAlt:Int = line.indexOf('"', p);
      if (qAlt >= 0 && (q1 < 0 || qAlt < q1)) { q1 = qAlt; quote = '"'; }
      if (q1 < 0) continue;
      var q2:Int = line.indexOf(quote, q1 + 1);
      if (q2 <= q1) continue;
      var rel:String = line.substring(q1 + 1, q2);
      if (!StringTools.startsWith(rel, 'stages/')) continue;
      var diskRel:String = rel;
      var keyRel:String = rel;
      var oldRoot:String = 'stages/$baseId';
      if (stageId != baseId && StringTools.startsWith(rel, oldRoot))
        keyRel = 'stages/$stageId' + rel.substring(oldRoot.length);
      addImage(out, dir, '$diskRel.png', '$keyRel.png');
      // Stage scripts often animate a Paths.image(...) sprite (Codename
      // addAnim needs atlas frames) whose sheet+XML live next to the file:
      // register the sibling atlas so getSparrowAtlas resolves for it.
      var xmlText2:String = util.readText('mods/$dir/images/$diskRel.xml');
      if (xmlText2 != null)
      {
        out.texts.push({paths: util.imageKeys('$keyRel.xml'), content: xmlText2});
      }
    }
  }

  // The stage HScript with the same base name as the stage XML (codename
  // convention: stage.xml + stage.hx), case-insensitive. Returns null when
  // the mod ships no script.
  public function stageScriptText(dir:String, stageId:String):String
  {
    var files:Array<String> = util.listDir('mods/$dir/data/stages');
    for (f in files)
    {
      var fl:String = f.toLowerCase();
      if (!StringTools.endsWith(fl, '.hx')) continue;
      if (f.substring(0, f.length - 3).toLowerCase() == stageId) return util.readText('mods/$dir/data/stages/$f');
    }
    return null;
  }

  // Parse create()-time '<ref>.cameraOffset = FlxPoint.get(x, y)' overrides
  // from a stage script. RETIRED: Codename only runs these in create() when
  // the character references exist, which the ordering analysis could not
  // confirm - applying them threw the camera off. Kept out of the conversion;
  // user-reported over-tuning is handled via stageBias config instead.

  // create()-time 'defaultCamZoom = <n>' from the stage script's TOP-LEVEL
  // chunk (before the first function - mid-song beatHit changes are not
  // portable). Returns -1 when unset.
  public function stageScriptZoom(dir:String, stageId:String):Float
  {
    var scriptText:String = stageScriptText(dir, stageId);
    if (scriptText == null || scriptText == '') return -1;
    var fnIdx:Int = scriptText.indexOf('function');
    var topText:String = fnIdx >= 0 ? scriptText.substring(0, fnIdx) : scriptText;
    var needle:String = 'defaultCamZoom';
    var result:Float = -1;
    var pos:Int = 0;
    while (true)
    {
      var idx:Int = topText.indexOf(needle, pos);
      if (idx < 0) break;
      var eq:Int = topText.indexOf('=', idx);
      if (eq >= 0)
      {
        var end:Int = topText.indexOf('\n', eq);
        if (end < 0) end = topText.length;
        var seg:String = StringTools.trim(topText.substring(eq + 1, end));
        var semi:Int = seg.indexOf(';');
        if (semi > 0) seg = StringTools.trim(seg.substring(0, semi));
        var v:Float = Std.parseFloat(seg);
        if (v != null && !Math.isNaN(v) && v > 0) result = v;
      }
      pos = idx + needle.length;
    }
    return result;
  }

  // Convert a codename character anchor (top-left based) into a V-Slice
  // stage character entry (feet/center based). The anchor's scale multiplies
  // the character's base scale in both engines, so the drawn size is
  // frameSize * charDataScale * anchorScale.
  //
  // Both engines render with the same flixel fork: drawnTL = x - offset +
  // origin*(1-scale), and updateHitbox() makes offset cancel origin, so a
  // V-Slice stage position anchors the drawn frame's CENTER-x and FEET-y
  // (scale-independent). Codename characters apply their global offset as a
  // flixel offset (offset.x = rootX * (isPlayer != playerOffsets ? 1 : -1))
  // and scale about the CENTERED origin, so their drawn center is
  // (x + rootX*flipFactor + frameW/2, ...) and their feet are (..., y + rootY
  // + frameH*(1+S)/2). Aligning the two:
  //   position.x = x + rootX*f + frameW/2      (drawn center x)
  //   position.y = y + rootY + frameH*(1+S)/2  (drawn feet)
  public function placeAnchor(stageId:String, body:String, characters:Dynamic, key:String, zIndex:Int, defX:Float, defY:Float, defScroll:Float):Void
  {
    if (body == null) body = '';
    var x:Float = defX;
    var y:Float = defY;
    var anchorScale:Float = 1;
    var scroll:Float = defScroll;
    var alpha:Float = 1;
    var angle:Float = 0;
    var camX:Float = 0;
    var camY:Float = 0;
    if (body != '')
    {
      x = floatAttr(body, 'x', defX);
      y = floatAttr(body, 'y', defY);
      var sxRaw:String = attr(body, 'scalex');
      if (sxRaw != null && sxRaw != '')
      {
        anchorScale = Std.parseFloat(sxRaw);
        if (anchorScale == null) anchorScale = 1;
      }
      else
      {
        anchorScale = floatAttr(body, 'scale', 1);
      }
      scroll = floatAttr(body, 'scroll', defScroll);
      alpha = floatAttr(body, 'alpha', 1);
      angle = floatAttr(body, 'angle', 0);
      // Some mods write camx/camy on the anchor instead of camxoffset/camyoffset.
      camX = floatAttr(body, 'camxoffset', floatAttr(body, 'camx', 0));
      camY = floatAttr(body, 'camyoffset', floatAttr(body, 'camy', 0));
    }

    // Determine the slot character's frame size (imported chars were
    // registered in charMetrics; native chars fall back to the game's
    // animate atlas).
    var hint:String = '';
    var hints:Dynamic = get(stageCharHints, stageId);
    if (hints != null) hint = Std.string(get(hints, key));
    if (hint == null) hint = '';

    var m:Dynamic = hint != '' ? get(charMetrics, hint) : null;
    if (m == null && hint != '')
    {
      m = nativeCharMetrics(hint);
      if (m != null) set(charMetrics, hint, m);
    }
    // Codename anchors are the sprite's TOP-LEFT corner. Both engines draw
    // with the same fork math (drawnTL = x - offset + origin*(1-scale));
    // V-Slice's updateHitbox() compensates offset against origin so a stage
    // character's drawn frame CENTER-x and FEET-y sit exactly at its stage
    // position, independent of scale. Codename characters carry their global
    // offset as a flixel offset (offset.x = rootX * (isPlayer != playerOffsets
    // ? 1 : -1), offset.y = -rootY) and scale about the CENTERED origin, so
    // their drawn center is (x + rootX*flipFactor + frameW/2, ...) and their
    // feet are (..., y + rootY + frameH*(1+S)/2). Align the two:
    //   position = [x + rootX*f + frameW/2, y + rootY + frameH*(1+S)/2]
    var fw:Float = 640;
    var fh:Float = 640;
    var baseScale:Float = 1;
    var rootX:Float = 0;
    var rootY:Float = 0;
    var xmlIsPlayer:Bool = false;
    if (m != null)
    {
      fw = util.getFloat(get(m, 'w'), 640);
      fh = util.getFloat(get(m, 'h'), 640);
      baseScale = util.getFloat(get(m, 's'), 1);
      rootX = util.getFloat(get(m, 'ox'), 0);
      rootY = util.getFloat(get(m, 'oy'), 0);
      xmlIsPlayer = util.getBool(get(m, 'op'), false);
    }
    var finalScale:Float = baseScale * anchorScale;
    // Codename's flixel offset sign: playAnim sets
    //   offset.x = globalOffset.x * (isPlayer != playerOffsets ? 1 : -1)
    // and the fork draws the frame box centered at x - offset.x + frameW/2.
    // With slotIsPlayer == xmlIsPlayer the offset factor is -1, so the box
    // center is x + rootX + frameW/2 (the global offset is a flixel offset:
    // positive pushes the ART left of the anchor); when the runtime role
    // differs from the XML role the factor is +1 and the center is
    // x - rootX + frameW/2. That is exactly x + rootX * flipFactor + frameW/2.
    var slotIsPlayer:Bool = (key == 'bf');
    var flipFactor:Float = (slotIsPlayer == xmlIsPlayer) ? 1 : -1;

    // Optional tuning from the layer config. The conversion reproduces the
    // source engine's rendering exactly, so the default biases are 0; the
    // per-stage overrides (stageBias.<id>.x/.y) exist for mods whose art
    // renders slightly differently in V-Slice.
    var cfg:Dynamic = getLayerConfig();
    var camBiasX:Float = util.getFloat(get(cfg, 'cameraBiasX'), 0);
    var camBiasY:Float = util.getFloat(get(cfg, 'cameraBiasY'), 0);
    var charBiasX:Float = util.getFloat(get(cfg, 'characterBiasX'), 0);
    var charBiasY:Float = util.getFloat(get(cfg, 'characterBiasY'), 0);
    var stageOver:Dynamic = get(cfg, 'stageBias');
    if (stageOver != null)
    {
      var over:Dynamic = get(stageOver, stageId);
      if (over != null)
      {
        if (get(over, 'x') != null) charBiasX = util.getFloat(get(over, 'x'), charBiasX);
        if (get(over, 'y') != null) charBiasY = util.getFloat(get(over, 'y'), charBiasY);
        if (get(over, 'camx') != null) camBiasX = util.getFloat(get(over, 'camx'), camBiasX);
        if (get(over, 'camy') != null) camBiasY = util.getFloat(get(over, 'camy'), camBiasY);
      }
    }
    // Slot-specific character bias (stageBias.<id>.bfY/.dadY/.gfY), for
    // flattening a single character (e.g. a girlfriend whose trimmed sprite
    // art sits above its frame box - GUNLICK's gf floats ~55px over the
    // stage floor). Applied on top of the generic x/y bias.
    if (stageOver != null)
    {
      var over2:Dynamic = get(stageOver, stageId);
      if (over2 != null)
      {
        var slotBiasY:Float = 0;
        if (key == 'bf') slotBiasY = util.getFloat(get(over2, 'bfY'), 0);
        if (key == 'dad') slotBiasY = util.getFloat(get(over2, 'dadY'), 0);
        if (key == 'gf') slotBiasY = util.getFloat(get(over2, 'gfY'), 0);
        charBiasY += slotBiasY;
      }
    }

    // Camera focus: V-Slice focuses at (position + width/2) + cameraOffsets;
    // its width is the DRAWN idle frame x final scale, so the focus base is
    // (P.x, P.y - idleH*finalScale/2). Codename focuses its HITBOX midpoint,
    // which stays on the FIRST sub-texture scaled by the character's own
    // scale (the stage anchor scale only affects the drawn sprite, not the
    // hitbox): midpoint = (x + firstW*baseScale/2, y + firstH*baseScale/2),
    // plus the role fudge, the root global offset and camxoffset. The
    // cameraOffsets are the difference between the two midpoints:
    //   offX = camX + rootX*(1-flipFactor) + fudge + (firstW*baseScale - idleW)/2
    //   offY = camY - 100 + (firstH*baseScale - idleH)/2
    // (for first-frame == idle-frame chars this reduces to the old
    // frame*(baseScale-1)/2 term, so existing mods are unchanged).
    var camFudgeX:Float = slotIsPlayer ? -100 : 150;
    var firstW:Float = fw;
    var firstH:Float = fh;
    if (m != null)
    {
      firstW = util.getFloat(get(m, 'w0'), fw);
      firstH = util.getFloat(get(m, 'h0'), fh);
    }

    set(characters, key, {
      zIndex: zIndex,
      position: [x + rootX * flipFactor + (fw / 2) + charBiasX, y + rootY + (fh * (1 + finalScale) / 2) + charBiasY],
      cameraOffsets: [camX + rootX * (1 - flipFactor) + camFudgeX + (firstW * baseScale - fw) / 2 + camBiasX,
        camY - 100 + (firstH * baseScale - fh) / 2 + camBiasY],
      scale: anchorScale,
      scroll: [scroll, scroll],
      alpha: alpha,
      angle: angle
    });
  }

  // Frame dims for a native (non-imported) character via the game's own
  // animate atlas manifest.
  public function nativeCharMetrics(charId:String):Dynamic
  {
    try
    {
      var manifest:Dynamic = util.readJson('assets/shared/images/characters/$charId/spritemap1.json');
      if (manifest != null)
      {
        var frames:Dynamic = get(manifest, 'frames');
        var keys:Array<String> = ReflectUtil.fields(frames);
        if (keys.length > 0)
        {
          var first:Dynamic = get(frames, keys[0]);
          var src:Dynamic = get(first, 'sourceSize');
          if (src != null)
          {
            return {w: util.getFloat(get(src, 'w'), 640), h: util.getFloat(get(src, 'h'), 640), s: 1, ox: 0, oy: 0, op: false};
          }
        }
      }
    }
    catch (e:Dynamic)
    {
      // fall through
    }
    return null;
  }

  // ------------------------------------------------------------------
  // ScriptedStage generation for Codename
  // ------------------------------------------------------------------

  // Generate a ScriptedStage .hxc for a Codename stage.
  // Bakes in raw anchor data and overrides addCharacter() to position
  // characters using Codename's exact logic at play time.
  public function generateStageScript(variantId:String, stageId:String, xmlText:String, dir:String):String
  {
    // Parse the stage script for portable shader/runtime behaviors to embed.
    var scriptExtra:String = stageScriptRuntime(dir, stageId);
    // Parse character anchor positions from the XML
    var bfBody:String = '';
    var gfBody:String = '';
    var dadBody:String = '';
    var charTagToSlot:Dynamic = {girlfriend: 'gf', boyfriend: 'bf', dad: 'dad'};
    var ordered:Array<Dynamic> = orderedTags(xmlText, ['boyfriend', 'girlfriend', 'dad']);
    for (entry in ordered)
    {
      var tagName:String = Std.string(get(entry, 'name'));
      var slot:Dynamic = get(charTagToSlot, tagName);
      if (slot != null)
      {
        var body:String = Std.string(get(entry, 'body'));
        var slotStr:String = Std.string(slot);
        if (slotStr == 'bf') bfBody = body;
        else if (slotStr == 'gf') gfBody = body;
        else if (slotStr == 'dad') dadBody = body;
      }
    }

    // Defaults (Codename defaults)
    var bfX:Float = floatAttr(bfBody, 'x', 770);
    var bfY:Float = floatAttr(bfBody, 'y', 100);
    var gfX:Float = floatAttr(gfBody, 'x', 400);
    var gfY:Float = floatAttr(gfBody, 'y', 130);
    var dadX:Float = floatAttr(dadBody, 'x', 100);
    var dadY:Float = floatAttr(dadBody, 'y', 100);
    var bfScale:Float = floatAttr(bfBody, 'scale', 1);
    var gfScale:Float = floatAttr(gfBody, 'scale', 1);
    var dadScale:Float = floatAttr(dadBody, 'scale', 1);
    var bfScroll:Float = floatAttr(bfBody, 'scroll', 1);
    var gfScroll:Float = floatAttr(gfBody, 'scroll', 0.95);
    var dadScroll:Float = floatAttr(dadBody, 'scroll', 1);
    var bfCamX:Float = floatAttr(bfBody, 'camxoffset', floatAttr(bfBody, 'camx', 0));
    var bfCamY:Float = floatAttr(bfBody, 'camyoffset', floatAttr(bfBody, 'camy', 0));
    var gfCamX:Float = floatAttr(gfBody, 'camxoffset', floatAttr(gfBody, 'camx', 0));
    var gfCamY:Float = floatAttr(gfBody, 'camyoffset', floatAttr(gfBody, 'camy', 0));
    var dadCamX:Float = floatAttr(dadBody, 'camxoffset', floatAttr(dadBody, 'camx', 0));
    var dadCamY:Float = floatAttr(dadBody, 'camyoffset', floatAttr(dadBody, 'camy', 0));

    // Character metrics from charMetrics (rootX, rootY, frameW, frameH, baseScale, isPlayer)
    var hints:Dynamic = get(stageCharHints, variantId);
    var bfCharId:String = hints != null ? Std.string(get(hints, 'bf')) : '';
    var gfCharId:String = hints != null ? Std.string(get(hints, 'gf')) : '';
    var dadCharId:String = hints != null ? Std.string(get(hints, 'dad')) : '';

    // Extract metrics for each character
    var bfM:Dynamic = bfCharId != '' ? get(charMetrics, bfCharId) : null;
    var gfM:Dynamic = gfCharId != '' ? get(charMetrics, gfCharId) : null;
    var dadM:Dynamic = dadCharId != '' ? get(charMetrics, dadCharId) : null;

    var safeId:String = sanitizeClassName(variantId);
    var className:String = 'Codename_' + safeId + 'Stage';

    var sb:StringBuf = new StringBuf();
    sb.add('// Auto-generated by funky-compat for Codename stage: $variantId\n');
    sb.add('import funkin.play.stage.Stage;\n');
    sb.add('import funkin.play.character.BaseCharacter;\n');
    sb.add('import funkin.play.character.CharacterType;\n');
    // Common imports for replayed stage-script effects (shaders, overlays,
    // tweens). Unused imports are harmless in HScript.
    sb.add('import flixel.FlxG;\n');
    sb.add('import flixel.FlxSprite;\n');
    sb.add('import flixel.util.FlxColor;\n');
    sb.add('import flixel.tweens.FlxTween;\n');
    sb.add('import flixel.tweens.FlxEase;\n');
    sb.add('import flixel.addons.display.FlxRuntimeShader;\n');
    sb.add('import openfl.display.BlendMode;\n');
    sb.add('class ' + className + ' extends Stage\n');
    sb.add('{\n');

    // Raw anchor positions
    sb.add('  var _bfX:Float = ' + bfX + ';\n');
    sb.add('  var _bfY:Float = ' + bfY + ';\n');
    sb.add('  var _gfX:Float = ' + gfX + ';\n');
    sb.add('  var _gfY:Float = ' + gfY + ';\n');
    sb.add('  var _dadX:Float = ' + dadX + ';\n');
    sb.add('  var _dadY:Float = ' + dadY + ';\n');
    sb.add('  var _bfScale:Float = ' + bfScale + ';\n');
    sb.add('  var _gfScale:Float = ' + gfScale + ';\n');
    sb.add('  var _dadScale:Float = ' + dadScale + ';\n');
    sb.add('  var _bfScroll:Float = ' + bfScroll + ';\n');
    sb.add('  var _gfScroll:Float = ' + gfScroll + ';\n');
    sb.add('  var _dadScroll:Float = ' + dadScroll + ';\n');
    sb.add('  var _bfCamX:Float = ' + bfCamX + ';\n');
    sb.add('  var _bfCamY:Float = ' + bfCamY + ';\n');
    sb.add('  var _gfCamX:Float = ' + gfCamX + ';\n');
    sb.add('  var _gfCamY:Float = ' + gfCamY + ';\n');
    sb.add('  var _dadCamX:Float = ' + dadCamX + ';\n');
    sb.add('  var _dadCamY:Float = ' + dadCamY + ';\n');

    // Character metrics (rootX, rootY, frameW, frameH, baseScale, xmlIsPlayer)
    sb.add('  var _bfRootX:Float = ' + util.getFloat(get(bfM, 'ox'), 0) + ';\n');
    sb.add('  var _bfRootY:Float = ' + util.getFloat(get(bfM, 'oy'), 0) + ';\n');
    sb.add('  var _bfW:Float = ' + util.getFloat(get(bfM, 'w'), 640) + ';\n');
    sb.add('  var _bfH:Float = ' + util.getFloat(get(bfM, 'h'), 640) + ';\n');
    sb.add('  var _bfS:Float = ' + util.getFloat(get(bfM, 's'), 1) + ';\n');
    sb.add('  var _bfIsPlayer:Bool = ' + util.getBool(get(bfM, 'op'), false) + ';\n');
    sb.add('  var _gfRootX:Float = ' + util.getFloat(get(gfM, 'ox'), 0) + ';\n');
    sb.add('  var _gfRootY:Float = ' + util.getFloat(get(gfM, 'oy'), 0) + ';\n');
    sb.add('  var _gfW:Float = ' + util.getFloat(get(gfM, 'w'), 640) + ';\n');
    sb.add('  var _gfH:Float = ' + util.getFloat(get(gfM, 'h'), 640) + ';\n');
    sb.add('  var _gfS:Float = ' + util.getFloat(get(gfM, 's'), 1) + ';\n');
    sb.add('  var _gfIsPlayer:Bool = ' + util.getBool(get(gfM, 'op'), false) + ';\n');
    sb.add('  var _dadRootX:Float = ' + util.getFloat(get(dadM, 'ox'), 0) + ';\n');
    sb.add('  var _dadRootY:Float = ' + util.getFloat(get(dadM, 'oy'), 0) + ';\n');
    sb.add('  var _dadW:Float = ' + util.getFloat(get(dadM, 'w'), 640) + ';\n');
    sb.add('  var _dadH:Float = ' + util.getFloat(get(dadM, 'h'), 640) + ';\n');
    sb.add('  var _dadS:Float = ' + util.getFloat(get(dadM, 's'), 1) + ';\n');
    sb.add('  var _dadIsPlayer:Bool = ' + util.getBool(get(dadM, 'op'), false) + ';\n');

    sb.add('\n  public function new()\n');
    sb.add('  {\n');
    sb.add('    super("' + variantId + '");\n');
    sb.add('  }\n');

    sb.add('\n  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void\n');
    sb.add('  {\n');
    sb.add('    super.addCharacter(character, charType);\n');
    sb.add('    switch (charType)\n');
    sb.add('    {\n');

    // BF
    sb.add('      case CharacterType.BF:\n');
    sb.add('        var f:Float = (_bfIsPlayer == true) ? 1 : -1;\n');
    sb.add('        character.x = _bfX + _bfRootX * f + character.width / 2;\n');
    sb.add('        character.y = _bfY + _bfRootY + character.height * (1 + _bfScale * _bfS) / 2;\n');
    sb.add('        character.originalPosition.set(character.x, character.y);\n');
    sb.add('        character.scrollFactor.set(_bfScroll, _bfScroll);\n');
    sb.add('        character.resetCameraFocusPoint();\n');
    sb.add('        var fudgeX:Float = -100;\n');
    sb.add('        character.cameraFocusPoint.x = character.x + _bfCamX + _bfRootX * (1 - f) + fudgeX;\n');
    sb.add('        character.cameraFocusPoint.y = character.y + _bfCamY - 100;\n');

    // DAD
    sb.add('      case CharacterType.DAD:\n');
    sb.add('        var f:Float = (false == _dadIsPlayer) ? 1 : -1;\n');
    sb.add('        character.x = _dadX + _dadRootX * f + character.width / 2;\n');
    sb.add('        character.y = _dadY + _dadRootY + character.height * (1 + _dadScale * _dadS) / 2;\n');
    sb.add('        character.originalPosition.set(character.x, character.y);\n');
    sb.add('        character.scrollFactor.set(_dadScroll, _dadScroll);\n');
    sb.add('        character.resetCameraFocusPoint();\n');
    sb.add('        var fudgeX:Float = 150;\n');
    sb.add('        character.cameraFocusPoint.x = character.x + _dadCamX + _dadRootX * (1 - f) + fudgeX;\n');
    sb.add('        character.cameraFocusPoint.y = character.y + _dadCamY - 100;\n');

    // GF
    sb.add('      case CharacterType.GF:\n');
    sb.add('        var f:Float = (false == _gfIsPlayer) ? 1 : -1;\n');
    sb.add('        character.x = _gfX + _gfRootX * f + character.width / 2;\n');
    sb.add('        character.y = _gfY + _gfRootY + character.height * (1 + _gfScale * _gfS) / 2;\n');
    sb.add('        character.originalPosition.set(character.x, character.y);\n');
    sb.add('        character.scrollFactor.set(_gfScroll, _gfScroll);\n');
    sb.add('        character.resetCameraFocusPoint();\n');
    sb.add('        var fudgeX:Float = -100;\n');
    sb.add('        character.cameraFocusPoint.x = character.x + _gfCamX + _gfRootX * (1 - f) + fudgeX;\n');
    sb.add('        character.cameraFocusPoint.y = character.y + _gfCamY - 100;\n');

    sb.add('    }\n');
    sb.add('  }\n');

    // Script-derived runtime behaviors (shaders, overlays, beat/step logic)
    if (scriptExtra != null && scriptExtra.length > 0)
    {
      sb.add(scriptExtra);
    }

    sb.add('}\n');

    return sb.toString();
  }

// ------------------------------------------------------------------
  // Stage script runtime embedding (portable subset)
  // ------------------------------------------------------------------

  // Parse the stage .hx script for portable runtime behaviors and emit
  // them as HScript methods on the generated ScriptedStage.
  // Supported patterns:
  //   - new CustomShader('name') -> FlxRuntimeShader from the registered .frag
  //   - <sprite>.shader = <shader> on named stage props / characters
  //   - new FlxSprite(x, y) overlays in postCreate (makeGraphic + shader +
  //     blend + scrollFactor) -> added as named props on core layer
  //   - beatHit crowd bobbing (y += dropAmount + FlxTween back)
  //   - beatHit crowd image swaps (loadGraphic with toggle)
  //   - stepHit black-bar/overlay effects on specific steps
  // Everything else is dropped with a warning.
  public function stageScriptRuntime(dir:String, stageId:String):String
  {
    var scriptText:String = stageScriptText(dir, stageId);
    if (scriptText == null || scriptText == '') return '';
    var lines:Array<String> = scriptText.split('\n');

    var sb:StringBuf = new StringBuf();
    var importsNeeded:Array<String> = [];
    var shaderVars:Array<String> = []; // names of shader variables created
    var spriteVars:Array<String> = []; // local FlxSprite variables created in postCreate
    var warnings:Array<String> = [];
    var inPostCreate:Bool = false;
    var inBeatHit:Bool = false;
    var inStepHit:Bool = false;
    var inUpdate:Bool = false;
    var braceDepth:Int = 0;
    var postCreateCode:StringBuf = new StringBuf();
    var beatHitCode:StringBuf = new StringBuf();
    var stepHitCode:StringBuf = new StringBuf();
    var updateCode:StringBuf = new StringBuf();
    var beaten:Bool = false;
    var stepped:Bool = false;
    var updated:Bool = false;

    // First pass: find function bodies we care about (top-level only).
    var funcBodies:Dynamic = {};
    var curFunc:String = '';
    var depthAtFuncStart:Int = 0;
    var bodyStart:Int = 0;
    for (i in 0...lines.length)
    {
      var line:String = StringTools.trim(lines[i]);
      var openCount:Int = countChar(line, '{');
      var closeCount:Int = countChar(line, '}');
      if (line.indexOf('function ') >= 0)
      {
        // Top-level function declaration: ends with '{' (possibly after code)
        var fnName:String = extractFnName(line);
        if (fnName != '')
        {
          curFunc = fnName;
          depthAtFuncStart = braceDepth + openCount - closeCount - 1; // brace depth INSIDE after opening
          bodyStart = i;
          set(funcBodies, fnName, {start: i, depth: depthAtFuncStart, body: '', end: -1});
        }
      }
      braceDepth += openCount - closeCount;
      if (curFunc != '')
      {
        var body:String = Std.string(get(get(funcBodies, curFunc), 'body'));
        body += lines[i];
        body += '\n';
        set(get(funcBodies, curFunc), 'body', body);
        if (braceDepth <= depthAtFuncStart && closeCount > 0 && i > bodyStart)
        {
          set(get(funcBodies, curFunc), 'end', i);
          curFunc = '';
        }
      }
    }

    var bodyOf = function(name:String):String
    {
      var b:Dynamic = get(funcBodies, name);
      if (b == null) return '';
      return Std.string(get(b, 'body'));
    };

    // --- Shaders: collect 'new CustomShader('x')' + the var it's assigned to
    var shaderInfos:Array<Dynamic> = [];
    var spriteInfos:Array<Dynamic> = []; // {var, x, y, chainLines}
    var spriteChains:Dynamic = {}; // varName -> accumulated chain text

    for (lineRaw in lines)
    {
      var line:String = StringTools.trim(lineRaw);
      if (line == '') continue;

      // var X = new CustomShader('name');
      var csIdx:Int = line.indexOf('new CustomShader(');
      if (csIdx >= 0)
      {
        var after:Int = line.indexOf('(', csIdx + 'new CustomShader'.length);
        var close:Int = line.indexOf(')', after);
        if (after >= 0 && close > after)
        {
          var nameArg:String = StringTools.trim(line.substring(after + 1, close));
          nameArg = stripQuotes(nameArg);
          if (nameArg != '')
          {
            // Determine the variable name (var X = ... or .shader = new ...)
            var varName:String = '';
            var assignToProp:String = '';
            var eqIdx:Int = line.indexOf('=');
            var isShaderAssign:Bool = (line.indexOf('.shader') >= 0);
            if (isShaderAssign)
            {
              var dotIdx:Int = line.indexOf('.shader');
              assignToProp = StringTools.trim(line.substring(0, dotIdx));
            }
            else if (eqIdx > 0 && line.indexOf('var ') >= 0)
            {
              var vStart:Int = line.indexOf('var ') + 4;
              varName = StringTools.trim(line.substring(vStart, eqIdx));
              // strip type annotation
              var colon:Int = varName.indexOf(':');
              if (colon > 0) varName = StringTools.trim(varName.substring(0, colon));
            }
            shaderInfos.push({name: nameArg, var: varName, prop: assignToProp});
            if (varName != '' && shaderVars.indexOf(varName) < 0) shaderVars.push(varName);
          }
        }
      }

      // Shader uniform assignments: <shaderVar>.<uniform> = <number>;
      for (sv in shaderVars)
      {
        var pat:String = sv + '.';
        var pIdx:Int = line.indexOf(pat);
        if (pIdx >= 0 && line.indexOf('=') > pIdx)
        {
          var uname:String = StringTools.trim(line.substring(pIdx + pat.length));
          var eq2:Int = uname.indexOf('=');
          if (eq2 > 0)
          {
            uname = StringTools.trim(uname.substring(0, eq2));
            var val:Float = Std.parseFloat(StringTools.trim(line.substring(pIdx + pat.length + eq2 + 1)));
            // only static numeric assignments bake in; skip time-based
            if (!Math.isNaN(val))
            {
              shaderInfos.push({name: '', var: sv, uniform: uname, value: val, prop: ''});
            }
          }
        }
      }

      // new FlxSprite(..) overlays in postCreate / create
      var flxIdx:Int = line.indexOf('new FlxSprite(');
      if (flxIdx >= 0 && (line.indexOf('postCreate') >= 0 || inPostCreate || line.indexOf('function create') >= 0))
      {
        var after2:Int = line.indexOf('(', flxIdx + 'new FlxSprite'.length);
        var close2:Int = line.indexOf(')', after2);
        if (after2 >= 0 && close2 > after2)
        {
          var args:String = line.substring(after2 + 1, close2);
          var vName:String = '';
          var eqIdx2:Int = line.indexOf('=');
          if (line.indexOf('var ') >= 0)
          {
            var vStart2:Int = line.indexOf('var ') + 4;
            vName = StringTools.trim(line.substring(vStart2, eqIdx2));
            var colon2:Int = vName.indexOf(':');
            if (colon2 > 0) vName = StringTools.trim(vName.substring(0, colon2));
          }
          if (vName != '')
          {
            spriteInfos.push({var: vName, args: args, x: 0, y: 0});
            spriteVars.push(vName);
          }
        }
      }
    }

    // --- Generate shader creation code (in onCreate) ---
    var shaderCreated:Array<String> = [];
    var extraOnCreate:StringBuf = new StringBuf();
    var uniqueShaders:Array<String> = [];
    for (si in 0...shaderInfos.length)
    {
      var info:Dynamic = shaderInfos[si];
      var sname:String = Std.string(get(info, 'name'));
      var svar:String = Std.string(get(info, 'var'));
      var sprop:String = Std.string(get(info, 'prop'));
      var runiform:String = Std.string(get(info, 'uniform'));
      if (sname != '')
      {
        if (uniqueShaders.indexOf(sname) < 0)
        {
          uniqueShaders.push(sname);
          var safeShaderVar:String = 'shader_' + sanitizeClassName(sname);
          if (svar != '')
          {
            // Keep the original variable name so later assignments match
            safeShaderVar = svar;
          }
          extraOnCreate.add('    var ' + safeShaderVar + ' = new flixel.addons.display.FlxRuntimeShader(funkin.Assets.getText(funkin.Paths.frag("' + sname + '")));\n');
          if (importsNeeded.indexOf('flixel.addons.display.FlxRuntimeShader') < 0) importsNeeded.push('flixel.addons.display.FlxRuntimeShader');
          shaderCreated.push(svar != '' ? svar : safeShaderVar);
        }

        // Apply to a stage prop or character
        if (sprop != '')
        {
          var target:String = mapStageRef(sprop, stageId);
          // The shader variable is on the right side: .shader = X or .shader = new CustomShader(...)
          var rhs:String = svar != '' ? svar : ('shader_' + sanitizeClassName(sname));
          extraOnCreate.add('    var propRef = ' + target + ';\n');
          extraOnCreate.add('    if (propRef != null) propRef.shader = ' + rhs + ';\n');
        }
      }
      else if (runiform != '' && svar != '')
      {
        extraOnCreate.add('    ' + svar + '.setFloat("' + runiform + '", ' + Std.string(get(info, 'value')) + ');\n');
      }
    }

    // --- Overlay sprites from postCreate (fog, blend overlays) ---
    var postBody:String = bodyOf('postCreate');
    if (postBody == '') postBody = bodyOf('create');
    if (postBody != '')
    {
      // Simple approach: replay makeGraphic/shader/blend/scrollFactor/add lines
      // in order, translating stage refs.
      var plines:Array<String> = postBody.split('\n');
      var localVars:Array<String> = [];
      // Skip non-portable guarded blocks wholesale (e.g. GUNLICK's
      // 'if (use3D)' 3D mode: its body references identifiers and APIs that
      // do not exist in the generated class, and emitting them raw would
      // throw at onCreate runtime and abort every effect queued AFTER the
      // block - fog overlays, blend modes, etc. The block's visuals are
      // opt-in in the original mod too (use3D defaults false).
      var skipUntilDepth:Int = -1;
      var replayDepth:Int = 0;
      for (pl in plines)
      {
        var p:String = StringTools.trim(pl);
        if (p == '' || p.indexOf('function ') >= 0) continue;
        if (p == '{' || p == '}') continue;
        var oc:Int = countChar(p, '{');
        var cc:Int = countChar(p, '}');
        // Inside a skipped block: track depth until it closes.
        if (skipUntilDepth >= 0)
        {
          replayDepth += oc - cc;
          if (replayDepth <= skipUntilDepth) skipUntilDepth = -1;
          continue;
        }
        // Guard-block start: skip the whole block.
        if ((p.indexOf('if (use3D') == 0 || p.indexOf('if(use3D') == 0))
        {
          if (oc == 0 && cc == 0) continue; // braceless single-line guard
          replayDepth += oc - cc;
          skipUntilDepth = replayDepth - 1;
          continue;
        }
        replayDepth += oc - cc;
        if (p.indexOf('var ') >= 0 && p.indexOf('= new FlxSprite') >= 0)
        {
          // var X = new FlxSprite(x, y); -> create sprite
          var vStart:Int = p.indexOf('var ') + 4;
          var eqIdx:Int = p.indexOf('=');
          var vName:String = StringTools.trim(p.substring(vStart, eqIdx));
          var colon:Int = vName.indexOf(':');
          if (colon > 0) vName = StringTools.trim(vName.substring(0, colon));
          localVars.push(vName);
          extraOnCreate.add('    var ' + vName + ' = new flixel.FlxSprite();\n');
        }
        else if (p.indexOf('.makeGraphic(') >= 0 || p.indexOf('.loadGraphic(') >= 0)
        {
          // translate Paths.image('...') -> funkin.Paths.image('...')
          var translated:String = translatePaths(p);
          extraOnCreate.add('    ' + translated + '\n');
        }
        else if (p.indexOf('.shader = ') >= 0 || p.indexOf('.blend = ') >= 0 || p.indexOf('.scrollFactor.set(') >= 0
          || p.indexOf('.scale.set(') >= 0 || p.indexOf('.angle = ') >= 0 || p.indexOf('.alpha = ') >= 0
          || p.indexOf('.cameras = ') >= 0 || p.indexOf('.screenCenter') >= 0)
        {
          // Chained assignments ('a.x = b.x = v') are not valid HScript and
          // bare character identifiers don't exist in the generated class.
          // Only replay single assignments whose target is a known local var
          // or a mappable stage/character ref; drop anything else.
          var eqCount:Int = 0;
          for (ci in 0...p.length)
          {
            if (p.charAt(ci) == '=')
            {
              if (ci + 1 < p.length && p.charAt(ci + 1) == '=') ci++; // skip ==
              else if (ci > 0 && (p.charAt(ci - 1) == '!' || p.charAt(ci - 1) == '<' || p.charAt(ci - 1) == '>' || p.charAt(ci - 1) == '+' || p.charAt(ci - 1) == '-')) {}
              else eqCount++;
            }
          }
          var firstEq:Int = p.indexOf('=');
          var lhs:String = StringTools.trim(p.substring(0, firstEq));
          var mapped:String = mapStageRef(lhs, stageId);
          var isKnown:Bool = false;
          for (lv in localVars)
          {
            if (lv == lhs) isKnown = true;
          }
          for (sv2 in shaderVars)
          {
            if (sv2 == lhs) isKnown = true;
          }
          if (eqCount <= 1 && (isKnown || mapped != lhs))
          {
            extraOnCreate.add('    ' + mapped + StringTools.trim(p.substring(firstEq)) + '\n');
          }
        }
        else if (p.indexOf('add(') >= 0 && p.indexOf('stage.add') < 0)
        {
          // add(X) -> set zIndex above characters, then this.add(X)
          var addArg:String = p.substring(p.indexOf('(') + 1, p.indexOf(')'));
          extraOnCreate.add('    if (' + addArg + ' != null)
');
          extraOnCreate.add('    {
');
          extraOnCreate.add('      ' + addArg + '.zIndex = 5000;
');
          extraOnCreate.add('      this.add(' + addArg + ');
');
          extraOnCreate.add('    }
');
        }
        else if (p.indexOf('insert(') >= 0)
        {
          extraOnCreate.add('    ' + translatePaths(p) + '\n');
        }
        else if (p.indexOf('FlxTween') >= 0 || p.indexOf('FlxEase') >= 0)
        {
          if (importsNeeded.indexOf('flixel.tweens.FlxTween') < 0) importsNeeded.push('flixel.tweens.FlxTween');
          extraOnCreate.add('    ' + translatePaths(p) + '\n');
        }
        else if (p.indexOf('return') >= 0 || p.indexOf('super.') >= 0 || p.indexOf('if (use3D') >= 0 || p.indexOf('apply3D') >= 0)
        {
          // skip non-portable
        }
        else if (p.indexOf('}') == 0)
        {
          // skip
        }
      }
      // Note: we never call super.onCreate here because buildStage already
      // ran for the JSON props; overlays are added after.
    }

    // --- beatHit ---
    var beatBody:String = bodyOf('beatHit');
    if (beatBody != '')
    {
      var blines:Array<String> = beatBody.split('\n');
      var crowdDrop:Float = 0;
      var durationUp:Float = 0.3;
      for (bl in blines)
      {
        var b:String = StringTools.trim(bl);
        if (b.indexOf('dropAmount') >= 0 && b.indexOf('=') >= 0)
        {
          var dv:Float = Std.parseFloat(StringTools.trim(b.substring(b.indexOf('=') + 1)));
          if (!Math.isNaN(dv)) crowdDrop = dv;
        }
        if (b.indexOf('durationUp') >= 0 && b.indexOf('=') >= 0)
        {
          var dv2:Float = Std.parseFloat(StringTools.trim(b.substring(b.indexOf('=') + 1)));
          if (!Math.isNaN(dv2)) durationUp = dv2;
        }
      }
      // Generic crowd bob: for i in 1..5, crowd{i}.y += drop, tween back
      if (crowdDrop != 0)
      {
        beatHitCode.add('    for (i in 1...5)\n');
        beatHitCode.add('    {\n');
        beatHitCode.add('      var c = getNamedProp("crowd" + i);\n');
        beatHitCode.add('      if (c != null)\n');
        beatHitCode.add('      {\n');
        beatHitCode.add('        c.y += ' + Std.string(crowdDrop) + ';\n');
        beatHitCode.add('        flixel.tweens.FlxTween.tween(c, {y: c.y - ' + Std.string(crowdDrop) + '}, ' + Std.string(durationUp) + ', {ease: flixel.util.FlxEase.circOut});\n');
        beatHitCode.add('      }\n');
        beatHitCode.add('    }\n');
        if (importsNeeded.indexOf('flixel.tweens.FlxTween') < 0) importsNeeded.push('flixel.tweens.FlxTween');
        if (importsNeeded.indexOf('flixel.util.FlxEase') < 0) importsNeeded.push('flixel.util.FlxEase');
        beaten = true;
      }
      // Image swaps: <sprite>.loadGraphic(Paths.image(cond ? a : b)) with toggle
      // -> getNamedProp('<name>').loadGraphic(funkin.Paths.image(...)) alternating
      var loadIdx:Int = beatBody.indexOf('loadGraphic(Paths.image(');
      if (loadIdx >= 0)
      {
        // Extract sprite name on that line
        for (bl in blines)
        {
          var b2:String = StringTools.trim(bl);
          var lIdx:Int = b2.indexOf('.loadGraphic(Paths.image(');
          if (lIdx >= 0)
          {
            var sprName:String = StringTools.trim(b2.substring(0, lIdx));
            // find the two string literals
            var q1:Int = b2.indexOf('"', lIdx);
            var q2:Int = b2.indexOf('"', q1 + 1);
            var q3:Int = b2.indexOf('"', q2 + 1);
            var q4:Int = b2.indexOf('"', q3 + 1);
            if (q1 > 0 && q2 > q1 && q3 > q2 && q4 > q3)
            {
              var imgA:String = b2.substring(q1 + 1, q2);
              var imgB:String = b2.substring(q3 + 1, q4);
              var toggleVar:String = 'fc_toggle_' + sanitizeClassName(sprName);
              beatHitCode.add('    var tgl = !' + toggleVar + ';\n');
              beatHitCode.add('    ' + toggleVar + ' = tgl;\n');
              beatHitCode.add('    var p = getNamedProp("' + sprName + '");\n');
              beatHitCode.add('    if (p != null) p.loadGraphic(funkin.Paths.image(tgl ? "' + imgA + '" : "' + imgB + '"));\n');
              // Declare toggle at class scope
              sb.add('  var ' + toggleVar + ':Bool = false;\n');
            }
          }
        }
        beaten = true;
      }
    }
    if (beaten && beatHitCode.length > 0)
    {
      sb.add('  function onBeatHit(event):Void\n');
      sb.add('  {\n');
      sb.add('    super.onBeatHit(event);\n');
      sb.add(beatHitCode.toString());
      sb.add('  }\n');
    }

    // --- stepHit: black bars / overlays on specific steps ---
    var stepBody:String = bodyOf('stepHit');
    if (stepBody != '')
    {
      var slines:Array<String> = stepBody.split('\n');
      var songGuard:String = '';
      // Detect an outer `if (curSong == "x")` guard so step effects only
      // fire for that song (GUNLICK-style).
      var songGuardIdx:Int = stepBody.indexOf('curSong');
      if (songGuardIdx >= 0)
      {
        var qStart:Int = stepBody.indexOf('"', songGuardIdx);
        if (qStart >= 0)
        {
          var qEnd:Int = stepBody.indexOf('"', qStart + 1);
          if (qEnd > qStart)
          {
            songGuard = stepBody.substring(qStart + 1, qEnd);
          }
        }
      }
      for (sl in slines)
      {
        var s:String = StringTools.trim(sl);
        if (s.indexOf('curStep') >= 0 && s.indexOf('==') >= 0)
        {
          var stepVal:Float = Std.parseFloat(StringTools.trim(s.substring(s.indexOf('==') + 2)));
          if (!Math.isNaN(stepVal))
          {
            stepHitCode.add('    if ' + (songGuard != '' ? '(funkin.play.PlayState.instance.currentSong?.id == "' + songGuard + '") && ' : '') + '(event.curStep == ' + Std.int(stepVal) + ')\n');
            stepHitCode.add('    {\n');
            // capture following simple statements until closing brace
            var capture:Int = slines.indexOf(sl) + 1;
            while (capture < slines.length)
            {
              var nextLine:String = StringTools.trim(slines[capture]);
              if (nextLine == '}') break;
              if (nextLine == '' || nextLine.indexOf('function ') >= 0)
              {
                capture++;
                continue;
              }
              if (nextLine.indexOf('.makeGraphic(') >= 0 || nextLine.indexOf('.scrollFactor') >= 0
                || nextLine.indexOf('.screenCenter') >= 0 || nextLine.indexOf('.alpha') >= 0
                || nextLine.indexOf('new FlxSprite') >= 0 || nextLine.indexOf('.loadGraphic') >= 0
                || nextLine.indexOf('insert(') >= 0 || nextLine.indexOf('add(') >= 0
                || nextLine.indexOf('remove(') >= 0 || nextLine.indexOf('FlxTween') >= 0
                || nextLine.indexOf('visible =') >= 0 || nextLine.indexOf('.shader =') >= 0)
              {
                stepHitCode.add('      ' + translatePaths(nextLine) + '\n');
              }
              capture++;
            }
            stepHitCode.add('    }\n');
            stepped = true;
          }
        }
      }
    }
    if (stepped && stepHitCode.length > 0)
    {
      sb.add('  function onStepHit(event):Void\n');
      sb.add('  {\n');
      sb.add('    super.onStepHit(event);\n');
      sb.add(stepHitCode.toString());
      sb.add('  }\n');
    }

    // --- update: shader time uniforms ---
    var updBody:String = bodyOf('update');
    if (updBody != '')
    {
      var ulines:Array<String> = updBody.split('\n');
      for (ul in ulines)
      {
        var u:String = StringTools.trim(ul);
        if (u.indexOf('.iTime = ') >= 0 || u.indexOf('iTime') >= 0)
        {
          var dotIdx:Int = u.indexOf('.iTime');
          if (dotIdx > 0)
          {
            var shVar:String = StringTools.trim(u.substring(0, dotIdx));
            updateCode.add('    if (' + shVar + ' != null) ' + shVar + '.setFloat("iTime", iTimeAccum);\n');
            if (updateCode.length > 0) updated = true;
          }
        }
      }
    }
    if (updated)
    {
      sb.add('  var iTimeAccum:Float = 0;\n');
      sb.add('  function onUpdate(event):Void\n');
      sb.add('  {\n');
      sb.add('    super.onUpdate(event);\n');
      sb.add('    iTimeAccum += event.elapsed;\n');
      sb.add(updateCode.toString());
      sb.add('  }\n');
    }

    // --- Assemble onCreate (shaders + overlays) ---
    if (extraOnCreate.length > 0)
    {
      sb.add('  function onCreate(event):Void\n');
      sb.add('  {\n');
      sb.add('    super.onCreate(event);\n');
      sb.add(extraOnCreate.toString());
      sb.add('    this.refresh();\n');
      sb.add('  }\n');
    }

    // Warning for unhandled CustomShader references
    if (uniqueShaders.length == 0 && shaderVars.length > 0)
    {
      util.warn('Codename: stage "$stageId" script uses shaders not embedded (' + shaderVars.join(', ') + ')');
    }

    if (warnings.length > 0)
    {
      var w:Array<String> = [];
      for (warn in warnings) w.push(warn);
      util.warn('Codename: stage "$stageId" script: ' + w.join('; '));
    }

    var result:String = sb.toString();
    return result;
  }

  // Count occurrences of a char in a string.
  function countChar(s:String, c:String):Int
  {
    var n:Int = 0;
    var idx:Int = 0;
    while (true)
    {
      idx = s.indexOf(c, idx);
      if (idx < 0) break;
      n++;
      idx += c.length;
    }
    return n;
  }

  // Extract function name from a Haxe function declaration line.
  function extractFnName(line:String):String
  {
    var fnIdx:Int = line.indexOf('function ');
    if (fnIdx < 0) return '';
    var rest:String = line.substring(fnIdx + 'function '.length);
    var name:String = '';
    for (i in 0...rest.length)
    {
      var ch:String = rest.charAt(i);
      if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_')
      {
        name += ch;
      }
      else break;
    }
    return name;
  }

  // Strip single/double quotes from a string literal.
  function stripQuotes(s:String):String
  {
    if (s.length >= 2 && (s.charAt(0) == '"' || s.charAt(0) == "'"))
    {
      return s.substring(1, s.length - 1);
    }
    return s;
  }

  // Translate Codename stage references to V-Slice equivalents.
  function mapStageRef(ref:String, stageId:String):String
  {
    ref = StringTools.trim(ref);
    // stage.stageSprites["name"] / stage.stageSprites[name]
    if (ref.indexOf('stage.stageSprites') >= 0)
    {
      var br1:Int = ref.indexOf('[');
      var br2:Int = ref.indexOf(']');
      if (br1 >= 0 && br2 > br1)
      {
        var key:String = StringTools.trim(ref.substring(br1 + 1, br2));
        key = stripQuotes(key);
        return 'getNamedProp("' + key + '")';
      }
    }
    switch (ref)
    {
      case 'boyfriend' | 'bf' | 'player':
        return 'getBoyfriend()';
      case 'dad' | 'opponent':
        return 'getDad()';
      case 'gf' | 'girlfriend':
        return 'getGirlfriend()';
      case 'bg':
        return 'getNamedProp("bg")';
    }
    return ref;
  }

  // Translate Paths.image('...') to funkin.Paths.image('...') and similar.
  function translatePaths(s:String):String
  {
    var result:String = StringTools.replace(s, 'Paths.image(', 'funkin.Paths.image(');
    result = StringTools.replace(result, 'Paths.script(', 'funkin.Paths.script(');
    // stage.stageSprites["x"] -> getNamedProp("x")
    if (result.indexOf('stage.stageSprites') >= 0)
    {
      var br1:Int = result.indexOf('[');
      var br2:Int = result.indexOf(']');
      if (br1 >= 0 && br2 > br1)
      {
        var key:String = StringTools.trim(result.substring(br1 + 1, br2));
        key = stripQuotes(key);
        result = StringTools.replace(result, result.substring(Math.max(0, result.indexOf('stage.stageSprites')), br2 + 1), 'getNamedProp("' + key + '")');
      }
    }
    result = StringTools.replace(result, 'state.members.indexOf', 'this.members.indexOf');
    return result;
  }

  // Build the runtime config object consumed by FunkyCompatDynStage:
  // raw XML anchors per slot plus portable FX extracted from the stage's
  // .hx script (shaders, overlays, beat bounces). Everything in memory.
  public function buildDynCfg(dir:String, stageId:String, baseId:String, xmlText:String):Dynamic
  {
    var fx:Dynamic = extractDynFX(dir, stageId, baseId);
    var charTagToSlot:Dynamic = {girlfriend: 'gf', boyfriend: 'bf', dad: 'dad'};
    var bodies:Dynamic = {};
    var ordered:Array<Dynamic> = orderedTags(xmlText, ['boyfriend', 'girlfriend', 'dad']);
    for (entry in ordered)
    {
      var tagName:String = Std.string(get(entry, 'name'));
      var slot:Dynamic = get(charTagToSlot, tagName);
      if (slot != null)
      {
        var body:String = Std.string(get(entry, 'body'));
        set(bodies, Std.string(slot), body);
      }
    }

    var hints:Dynamic = get(stageCharHints, stageId);
    var cfg:Dynamic = {};
    var slots:Array<String> = ['bf', 'dad', 'gf'];
    for (si in 0...slots.length)
    {
      var key:String = slots[si];
      var body:String = Std.string(get(bodies, key));
      if (body == 'null') body = '';
      var defX:Float = key == 'bf' ? 770 : (key == 'dad' ? 100 : 400);
      var defY:Float = key == 'bf' ? 100 : (key == 'dad' ? 100 : 130);
      var defScroll:Float = key == 'gf' ? 0.95 : 1;
      var x:Float = floatAttr(body, 'x', defX);
      var y:Float = floatAttr(body, 'y', defY);
      var sxRaw:String = attr(body, 'scalex');
      var scale:Float = 1;
      if (sxRaw != null && sxRaw != '')
      {
        scale = Std.parseFloat(sxRaw);
        if (scale == null) scale = 1;
      }
      else
      {
        scale = floatAttr(body, 'scale', 1);
      }
      var scroll:Float = floatAttr(body, 'scroll', defScroll);
      var camX:Float = floatAttr(body, 'camxoffset', floatAttr(body, 'camx', 0));
      var camY:Float = floatAttr(body, 'camyoffset', floatAttr(body, 'camy', 0));

      var hint:String = '';
      if (hints != null) hint = Std.string(get(hints, key));
      if (hint == null) hint = '';
      var m:Dynamic = hint != '' ? get(charMetrics, hint) : null;
      if (m == null && hint != '')
      {
        m = nativeCharMetrics(hint);
        if (m != null) set(charMetrics, hint, m);
      }
      var fudge:Float = key == 'dad' ? 150 : -100;

      var slotCfg:Dynamic = {
        x: x,
        y: y,
        scale: scale,
        scroll: scroll,
        camX: camX,
        camY: camY,
        rootX: m != null ? util.getFloat(get(m, 'ox'), 0) : 0,
        rootY: m != null ? util.getFloat(get(m, 'oy'), 0) : 0,
        s: m != null ? util.getFloat(get(m, 's'), 1) : 1,
        op: m != null && util.getBool(get(m, 'op'), false),
        fudge: fudge,
        shader: get(fx.charShader, key)
      };
      set(cfg, key, slotCfg);
    }
    set(cfg, 'overlays', fx.overlays);
    set(cfg, 'scrolls', fx.scrolls);
    set(cfg, 'stepFx', fx.stepFx);
    set(cfg, 'hideProps', fx.hideProps);
    set(cfg, 'callEvents', get(stageCallEvents, stageId));
    set(cfg, 'callActions', fx.callActions);
    set(cfg, 'scriptSprites', fx.scriptSprites);
    set(cfg, 'beatModes', fx.beatModes);
    set(cfg, 'dynamicProps', fx.dynamicProps);
    set(cfg, 'stageAssetRoot', 'stages/$stageId');
    // Mark stages that reference a 3D model — 3D rendering is not
    // supported, so the pre-rendered background image will be used instead.
    var modelName:String = Std.string(get(fx, 'model'));
    if (modelName != '')
    {
      set(cfg, 'is3D', true);
      trace('[FUNKY-COMPAT] stage "$stageId" uses a 3D model ("$modelName") - using pre-rendered background');
    }
    if (fx.beatBounce != null) set(cfg, 'beatBounce', fx.beatBounce);
    return cfg;
  }

  // Extract portable runtime FX from a Codename stage script into a
  // structured object: {charShader:{bf,dad,gf}, overlays:[], beatBounce}.
  public function extractDynFX(dir:String, stageId:String, baseId:String):Dynamic
  {
    var fx:Dynamic = {charShader: {}, overlays: [], beatBounce: null, scrolls: [], hideProps: [], model: '', stepFx: [], callActions: {}, beatModes: [], dynamicProps: []};
    var scriptText:String = stageScriptText(dir, stageId);
    if ((scriptText == null || scriptText == '') && baseId != null && baseId != '' && baseId != stageId)
    {
      // Namespaced id (cross-mod collision): the companion .hx keeps the
      // ORIGINAL base name (stage.xml + stage.hx).
      scriptText = stageScriptText(dir, baseId);
    }
    if (scriptText == null || scriptText == '') return fx;
    var lines:Array<String> = scriptText.split('\n');

    // Codename stage scripts often implement a perspective floor in
    // postUpdate by assigning prop.skew.x and prop.scale.y from camera scroll,
    // prop.getMidpoint(), and prop.width/height. Preserve that behavior as a
    // generic descriptor; the runtime evaluates the known camera transform
    // without depending on the prop's or mod's name.
    var perspectiveTargets:Dynamic = {};
    for (rawDynamic in lines)
    {
      var dynamicLine:String = StringTools.trim(rawDynamic);
      var dynamicDot:Int = dynamicLine.indexOf('.skew.x =');
      if (dynamicDot < 1) dynamicDot = dynamicLine.indexOf('.scale.y =');
      if (dynamicDot < 1) continue;
      if (dynamicLine.indexOf('FlxG.camera.scroll') < 0 || dynamicLine.indexOf('getMidpoint') < 0) continue;
      var dynamicTarget:String = StringTools.trim(dynamicLine.substring(0, dynamicDot));
      if (dynamicTarget != '') set(perspectiveTargets, dynamicTarget, true);
    }
    for (dynamicTargetName in ReflectUtil.fields(perspectiveTargets))
      get(fx, 'dynamicProps').push({target: dynamicTargetName, cameraPerspective: true});

    var extractedStepFx:Array<Dynamic> = [];
    var inStepHit:Bool = false;
    var stepDepth:Int = 0;
    var currentStepFx:Dynamic = null;
    for (stepLineRaw in lines)
    {
      var stepLine:String = StringTools.trim(stepLineRaw);
      if (stepLine.indexOf('function stepHit') == 0)
      {
        inStepHit = true;
        stepDepth = countChar(stepLine, '{') - countChar(stepLine, '}');
        if (stepDepth <= 0) stepDepth = 1;
        continue;
      }
      if (!inStepHit) continue;
      var stepIf:Int = stepLine.indexOf('curStep ==');
      if (stepIf >= 0)
      {
        var stepText:String = StringTools.trim(stepLine.substring(stepIf + 10));
        var stepEnd:Int = 0;
        while (stepEnd < stepText.length && stepText.charCodeAt(stepEnd) >= 48 && stepText.charCodeAt(stepEnd) <= 57) stepEnd++;
        var parsedStep:Null<Int> = Std.parseInt(stepText.substring(0, stepEnd));
        if (parsedStep != null)
        {
          currentStepFx = {step: parsedStep, kind: '', images: []};
          extractedStepFx.push(currentStepFx);
        }
      }
      if (currentStepFx != null)
      {
        if (stepLine.indexOf('makeGraphic(') >= 0 && stepLine.indexOf('FlxColor.BLACK') >= 0)
        {
          if (get(currentStepFx, 'kind') == '') set(currentStepFx, 'kind', 'flash');
        }
        if (stepLine.indexOf('loadGraphic(Paths.image(') >= 0)
        {
          var iq:Int = stepLine.indexOf("'");
          var iquote:String = "'";
          var iq2:Int = stepLine.indexOf('"');
          if (iq2 >= 0 && (iq < 0 || iq2 < iq)) { iq = iq2; iquote = '"'; }
          var ie:Int = iq < 0 ? -1 : stepLine.indexOf(iquote, iq + 1);
          if (ie > iq)
          {
            var imagePath:String = stepLine.substring(iq + 1, ie);
            if (StringTools.startsWith(imagePath, 'stages/$baseId')) imagePath = 'stages/$stageId' + imagePath.substring(('stages/$baseId').length);
            get(currentStepFx, 'images').push(imagePath);
            set(currentStepFx, 'kind', 'cinematic');
          }
        }
        if (stepLine.indexOf('defaultCamZoom') >= 0)
        {
          set(currentStepFx, 'kind', 'zoom');
          var zoomEq:Int = stepLine.indexOf('=');
          if (zoomEq >= 0) set(currentStepFx, 'zoom', Std.parseFloat(StringTools.trim(stepLine.substring(zoomEq + 1))));
        }
        if (stepLine.indexOf('FlxTween.tween(') >= 0) set(currentStepFx, 'kind', 'fade');
        if (stepLine.indexOf('makeGraphic(') >= 0 && get(currentStepFx, 'kind') == '') set(currentStepFx, 'kind', 'cinematic');
      }
      stepDepth += countChar(stepLine, '{') - countChar(stepLine, '}');
      if (stepDepth <= 0) { inStepHit = false; currentStepFx = null; }
    }
    set(fx, 'stepFx', extractedStepFx);

    var callActions:Dynamic = get(fx, 'callActions');
    var activeFunction:String = '';
    var functionDepth:Int = 0;

    // Extract simple, safe function actions. Arbitrary Codename HScript is
    // not executable in V-Slice, but direct sprite property/animation calls
    // are portable and can be replayed from chart HScript Call events.
    for (rawActionLine in lines)
    {
      var actionLine:String = StringTools.trim(rawActionLine);
      if (actionLine.indexOf('function ') == 0)
      {
        var fnStart:Int = 9;
        var fnOpen:Int = actionLine.indexOf('(', fnStart);
        if (fnOpen > fnStart) activeFunction = StringTools.trim(actionLine.substring(fnStart, fnOpen));
        functionDepth = countChar(actionLine, '{') - countChar(actionLine, '}');
        continue;
      }
      if (activeFunction == '') continue;
      functionDepth += countChar(actionLine, '{') - countChar(actionLine, '}');
      if (actionLine.indexOf('.visible') >= 0 && actionLine.indexOf('=') >= 0)
      {
        var visEq:Int = actionLine.indexOf('=');
        var visDot:Int = actionLine.indexOf('.visible');
        var visTarget:String = StringTools.trim(actionLine.substring(0, visDot));
        var visValue:String = StringTools.trim(actionLine.substring(visEq + 1));
        if (visValue.charAt(visValue.length - 1) == ';') visValue = StringTools.trim(visValue.substring(0, visValue.length - 1));
        if (visTarget != '' && (visValue == 'true' || visValue == 'false'))
        {
          var visActions:Array<Dynamic> = get(callActions, activeFunction);
          if (visActions == null) visActions = [];
          visActions.push({op: 'visible', target: visTarget, value: visValue == 'true'});
          set(callActions, activeFunction, visActions);
        }
      }
      var playIdx:Int = actionLine.indexOf('.animation.play(');
      if (playIdx >= 0)
      {
        var playOpen:Int = actionLine.indexOf('(', playIdx);
        var playClose:Int = actionLine.indexOf(',', playOpen);
        if (playClose < 0) playClose = actionLine.indexOf(')', playOpen);
        if (playOpen >= 0 && playClose > playOpen)
        {
          var playTarget:String = StringTools.trim(actionLine.substring(0, playIdx));
          var animName:String = stripQuotes(StringTools.trim(actionLine.substring(playOpen + 1, playClose)));
          if (playTarget != '' && animName != '')
          {
            var playActions:Array<Dynamic> = get(callActions, activeFunction);
            if (playActions == null) playActions = [];
            playActions.push({op: 'playAnim', target: playTarget, value: animName});
            set(callActions, activeFunction, playActions);
          }
        }
      }
      if (functionDepth <= 0) activeFunction = '';
    }

    // Generic script-created sprites. This captures the common Codename
    // pattern used for background actors without naming a mod, stage, or
    // atlas in the compatibility runtime.
    var scriptSprites:Array<Dynamic> = [];
    var loopCount:Int = 1;
    var loopStepX:Float = 0;
    var loopStepY:Float = 0;
    for (spriteRaw in lines)
    {
      var spriteLine:String = StringTools.trim(spriteRaw);
      if (spriteLine.indexOf('for (') == 0 && spriteLine.indexOf('...') >= 0)
      {
        var dots:Int = spriteLine.indexOf('...');
        var end:Int = dots + 3;
        while (end < spriteLine.length && spriteLine.charCodeAt(end) >= 48 && spriteLine.charCodeAt(end) <= 57) end++;
        var parsedCount:Null<Int> = Std.parseInt(spriteLine.substring(dots + 3, end));
        if (parsedCount != null) loopCount = parsedCount;
      }
      var newIdx:Int = spriteLine.indexOf('new FlxSprite(');
      if (newIdx >= 0)
      {
        var eq:Int = spriteLine.indexOf('=');
        if (eq < 0) continue;
        var varName:String = '';
        var varIdx:Int = spriteLine.indexOf('var ');
        if (varIdx >= 0 && varIdx < eq)
          varName = StringTools.trim(spriteLine.substring(varIdx + 4, eq));
        else
          varName = StringTools.trim(spriteLine.substring(0, eq));
        var colon:Int = varName.indexOf(':');
        if (colon > 0) varName = StringTools.trim(varName.substring(0, colon));
        if (varName == '' || varName == 'if') continue;
        var open:Int = spriteLine.indexOf('(', newIdx);
        // Position arguments may contain nested parentheses, e.g.
        // `-100 + (i * 180)`. Use the call's final close paren.
        var close:Int = spriteLine.lastIndexOf(')');

        var xVal:Float = 0;
        var yVal:Float = 0;
        var stepX:Float = 0;
        var stepY:Float = 0;
        if (open >= 0 && close > open)
        {
          var argsText:String = spriteLine.substring(open + 1, close);
          var comma:Int = argsText.indexOf(',');
          if (comma >= 0)
          {
            var xText:String = StringTools.trim(argsText.substring(0, comma));
            var yText:String = StringTools.trim(argsText.substring(comma + 1));
            xVal = screenNumOr(xText, 0);
            yVal = screenNumOr(yText, 0);
            // Handle loop-position expressions such as
            // `-100 + (i * 180)` without evaluating the loop variable.
            var plus:Int = xText.indexOf('+');
            if (plus > 0) xVal = numOr(xText.substring(0, plus), xVal);
            plus = yText.indexOf('+');
            if (plus > 0) yVal = numOr(yText.substring(0, plus), yVal);
            var mul:Int = xText.indexOf('*');
            if (mul >= 0) stepX = numOr(xText.substring(mul + 1), 0);
            mul = yText.indexOf('*');
            if (mul >= 0) stepY = numOr(yText.substring(mul + 1), 0);
          }
        }
        scriptSprites.push({varName: varName, x: xVal, y: yVal, stepX: stepX, stepY: stepY, count: loopCount, scaleX: 1, scaleY: 1, antialiasing: true, atlas: '', anim: '', prefix: '', frame: -1, fps: 24, before: '', z: 150});
        continue;
      }
      if (scriptSprites.length == 0) continue;
      var last:Dynamic = scriptSprites[scriptSprites.length - 1];
      var lastName:String = Std.string(get(last, 'varName'));
      if (lastName == null || lastName == 'null' || lastName == '') continue;
      if (spriteLine.indexOf(lastName + '.frames = Paths.getSparrowAtlas(') >= 0)
      {
        var aq:Int = spriteLine.indexOf("'", spriteLine.indexOf('getSparrowAtlas'));
        var quote:String = "'";
        var aq2:Int = spriteLine.indexOf('"', spriteLine.indexOf('getSparrowAtlas'));
        if (aq2 >= 0 && (aq < 0 || aq2 < aq)) { aq = aq2; quote = '"'; }
        var ae:Int = aq < 0 ? -1 : spriteLine.indexOf(quote, aq + 1);
        if (ae > aq)
        {
          var atlas:String = spriteLine.substring(aq + 1, ae);
          if (StringTools.startsWith(atlas, 'stages/$baseId')) atlas = 'stages/$stageId' + atlas.substring(('stages/$baseId').length);
          set(last, 'atlas', atlas);
        }
      }
      var prefixIdx:Int = spriteLine.indexOf('.animation.addByPrefix(');
      if (prefixIdx >= 0)
      {
        var qA:Int = spriteLine.indexOf("'", prefixIdx);
        var qB:Int = qA < 0 ? -1 : spriteLine.indexOf("'", qA + 1);
        var qC:Int = qB < 0 ? -1 : spriteLine.indexOf("'", qB + 1);
        var qD:Int = qC < 0 ? -1 : spriteLine.indexOf("'", qC + 1);
        if (qD > qC)
        {
          set(last, 'anim', spriteLine.substring(qA + 1, qB));
          set(last, 'prefix', spriteLine.substring(qC + 1, qD));
          var randomIdx:Int = spriteLine.indexOf('FlxG.random.int(');
          if (randomIdx >= 0)
          {
            set(last, 'randomFrames', true);
            var randomOpen:Int = spriteLine.indexOf('(', randomIdx);
            var randomClose:Int = spriteLine.indexOf(')', randomOpen);
            if (randomClose > randomOpen)
            {
              var randomParts:Array<String> = spriteLine.substring(randomOpen + 1, randomClose).split(',');
              if (randomParts.length > 1)
              {
                var randomMin:Float = numOr(randomParts[0], 0);
                var randomMax:Float = numOr(randomParts[1], 0);
                set(last, 'randomMin', randomMin);
                set(last, 'randomMax', randomMax);
                var atlasForRandom:String = Std.string(get(last, 'atlas'));
                var prefixForRandom:String = Std.string(get(last, 'prefix'));
                if (atlasForRandom != null && atlasForRandom != 'null' && atlasForRandom != '' && prefixForRandom != null && prefixForRandom != 'null')
                {
                  var atlasXml:String = util.readText('mods/$dir/images/$atlasForRandom.xml');
                  if (atlasXml == null && StringTools.startsWith(atlasForRandom, 'stages/$stageId'))
                    atlasXml = util.readText('mods/$dir/images/stages/$baseId' + atlasForRandom.substring(('stages/$stageId').length) + '.xml');
                  if (atlasXml != null && atlasXml.indexOf('name="' + prefixForRandom + Std.int(randomMin) + '"') < 0
                    && atlasXml.indexOf('name="' + prefixForRandom + Std.int(randomMin + 1) + '"') >= 0)
                    set(last, 'randomOffset', 1);
                }
              }
            }
          }
        }
      }
      if (spriteLine.indexOf(lastName + '.scale.set(') >= 0)
      {
        var so:Int = spriteLine.indexOf('(', spriteLine.indexOf(lastName + '.scale.set'));
        var sc:Int = spriteLine.indexOf(')', so);
        if (so >= 0 && sc > so)
        {
          var parts:Array<String> = spriteLine.substring(so + 1, sc).split(',');
          if (parts.length > 0) set(last, 'scaleX', numOr(parts[0], 1));
          if (parts.length > 1) set(last, 'scaleY', numOr(parts[1], 1));
        }
      }
      var insertIdx:Int = spriteLine.indexOf('insert(members.indexOf(');
      if (insertIdx >= 0 && spriteLine.indexOf(lastName, insertIdx) >= 0)
      {
        var bo:Int = spriteLine.indexOf('indexOf(', insertIdx) + 8;
        var bc:Int = spriteLine.indexOf(')', bo);
        if (bc > bo) set(last, 'before', StringTools.trim(spriteLine.substring(bo, bc)));
      }
    }
    set(fx, 'scriptSprites', scriptSprites);

    // Extract the common Codename stateful beat pattern declaratively. This
    // supports switch(state) cases that set a base pose and an alternating
    // special pose without depending on a stage or mod name.
    var beatModes:Dynamic = {};
    var activeBeatMode:Int = -1;
    var beatConditional:Bool = false;
    for (beatRaw in lines)
    {
      var beatLine:String = StringTools.trim(beatRaw);
      if (beatLine.indexOf('case ') == 0 && beatLine.indexOf(':') > 5)
      {
        var caseEnd:Int = beatLine.indexOf(':');
        var parsedCase:Null<Int> = Std.parseInt(StringTools.trim(beatLine.substring(5, caseEnd)));
        activeBeatMode = parsedCase == null ? -1 : parsedCase;
        beatConditional = false;
        if (activeBeatMode >= 0) set(beatModes, Std.string(activeBeatMode), {mode: activeBeatMode, baseX: 1, baseY: 1, baseSet: false, specialX: 1, specialY: 1, specialSet: false, pattern: 'none'});
      }
      if (activeBeatMode < 0) continue;
      var modeCfg:Dynamic = get(beatModes, Std.string(activeBeatMode));
      if (modeCfg == null) continue;
      // Only pose-selection conditions should classify the following sprite
      // assignment as a special pose. Bounds checks such as
      // `if (beated >= stupidheads.length)` are control flow, not a pose.
      if ((beatLine.indexOf('if (') == 0 || beatLine.indexOf('if(') == 0)
        && (beatLine.indexOf('i % 2 == beated') >= 0 || beatLine.indexOf('beated % 2 == 0') >= 0)) beatConditional = true;
      var scaleIdx:Int = beatLine.indexOf('.scale.set(');
      if (scaleIdx >= 0)
      {
        var so:Int = beatLine.indexOf('(', scaleIdx);
        var sc:Int = beatLine.indexOf(')', so);
        if (so >= 0 && sc > so)
        {
          var sp:Array<String> = beatLine.substring(so + 1, sc).split(',');
          if (sp.length >= 2)
          {
            var sx:Float = numOr(sp[0], 1); var sy:Float = numOr(sp[1], 1);
            var special:Bool = beatLine.indexOf('[beated]') >= 0 || beatConditional;
            if (special) { set(modeCfg, 'specialX', sx); set(modeCfg, 'specialY', sy); set(modeCfg, 'specialSet', true); }
            else { set(modeCfg, 'baseX', sx); set(modeCfg, 'baseY', sy); set(modeCfg, 'baseSet', true); }
          }
        }
      }
      if (beatLine.indexOf('.y =') >= 0)
      {
        var yeq:Int = beatLine.indexOf('=');
        var yy:Float = numOr(beatLine.substring(yeq + 1), 0);
        var specialY:Bool = beatLine.indexOf('[beated]') >= 0 || beatConditional;
        if (specialY) { set(modeCfg, 'specialYPos', yy); set(modeCfg, 'specialSet', true); }
        else { set(modeCfg, 'baseYPos', yy); set(modeCfg, 'baseSet', true); }
      }
      if (beatLine.indexOf('i % 2 == beated') >= 0) set(modeCfg, 'pattern', 'indexParity');
      else if (beatLine.indexOf('beated % 2 == 0') >= 0) set(modeCfg, 'pattern', 'beatParity');
      else if (beatLine.indexOf('[beated]') >= 0) set(modeCfg, 'pattern', 'sequence');
    }
    for (modeKey in ReflectUtil.fields(beatModes))
    {
      var modeOut:Dynamic = get(beatModes, modeKey);
      if (modeOut != null && get(modeOut, 'baseSet') == true) get(fx, 'beatModes').push(modeOut);
    }

    // name -> {frag, uniforms{}
    var shaders:Dynamic = {};
    var shaderNames:Array<String> = [];
    // overlay sprite vars, in creation order
    var ovOrder:Array<String> = [];
    var ovs:Dynamic = {};
    var curSection:String = '';
    var depth:Int = 0;

    for (li in 0...lines.length)
    {
      var line:String = StringTools.trim(lines[li]);
      if (line.indexOf('function ') == 0)
      {
        if (line.indexOf('beatHit') >= 0) curSection = 'beat';
        else if (line.indexOf('stepHit') >= 0) curSection = 'step';
        else curSection = 'other';
        continue;
      }
      if (line == '') continue;
      // Portable stepHit effects. Keep the extraction generic: the runtime
      // decides how to render the recognized effect rather than replaying raw
      // Codename HScript against V-Slice-only objects.

      // NOTE: use3D blocks are NOT skipped - GUNLICK's global.hx defaults
      // enable3D to TRUE, so those blocks describe the mod's default look
      // (character grading, parallax scroll factors). Non-portable lines
      // inside them (Flx3DView etc.) simply match no handler and drop out.
      var oc:Int = countChar(line, '{');
      var cc:Int = countChar(line, '}');
      depth += oc - cc;

      // Shader declarations.
      var csIdx:Int = line.indexOf('new CustomShader(');
      if (csIdx >= 0)
      {
        var open:Int = line.indexOf('(', csIdx);
        var close:Int = line.indexOf(')', open);
        if (open >= 0 && close > open)
        {
          var frag:String = stripQuotes(StringTools.trim(line.substring(open + 1, close)));
          var eqIdx:Int = line.indexOf('=');
          if (frag != '' && eqIdx > 0 && line.indexOf('var ') >= 0)
          {
            var vName:String = StringTools.trim(line.substring(line.indexOf('var ') + 4, eqIdx));
            var colon:Int = vName.indexOf(':');
            if (colon > 0) vName = StringTools.trim(vName.substring(0, colon));
            if (vName != '') { set(shaders, vName, {frag: frag, uniforms: []}); shaderNames.push(vName); }
          }
        }
        continue;
      }

      // Shader uniform assignments: X.k = number;
      var matchedUniform:Bool = false;
      for (sn in shaderNames)
      {
        if (StringTools.startsWith(line, sn + '.'))
        {
          var eqI:Int = line.indexOf('=');
          if (eqI > 0 && line.indexOf('==') != eqI)
          {
            var uName:String = StringTools.trim(line.substring(sn.length + 1, eqI));
            var uVal:Float = Std.parseFloat(StringTools.trim(line.substring(eqI + 1)));
            if (!Math.isNaN(uVal))
            {
              get(get(shaders, sn), 'uniforms').push({k: uName, v: uVal});
              matchedUniform = true;
            }
          }
          break;
        }
      }
      if (matchedUniform) continue;

      // Character shader assignment (possibly chained):
      // boyfriend.shader = dad.shader = gf.shader = shvar;
      if (line.indexOf('.shader') >= 0 && line.indexOf('=') >= 0 && line.indexOf('new CustomShader') < 0)
      {
        var eqE:Int = line.lastIndexOf('=');
        var rhs:String = StringTools.trim(line.substring(eqE + 1));
        if (rhs.charAt(rhs.length - 1) == ';') rhs = StringTools.trim(rhs.substring(0, rhs.length - 1));
        if (get(shaders, rhs) != null)
        {
          var lhsPart:String = StringTools.trim(line.substring(0, eqE));
          var segs:Array<String> = lhsPart.split('=');
          var matchedSlot:Bool = false;
          for (seg in segs)
          {
            var segT:String = StringTools.trim(seg);
            var dot:Int = segT.indexOf('.shader');
            if (dot <= 0) continue;
            var target:String = StringTools.trim(segT.substring(0, dot));
            var slot:String = '';
            if (target == 'boyfriend' || target == 'bf' || target == 'player') slot = 'bf';
            else if (target == 'dad' || target == 'opponent') slot = 'dad';
            else if (target == 'gf' || target == 'girlfriend') slot = 'gf';
            if (slot != '')
            {
              set(get(fx, 'charShader'), slot, get(shaders, rhs));
              matchedSlot = true;
            }
          }
          // Only swallow the line when a CHARACTER got the shader; overlay
          // '.shader =' lines must fall through to the overlay handler.
          if (matchedSlot) continue;
        }
      }

      // Beat bounce parameters.
      if (curSection == 'beat')
      {
        if (line.indexOf('dropAmount') >= 0 && line.indexOf('=') >= 0)
        {
          var dv:Float = Std.parseFloat(StringTools.trim(line.substring(line.indexOf('=') + 1)));
          if (!Math.isNaN(dv))
          {
            if (fx.beatBounce == null) fx.beatBounce = {drop: dv, dur: 0.3, count: 4, prefix: 'crowd'};
            else set(fx.beatBounce, 'drop', dv);
          }
        }
        if (line.indexOf('durationUp') >= 0 && line.indexOf('=') >= 0)
        {
          var du:Float = Std.parseFloat(StringTools.trim(line.substring(line.indexOf('=') + 1)));
          if (!Math.isNaN(du) && fx.beatBounce != null) set(fx.beatBounce, 'dur', du);
        }
        var forIdx:Int = line.indexOf('in 1...');
        if (forIdx >= 0)
        {
          var cntStr:String = StringTools.trim(line.substring(forIdx + 7));
          var endNum:Int = 0;
          while (endNum < cntStr.length)
          {
            var cCode:Int = cntStr.charCodeAt(endNum);
            if (cCode < 48 || cCode > 57) break;
            endNum++;
          }
          var cnt:Int = Std.parseInt(cntStr.substring(0, endNum));
          if (cnt != null && cnt > 0 && fx.beatBounce != null) set(fx.beatBounce, 'count', cnt);
        }
        continue;
      }

      // Overlay sprites created in create/postCreate.
      if (line.indexOf('new FlxSprite(') >= 0 && line.indexOf('var ') >= 0)
      {
        var eqO:Int = line.indexOf('=');
        if (eqO > 0)
        {
          var ovName:String = StringTools.trim(line.substring(line.indexOf('var ') + 4, eqO));
          var colon2:Int = ovName.indexOf(':');
          if (colon2 > 0) ovName = StringTools.trim(ovName.substring(0, colon2));
          var openP:Int = line.indexOf('(', line.indexOf('new FlxSprite'));
          var closeP:Int = line.indexOf(')', openP);
          var ox:Float = 0;
          var oy:Float = 0;
          if (openP >= 0 && closeP > openP)
          {
            var args:String = line.substring(openP + 1, closeP);
            var comma:Int = args.indexOf(',');
            if (comma > 0)
            {
              ox = screenNumOr(args.substring(0, comma), 0);
              oy = screenNumOr(args.substring(comma + 1), 0);
            }
          }
          if (ovName != '')
          {
            var ov:Dynamic = {x: ox, y: oy, w: 1, h: 1, color: '4294967295', scaleX: 1, scaleY: 1, scrollX: 0, scrollY: 0, angle: 0, alpha: 1, blend: '', z: 5000, added: false};
            set(ovs, ovName, ov);
            ovOrder.push(ovName);
          }
        }
        continue;
      }

      // Scroll-factor overrides (apply3DScrollFactors-style parallax):
      // <ref>.scrollFactor.set(a, b) where ref is a character slot or a
      // named stage prop (stage.stageSprites["name"]). Lines owned by
      // script-created overlay vars fall through to the overlay handler.
      if (line.indexOf('.visible = false') >= 0)
      {
        var visOwner:String = StringTools.trim(line.substring(0, line.indexOf('.visible')));
        var vTarget:String = '';
        var vsIdx:Int = visOwner.indexOf('stage.stageSprites[');
        if (vsIdx >= 0)
        {
          var vqA:Int = visOwner.indexOf('"');
          var vqB:Int = visOwner.indexOf('"', vqA + 1);
          if (vqA >= 0 && vqB > vqA) vTarget = visOwner.substring(vqA + 1, vqB);
        }
        else if (visOwner == 'bg') vTarget = 'bg';
        if (vTarget != '') get(fx, 'hideProps').push(vTarget);
        continue;
      }
      if (line.indexOf('addModel(Paths.awd(') >= 0 || line.indexOf('addModel(Paths.awd (') >= 0)
      {
        var awdOpen:Int = line.indexOf("'");
        var awdQ:String = "'";
        var awdAlt:Int = line.indexOf('"');
        if (awdAlt >= 0 && (awdOpen < 0 || awdAlt < awdOpen)) { awdOpen = awdAlt; awdQ = '"'; }
        if (awdOpen >= 0)
        {
          var awdEnd:Int = line.indexOf(awdQ, awdOpen + 1);
          if (awdEnd > awdOpen) set(fx, 'model', line.substring(awdOpen + 1, awdEnd));
        }
        continue;
      }
      if (line.indexOf('.scrollFactor.set(') >= 0)
      {
        var sfOwn:String = StringTools.trim(line.substring(0, line.indexOf('.scrollFactor')));
        if (get(ovs, sfOwn) == null)
        {
          var sfOpen2:Int = line.indexOf('(');
          var sfClose:Int = line.lastIndexOf(')');
          if (sfOpen2 >= 0 && sfClose > sfOpen2)
          {
            var sfArgs:String = line.substring(sfOpen2 + 1, sfClose);
            var sfParts:Array<String> = sfArgs.split(',');
            if (sfParts.length >= 2)
            {
              var targetName:String = '';
              var ssIdx:Int = line.indexOf('stage.stageSprites[');
              if (ssIdx >= 0)
              {
                var qA:Int = line.indexOf('"', ssIdx);
                var qB:Int = line.indexOf('"', qA + 1);
                if (qA >= 0 && qB > qA) targetName = line.substring(qA + 1, qB);
              }
              else
              {
                if (sfOwn == 'boyfriend' || sfOwn == 'bf' || sfOwn == 'player') targetName = 'bf';
                else if (sfOwn == 'dad' || sfOwn == 'opponent') targetName = 'dad';
                else if (sfOwn == 'gf' || sfOwn == 'girlfriend') targetName = 'gf';
                else targetName = sfOwn;
              }
              if (targetName != '')
              {
                get(fx, 'scrolls').push({target: targetName, x: numOr(sfParts[0], 1), y: numOr(sfParts[1], 1)});
              }
            }
          }
          continue;
        }
      }

      // Overlay sprite lines: X.prop(...)
      var dotProp:Int = line.indexOf('.');
      if (dotProp > 0)
      {
        var owner:String = StringTools.trim(line.substring(0, dotProp));
        var ov2:Dynamic = get(ovs, owner);
        if (ov2 != null)
        {
          if (line.indexOf('.makeGraphic(') >= 0)
          {
            var mgOpen:Int = line.indexOf('(');
            var mgArgs:String = line.substring(mgOpen + 1, line.lastIndexOf(')'));
            var parts:Array<String> = mgArgs.split(',');
            if (parts.length >= 2)
            {
              // FlxG.width/height tokens become sentinels (-1/-2) resolved
              // against the real screen size at stage-build time.
              set(ov2, 'w', screenNumOr(parts[0], 1));
              set(ov2, 'h', screenNumOr(parts[1], 1));
            }
            if (parts.length >= 3) set(ov2, 'color', colorToken(parts[2]));
          }
          else if (line.indexOf('.loadGraphic(') >= 0)
          {
            var q1:Int = line.indexOf("'");
            var q1b:Int = line.indexOf('"');
            if (q1b >= 0 && (q1 < 0 || q1b < q1)) q1 = q1b;
            if (q1 >= 0)
            {
              var q2:Int = line.indexOf(line.charAt(q1), q1 + 1);
              if (q2 > q1) set(ov2, 'image', line.substring(q1 + 1, q2));
            }
          }
          else if (line.indexOf('.blend') >= 0)
          {
            var bEq:Int = line.indexOf('=');
            var bv:String = StringTools.trim(line.substring(bEq + 1));
            var dotB:Int = bv.lastIndexOf('.');
            if (dotB >= 0) bv = bv.substring(dotB + 1);
            if (bv.charAt(bv.length - 1) == ';') bv = bv.substring(0, bv.length - 1);
            set(ov2, 'blend', bv);
          }
          else if (line.indexOf('.shader') >= 0)
          {
            var sEq:Int = line.lastIndexOf('=');
            var sv:String = StringTools.trim(line.substring(sEq + 1));
            if (sv.charAt(sv.length - 1) == ';') sv = sv.substring(0, sv.length - 1);
            set(ov2, 'shader', get(shaders, sv));
          }
          else if (line.indexOf('.scrollFactor.set(') >= 0)
          {
            var sfOpen:Int = line.indexOf('(');
            var sfArgs:String = line.substring(sfOpen + 1, line.lastIndexOf(')'));
            var sfParts:Array<String> = sfArgs.split(',');
            set(ov2, 'scrollX', sfParts.length > 0 ? numOr(sfParts[0], 0) : 0);
            set(ov2, 'scrollY', sfParts.length > 1 ? numOr(sfParts[1], 0) : 0);
          }
          else if (line.indexOf('.scale.set(') >= 0)
          {
            var scOpen:Int = line.indexOf('(');
            var scArgs:String = line.substring(scOpen + 1, line.lastIndexOf(')'));
            var scParts:Array<String> = scArgs.split(',');
            set(ov2, 'scaleX', scParts.length > 0 ? numOr(scParts[0], 1) : 1);
            set(ov2, 'scaleY', scParts.length > 1 ? numOr(scParts[1], 1) : 1);
          }
          else if (line.indexOf('.angle') >= 0)
          {
            var aEq:Int = line.indexOf('=');
            set(ov2, 'angle', numOr(line.substring(aEq + 1), 0));
          }
          else if (line.indexOf('.alpha') >= 0)
          {
            var alEq:Int = line.indexOf('=');
            set(ov2, 'alpha', numOr(line.substring(alEq + 1), 1));
          }
          continue;
        }
      }

      // add(X) / insert(_, X) marks the overlay as actually used.
      if ((StringTools.startsWith(line, 'add(') || line.indexOf('insert(') >= 0) && ovOrder.length > 0)
      {
        for (on2 in ovOrder)
        {
          if (line.indexOf(on2) >= 0)
          {
            var ov3:Dynamic = get(ovs, on2);
            set(ov3, 'added', true);
            if (line.indexOf('insert(0') >= 0) set(ov3, 'z', -1000);
          }
        }
        continue;
      }
    }

    var outOverlays:Array<Dynamic> = [];
    for (name in ovOrder)
    {
      var ovf:Dynamic = get(ovs, name);
      if (ovf != null && util.getBool(get(ovf, 'added'), false)) outOverlays.push(ovf);
    }
    set(fx, 'overlays', outOverlays);
    return fx;
  }

  function numOr(s:String, fallback:Float):Float
  {
    var t:String = StringTools.trim(s);
    if (t.charAt(t.length - 1) == ';') t = StringTools.trim(t.substring(0, t.length - 1));
    var v:Float = Std.parseFloat(t);
    if (Math.isNaN(v)) return fallback;
    return v;
  }

  // Evaluate the small arithmetic expressions used by Codename fullscreen
  // overlays. The old importer only accepted literals, so expressions such as
  // `FlxG.width * 2` became 1x1 sprites and `-FlxG.width / 2` became 0, which
  // renders a shader as a tiny square at the top-left corner.
  function screenNumOr(s:String, fallback:Float):Float
  {
    var t:String = StringTools.trim(s);
    if (t.charAt(t.length - 1) == ';') t = StringTools.trim(t.substring(0, t.length - 1));
    while (t.length >= 2 && t.charAt(0) == '(' && t.charAt(t.length - 1) == ')')
      t = StringTools.trim(t.substring(1, t.length - 1));
    t = StringTools.replace(t, 'FlxG.width', Std.string(FlxG.width));
    t = StringTools.replace(t, 'FlxG.height', Std.string(FlxG.height));
    t = StringTools.replace(t, ' ', '');
    // Handle one level of +, -, *, or /. This covers the screen-space
    // expressions used by stage scripts without executing arbitrary code.
    var op:Int = -1;
    for (i in 1...t.length)
    {
      var c:String = t.charAt(i);
      if (c == '+' || c == '-' || c == '*' || c == '/') { op = i; break; }
    }
    if (op > 0)
    {
      var left:Float = Std.parseFloat(t.substring(0, op));
      var right:Float = Std.parseFloat(t.substring(op + 1));
      if (!Math.isNaN(left) && !Math.isNaN(right))
      {
        switch (t.charAt(op))
        {
          case '+': return left + right;
          case '-': return left - right;
          case '*': return left * right;
          case '/': return right == 0 ? fallback : left / right;
        }
      }
    }
    var value:Float = Std.parseFloat(t);
    if (!Math.isNaN(value) && (t != '')) return value;
    return fallback;
  }

  // Numeric dimension token; retained for callers that need the old API.
  function dimToken(s:String):Float
  {
    return screenNumOr(s, 1);
  }

  // Map FlxColor.NAME / 0xAARRGGBB tokens to an int string for makeGraphic.
  function colorToken(s:String):String
  {
    var t:String = StringTools.trim(s);
    if (t.charAt(t.length - 1) == ';') t = StringTools.trim(t.substring(0, t.length - 1));
    var named:Dynamic = {WHITE: '4294967295', BLACK: '4278190080', RED: '4294901760', GREEN: '4278255360', BLUE: '4278190335', TRANSPARENT: '0'};
    if (StringTools.startsWith(t, 'FlxColor.'))
    {
      var nm:String = t.substring('FlxColor.'.length);
      var mapped:Dynamic = get(named, nm);
      if (mapped != null) return Std.string(mapped);
      return '4278190080';
    }
    if (StringTools.startsWith(t, '0x'))
    {
      var v:Null<Int> = Std.parseInt(t);
      if (v != null) return Std.string(v);
    }
    return '4278190080';
  }

  function sanitizeClassName(s:String):String
  {
    var result:String = StringTools.replace(s, ' ', '_');
    result = StringTools.replace(result, '-', '_');
    result = StringTools.replace(result, '.', '_');
    result = StringTools.replace(result, '/', '_');
    result = StringTools.replace(result, '\\', '_');
    // Prefix with underscore if it starts with a digit.
    if (result.length > 0 && result.charCodeAt(0) >= 48 && result.charCodeAt(0) <= 57) result = '_' + result;
    if (result.length == 0) result = '_unnamed';
    return result;
  }

  // ------------------------------------------------------------------
  // Image sweep: every PNG/XML under the mod's images/ folder.
  // ------------------------------------------------------------------

  public function sweepImages(dir:String, out:Dynamic):Void
  {
    var files:Array<String> = util.listFilesRecursive('mods/$dir/images', 8);
    for (rel in files)
    {
      var lower:String = rel.toLowerCase();
      if (StringTools.endsWith(lower, '.png'))
      {
        // Noteskins/splashes may be referenced by imported songs - keep
        // them. Everything else under images/ is only ever rendered by
        // scripts that cannot run in V-Slice, so skip the PNG (skipping the
        // decode also prevents the huge boot-time RAM/load hit from mods
        // that ship many large stage/effect images).
        if (StringTools.startsWith(lower, 'notes/') || StringTools.startsWith(lower, 'splashes/'))
        {
          addImage(out, dir, rel);
        }
      }
      else if (StringTools.endsWith(lower, '.xml'))
      {
        // Character/stage atlases are registered precisely by the
        // character/stage converters (with per-mod namespaced keys when ids
        // collide) - a raw registration here would let a later mod's sweep
        // override an earlier mod's correctly-keyed art. UI/font/UI-atlases
        // still register here.
        if (StringTools.startsWith(lower, 'characters/')) continue;
        if (StringTools.startsWith(lower, 'stages/')) continue;
        var text:String = util.readText('mods/$dir/images/$rel');
        if (text != null)
        {
          out.texts.push({paths: util.imageKeys(rel), content: text});
        }
      }
    }
  }

  // Codename mods without a weeks.txt/weeks folder (or whose weeks have no
  // chart data) still need their songs to show up in freeplay, which only
  // lists songs through levels. Emit a virtual catch-all level so every
  // imported song is reachable.
  public function makeFallbackLevel(dir:String, out:Dynamic):Void
  {
    var levelId:String = 'fc-' + util.normalizeId(dir);
    if (levelId == 'fc-' || out.levels.indexOf(levelId) != -1) levelId = 'fc-mod';
    var levelData:Dynamic = {
      version: '1.0.0',
      name: dir,
      titleAsset: 'storymenu/titles/$levelId',
      props: [],
      background: '#F9CF51',
      songs: out.songs
    };
    addText(out, util.dataTextKeys('levels/$levelId.json'), util.stringify(levelData));
    out.levels.push(levelId);
    util.warn('Codename: no weeks found - generated fallback level "$levelId" with ${out.songs.length} song(s)');
  }

  // Registers mod .frag/.vert shaders into the virtual cache so the
  // generated ScriptedStages can construct FlxRuntimeShaders from them
  // (V-Slice resolves shaders by Paths.frag -> assets/shaders/<name>.frag).
  public function sweepShaders(dir:String, out:Dynamic):Void
  {
    if (!util.pathExists('mods/$dir/shaders')) return;
    var files:Array<String> = util.listDir('mods/$dir/shaders');
    for (f in files)
    {
      var lower:String = f.toLowerCase();
      if (!StringTools.endsWith(lower, '.frag') && !StringTools.endsWith(lower, '.vert')) continue;
      var text:String = util.readText('mods/$dir/shaders/$f');
      if (text == null) continue;
      out.texts.push({paths: util.shaderKeys(f), content: text});
    }
  }

  // ------------------------------------------------------------------
  // Entry point
  // ------------------------------------------------------------------

  public function convert(dir:String, out:Dynamic, ?detectedAspect:Int = 0):Void
  {
    trace('[FUNKY-COMPAT] (codename) $dir: songs...');
    this.detectedAspect = (detectedAspect != null) ? detectedAspect : 0;
    // Non-portable mod-root content, reported once per mod.
    if (util.pathExists('mods/$dir/videos') && util.listDir('mods/$dir/videos').length > 0)
    {
      util.warn('Codename: videos in "$dir" are not portable to V-Slice');
    }
    if (util.pathExists('mods/$dir/data/dialogue'))
    {
      util.warn('Codename: dialogue in "$dir" is not portable to V-Slice');
    }
    if (util.pathExists('mods/$dir/data/scripts'))
    {
      util.warn('Codename: data/scripts in "$dir" (HScript) are not portable to V-Slice');
    }
    if (util.pathExists('mods/$dir/shaders') && util.listDir('mods/$dir/shaders').length > 0)
    {
      util.warn('Codename: custom shaders in "$dir" are not portable to V-Slice');
    }
    convertSongs(dir, out);
    trace('[FUNKY-COMPAT] (codename) $dir: weeks...');
    convertWeeks(dir, out);
    if (out.levels.length == 0 && out.songs.length > 0) makeFallbackLevel(dir, out);
    trace('[FUNKY-COMPAT] (codename) $dir: characters...');
    convertCharacters(dir, out);
    trace('[FUNKY-COMPAT] (codename) $dir: stages...');
    convertStages(dir, out);
    trace('[FUNKY-COMPAT] (codename) $dir: image sweep...');
    sweepImages(dir, out);
    trace('[FUNKY-COMPAT] (codename) $dir: shaders...');
    sweepShaders(dir, out);
    trace('[FUNKY-COMPAT] (codename) $dir: done');
  }

  // ------------------------------------------------------------------
  // Attribute parsing helpers
  // ------------------------------------------------------------------

  public function parseIntAttr(body:String, name:String, fallback:Int):Int
  {
    var raw:String = attr(body, name);
    if (raw == null || raw == '') return fallback;
    var v:Int = Std.parseInt(raw);
    if (v == null) return fallback;
    return v;
  }

  public function floatAttr(body:String, name:String, fallback:Float):Float
  {
    var raw:String = attr(body, name);
    if (raw == null || raw == '') return fallback;
    var v:Float = Std.parseFloat(raw);
    if (Math.isNaN(v)) return fallback;
    return v;
  }

  public function boolAttr(body:String, name:String, fallback:Bool):Bool
  {
    var raw:String = attr(body, name);
    if (raw == null || raw == '') return fallback;
    var lower:String = raw.toLowerCase();
    if (lower == 'true') return true;
    if (lower == 'false') return false;
    return fallback;
  }}
