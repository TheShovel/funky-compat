// funky-compat - generic runtime-configurable stage.
// ONE real scripted class, instantiated per converted Codename stage by
// FunkyCompatModule at boot (in-memory; no files are written). Each instance
// receives a `dyn` config object holding raw engine anchor data plus portable
// FX extracted from the mod's stage scripts (shaders, overlays, beat bounces)
// and reproduces the original engine's positioning/behavior at play time.

import funkin.play.stage.Stage;
import funkin.Conductor;

import funkin.play.character.BaseCharacter;
import funkin.play.character.CharacterType;
import funkin.Assets;
import funkin.Paths;
import funkin.util.ReflectUtil;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.util.FlxColor;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.addons.display.FlxRuntimeShader;
import openfl.display.BlendMode;

class FunkyCompatDynStage extends Stage
{
  public var dyn:Dynamic;

  // Shader instances created for script-derived overlays. Codename stage
  // scripts commonly animate these from update(), e.g. fog.iTime = time.
  var runtimeShaders:Array<FlxRuntimeShader> = [];
  var shaderTime:Float = 0;
  var soloFlash:FlxSprite = null;
  var soloSprites:Array<FlxSprite> = [];
  var lastSoloStep:Int = -1;
  var callCursor:Int = 0;
  var codenameBeatMode:Int = 0;
  var lastCompatBeat:Int = -1;
  var scriptSprites:Array<FlxSprite> = [];
  var extractedBeat:Int = -1;
  var extractedBeatCount:Int = 0;
  var dynamicPropBases:Dynamic = {};

  public function new(id:String)
  {
    super(id);
  }

  // Build script-derived overlay sprites once the JSON props exist.
  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    callCursor = 0;
    codenameBeatMode = 0;
    scriptSprites = [];
    extractedBeat = -1;
    extractedBeatCount = 0;
    dynamicPropBases = {};
    lastCompatBeat = -1;
    // 3D stages: use the pre-rendered background image instead of the 3D model.
    if (dyn != null && get(dyn, 'is3D') == true)
    {
      var stageId:String = this.id != null ? this.id : 'unknown';
      trace('[FUNKY-COMPAT] 3D stage "' + stageId + '" - using pre-rendered background');
    }
    if (dyn == null || dyn.overlays == null) return;
    for (o in 0...dyn.overlays.length)
    {
      var ov:Dynamic = dyn.overlays[o];
      if (ov == null) continue;
      var shSpec:Dynamic = get(ov, 'shader');
      trace('[FUNKY-COMPAT] DynStage overlay ' + o + ': pos=(' + util_f(get(ov, 'x'), 0) + ',' + util_f(get(ov, 'y'), 0) + ') size=(' + util_f(get(ov, 'w'), 1) + 'x' + util_f(get(ov, 'h'), 1) + ') col=' + Std.string(get(ov, 'color')) + ' scale=(' + util_f(get(ov, 'scaleX'), 1) + ',' + util_f(get(ov, 'scaleY'), 1) + ') scroll=(' + util_f(get(ov, 'scrollX'), 0) + ',' + util_f(get(ov, 'scrollY'), 0) + ') ang=' + util_f(get(ov, 'angle'), 0) + ' blend=' + Std.string(get(ov, 'blend')) + ' z=' + util_f(get(ov, 'z'), 5000) + ' shader=' + (shSpec == null ? 'none' : Std.string(get(shSpec, 'frag'))));
      var spr:FlxSprite = new FlxSprite(util_f(get(ov, 'x'), 0), util_f(get(ov, 'y'), 0));
      var imgRaw:Dynamic = get(ov, 'image');
      var img:String = imgRaw == null ? '' : Std.string(imgRaw);
      if (img != '')
      {
        spr.loadGraphic(Paths.image(img));
      }
      else
      {
        var col:Dynamic = get(ov, 'color');
        var colInt:Null<Int> = col == null ? 0xFF000000 : Std.parseInt(Std.string(col));
        // Sentinels from extraction: -1 = screen width, -2 = screen height.
        var wRaw:Float = util_f(get(ov, 'w'), 1);
        var hRaw:Float = util_f(get(ov, 'h'), 1);
        var wInt:Int = wRaw <= -1.5 ? FlxG.height : (wRaw <= -0.5 ? FlxG.width : Std.int(wRaw));
        var hInt:Int = hRaw <= -1.5 ? FlxG.height : (hRaw <= -0.5 ? FlxG.width : Std.int(hRaw));
        if (wInt < 1) wInt = 1;
        if (hInt < 1) hInt = 1;
        // Shader-overlay sprites (like GUNLICK's fog) need OPAQUE pixels:
        // their fragment shaders sample texture alpha to gate visibility,
        // and a truly transparent bitmap yields alpha=0 (invisible) or
        // platform-dependent garbage. White fill = alpha 1 everywhere.
        var isShaderOverlay:Bool = get(ov, 'shader') != null;
        if (isShaderOverlay && colInt == 0) colInt = 0xFFFFFFFF;
        spr.makeGraphic(wInt, hInt, colInt == null ? 0xFF000000 : colInt);
      }
      var sx:Float = util_f(get(ov, 'scaleX'), 1);
      var sy:Float = util_f(get(ov, 'scaleY'), 1);
      if (sx != 1 || sy != 1)
      {
        spr.scale.set(sx, sy);
        spr.updateHitbox();
      }
      spr.scrollFactor.set(util_f(get(ov, 'scrollX'), 0), util_f(get(ov, 'scrollY'), 0));
      spr.angle = util_f(get(ov, 'angle'), 0);
      // Rotate around the CENTER, not flixel's default top-left origin -
      // otherwise large rotated overlays (fog @180°) swing mostly
      // off-screen leaving only a corner visible.
      if (spr.angle != 0)
      {
        spr.origin.set(spr.width / 2, spr.height / 2);
      }
      spr.alpha = util_f(get(ov, 'alpha'), 1);
      var blendRaw:Dynamic = get(ov, 'blend');
      var blend:String = blendRaw == null ? '' : Std.string(blendRaw);
      if (blend != '') spr.blend = BlendMode.fromString(blend);
      var sh:FlxRuntimeShader = makeShader(get(ov, 'shader'));
      if (sh != null)
      {
        spr.shader = sh;
        runtimeShaders.push(sh);
      }
      spr.zIndex = Std.int(util_f(get(ov, 'z'), 5000));
      this.add(spr);
    }

    // Recreate sprites constructed by Codename stage scripts. Their count,
    // atlas, frame/prefix, transform, and insertion target are extracted from
    // the script rather than inferred from any particular mod.
    if (dyn.scriptSprites != null)
    {
      var modeList:Dynamic = get(dyn, 'beatModes');
      trace('[FUNKY-COMPAT] extracted beat modes=' + (modeList == null ? 'null' : modeList.length));
      for (spec in dyn.scriptSprites)
      {
        if (spec == null) continue;
        var count:Int = Std.int(util_f(get(spec, 'count'), 1));
        if (count < 1) count = 1;
        for (si in 0...count)
        {
          var px:Float = util_f(get(spec, 'x'), 0) + util_f(get(spec, 'stepX'), 0) * si;
          var py:Float = util_f(get(spec, 'y'), 0) + util_f(get(spec, 'stepY'), 0) * si;
          var spr:FlxSprite = new FlxSprite(px, py);
          var atlas:String = Std.string(get(spec, 'atlas'));
          if (atlas != null && atlas != '' && atlas != 'null')
          {
            spr.frames = Paths.getSparrowAtlas(atlas);
            var animName:String = Std.string(get(spec, 'anim'));
            var prefix:String = Std.string(get(spec, 'prefix'));
            var frame:Int = Std.int(util_f(get(spec, 'frame'), -1));
            var resolvedAnim:String = animName == '' || animName == 'null' ? 'idle' : animName;
            if (get(spec, 'randomFrames') == true && prefix != '' && prefix != 'null')
            {
              var randomMin:Int = Std.int(util_f(get(spec, 'randomMin'), 0));
              var randomMax:Int = Std.int(util_f(get(spec, 'randomMax'), randomMin));
              var randomRange:Int = randomMax - randomMin + 1;
              if (randomRange < 1) randomRange = 1;
              var randomOffset:Int = Std.int(util_f(get(spec, 'randomOffset'), 0));
              var randomValue:Int = randomMin + (si % randomRange) + randomOffset;
              spr.animation.addByPrefix(resolvedAnim, prefix + randomValue, 0, false);
            }
            else if (frame >= 0) spr.animation.add(resolvedAnim, [frame], 0, false);
            else if (prefix != '' && prefix != 'null') spr.animation.addByPrefix(resolvedAnim, prefix, util_f(get(spec, 'fps'), 24), false);
            if (spr.animation.getByName(animName == '' || animName == 'null' ? 'idle' : animName) != null) spr.animation.play(animName == '' || animName == 'null' ? 'idle' : animName);
          }
          spr.antialiasing = util_b(get(spec, 'antialiasing'), true);
          spr.scale.set(util_f(get(spec, 'scaleX'), 1), util_f(get(spec, 'scaleY'), 1));
          spr.updateHitbox();
          var before:String = Std.string(get(spec, 'before'));
          var beforeProp:Dynamic = before == null || before == 'null' || before == '' ? null : getNamedProp(before);
          spr.zIndex = beforeProp != null ? Std.int(beforeProp.zIndex) - 1 : Std.int(util_f(get(spec, 'z'), 150));
          scriptSprites.push(spr);
          this.add(spr);
        }
      }
      this.refresh();
      trace('[FUNKY-COMPAT] Recreated script-created sprites: ' + scriptSprites.length);
    }

    // Parallax scroll-factor overrides on named props.
    if (dyn.scrolls != null)
    {
      for (si in 0...dyn.scrolls.length)
      {
        var sc:Dynamic = dyn.scrolls[si];
        if (sc == null) continue;
        var tgt:String = Std.string(get(sc, 'target'));
        if (tgt == 'bf' || tgt == 'dad' || tgt == 'gf') continue; // chars handled in addCharacter
        var prop = getNamedProp(tgt);
        if (prop != null) prop.scrollFactor.set(util_f(get(sc, 'x'), 1), util_f(get(sc, 'y'), 1));
      }
    }

    // Hide props the script hides (keep pre-rendered bg visible for 3D stages).
    if (dyn.hideProps != null)
    {
      for (hi in 0...dyn.hideProps.length)
      {
        var hp:String = Std.string(dyn.hideProps[hi]);
        if (hp == 'bg' && get(dyn, 'is3D') == true) continue; // pre-render is the fallback
        var hprop = getNamedProp(hp);
        if (hprop != null)
        {
          hprop.visible = false;
          trace('[FUNKY-COMPAT] hid prop "' + hp + '"');
        }
        else trace('[FUNKY-COMPAT] hide target "' + hp + '" not found');
      }
    }
  }

  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    shaderTime += event.elapsed;
    var conductorStep:Int = Std.int(Conductor.instance.currentStep);
    // Process chart callbacks before the beat pass. A callback can change the
    // state used by the very next beat, and must be visible immediately rather
    // than one beat later.
    replayCodenameCalls(conductorStep);
    applyDynamicPropTransforms();
    // Use the step clock as a fallback as well as the beat callback.
    // callbacks are not guaranteed to be delivered by every V-Slice build.
    var beat:Int = Std.int(conductorStep / 4);
    if (beat != extractedBeat)
    {
      extractedBeat = beat;
      applyExtractedBeat();
    }
    relaxExtractedBeat(event.elapsed);

    if (conductorStep != lastSoloStep)
    {
      lastSoloStep = conductorStep;
      runStepFx(conductorStep);
    }
    for (sh in runtimeShaders)
    {
      // Unknown uniforms are ignored by FlxRuntimeShader; iTime is the
      // convention used by GUNLICK's fog shader and its update() function.
      sh.setFloat('iTime', shaderTime);
    }
  }

  // The JSON stage data (built by placeAnchor) already positions characters
  // exactly - super.addCharacter handles placement. This override only adds
  // the script-derived color grading; do NOT reposition here (re-deriving
  // from raw anchors double-converts and throws characters off-stage).
  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    super.addCharacter(character, charType);
    if (dyn == null) return;
    var a:Dynamic = null;
    if (charType == CharacterType.BF) a = get(dyn, 'bf');
    else if (charType == CharacterType.DAD) a = get(dyn, 'dad');
    else if (charType == CharacterType.GF) a = get(dyn, 'gf');
    if (a == null) return;

    var sh:FlxRuntimeShader = makeShader(get(a, 'shader'));
    if (sh != null) character.shader = sh;

    // Parallax override for this slot (apply3DScrollFactors-style).
    if (dyn.scrolls != null)
    {
      var slot:String = charType == CharacterType.BF ? 'bf' : (charType == CharacterType.DAD ? 'dad' : 'gf');
      for (si in 0...dyn.scrolls.length)
      {
        var sc:Dynamic = dyn.scrolls[si];
        if (sc != null && Std.string(get(sc, 'target')) == slot)
        {
          character.scrollFactor.set(util_f(get(sc, 'x'), 1), util_f(get(sc, 'y'), 1));
        }
      }
    }
  }

  function applyDynamicPropTransforms():Void
  {
    if (dyn == null) return;
    var dynamicProps:Array<Dynamic> = get(dyn, 'dynamicProps');
    if (dynamicProps == null || FlxG.camera == null) return;
    for (spec in dynamicProps)
    {
      if (spec == null || get(spec, 'cameraPerspective') != true) continue;
      var target:Dynamic = getNamedProp(Std.string(get(spec, 'target')));
      if (target == null || target.width <= 0 || target.height <= 0) continue;
      var targetName:String = Std.string(get(spec, 'target'));
      var base:Dynamic = get(dynamicPropBases, targetName);
      if (base == null)
      {
        // Stage construction calls updateHitbox after applying the XML scale,
        // while Codename's default XML path does not. Recover the logical
        // unscaled frame dimensions and the authored position once, before
        // the script changes scale.y.
        var initialScaleX:Float = target.scale.x > 0.001 ? target.scale.x : 1;
        var initialScaleY:Float = target.scale.y > 0.001 ? target.scale.y : 1;
        var logicalW:Float = target.width / initialScaleX;
        var logicalH:Float = target.height / initialScaleY;
        base = {
          w: logicalW,
          h: logicalH,
          x: target.x - logicalW * (1 - initialScaleX) / 2,
          y: target.y - logicalH * (1 - initialScaleY) / 2
        };
        dynamicPropBases[targetName] = base;
      }
      var logicalW2:Float = util_f(get(base, 'w'), target.width);
      var logicalH2:Float = util_f(get(base, 'h'), target.height);
      var midX:Float = util_f(get(base, 'x'), target.x) + logicalW2 / 2;
      var midY:Float = util_f(get(base, 'y'), target.y) + logicalH2 / 2;
      var cameraCenterX:Float = FlxG.camera.scroll.x + FlxG.width / 2;
      var cameraCenterY:Float = FlxG.camera.scroll.y + FlxG.height / 2;
      // This is the camera-relative perspective transform used by Codename
      // stage scripts. Keep the constants as part of the generic transform;
      // the target prop is extracted from the source script.
      var perspectiveScaleY:Float = ((-(cameraCenterY - midY - 200) / 0.002) / Math.PI / logicalH2) / (logicalH2 / 2.5);
      if (Math.isNaN(perspectiveScaleY) || Math.isNaN(logicalW2) || Math.isNaN(logicalH2)) continue;
      // A perspective script must never make a stage prop disappear because
      // a camera midpoint briefly crosses its reference plane.
      if (perspectiveScaleY < 0.05) perspectiveScaleY = 0.05;
      if (perspectiveScaleY > 1.6) perspectiveScaleY = 1.6;
      target.skew.x = (-(cameraCenterX - midX) / 0.001) / Math.PI / logicalW2;
      target.scale.y = perspectiveScaleY;
    }
  }

  function replayCodenameCalls(step:Int):Void
  {
    if (dyn == null) return;
    var calls:Array<Dynamic> = get(dyn, 'callEvents');
    if (calls == null) return;
    while (callCursor < calls.length)
    {
      var call:Dynamic = calls[callCursor];
      var callStep:Int = Std.int(util_f(get(call, 'step'), 0));
      if (callStep > step) break;
      callCursor++;
      var fn:String = Std.string(get(call, 'fn'));
      var args:Dynamic = get(call, 'args');
      trace('[FUNKY-COMPAT] Codename HScript Call ' + fn + ' at step ' + callStep);
      executeCallActions(fn);
      // Keep callback arguments available to extracted actions. No callback
      // name is interpreted as a mod-specific visual implementation here.
      if (fn == 'beatSwitch' && args != null && args.length > 1)
      {
        codenameBeatMode = Std.int(util_f(args[1], 0));
        // Codename scripts commonly reset their per-mode beat cursor when a
        // state switch occurs. Keep the extracted state machine in sync and
        // apply the new mode at the callback timestamp.
        extractedBeatCount = 0;
        applyExtractedBeat(false);
      }
    }
  }

  function executeCallActions(fn:String):Void
  {
    if (dyn == null) return;
    var allActions:Dynamic = get(dyn, 'callActions');
    if (allActions == null) return;
    var actions:Array<Dynamic> = get(allActions, fn);
    if (actions == null) return;
    for (action in actions)
    {
      if (action == null) continue;
      var targetName:String = Std.string(get(action, 'target'));
      var target:Dynamic = getNamedProp(targetName);
      var op:String = Std.string(get(action, 'op'));
      if (target == null)
      {
        trace('[FUNKY-COMPAT] portable action target not found: ' + targetName);
        continue;
      }
      if (op == 'visible') target.visible = get(action, 'value') == true;
      else if (op == 'playAnim')
      {
        try { target.animation.play(Std.string(get(action, 'value')), true); } catch (e:Dynamic) {}
      }
    }
  }


  function selectedBeatMode():Dynamic
  {
    if (dyn == null || dyn.scriptSprites == null) return null;
    var modes:Array<Dynamic> = get(dyn, 'beatModes');
    if (modes == null || modes.length == 0) return null;
    for (mode in modes)
      if (mode != null && Std.int(util_f(get(mode, 'mode'), -1)) == codenameBeatMode) return mode;
    return null;
  }

  function applyExtractedBeat(?advance:Bool = true):Void
  {
    var selected:Dynamic = selectedBeatMode();
    if (selected == null)
    {
      trace('[FUNKY-COMPAT] beat state has no extracted mode ' + codenameBeatMode);
      return;
    }
    trace('[FUNKY-COMPAT] apply beat mode=' + codenameBeatMode + ' cursor=' + extractedBeatCount + ' advance=' + advance + ' pattern=' + Std.string(get(selected, 'pattern')));
    if (get(selected, 'pattern') == 'none' && codenameBeatMode == 4) return;
    var baseX:Float = util_f(get(selected, 'baseX'), 1);
    var baseY:Float = util_f(get(selected, 'baseY'), 1);
    var basePosY:Float = util_f(get(selected, 'baseYPos'), Math.NaN);
    var specialX:Float = util_f(get(selected, 'specialX'), baseX);
    var specialY:Float = util_f(get(selected, 'specialY'), baseY);
    var specialPosY:Float = util_f(get(selected, 'specialYPos'), basePosY);
    var pattern:String = Std.string(get(selected, 'pattern'));
    for (i in 0...scriptSprites.length)
    {
      var special:Bool = pattern == 'beatParity' ? (extractedBeatCount % 2 == 0) : (pattern == 'indexParity' ? (i % 2 == extractedBeatCount % 2) : (pattern == 'sequence' && i == extractedBeatCount));
      var s:FlxSprite = scriptSprites[i];
      s.scale.set(special ? specialX : baseX, special ? specialY : baseY);
      if (!Math.isNaN(basePosY)) s.y = special && !Math.isNaN(specialPosY) ? specialPosY : basePosY;
      s.updateHitbox();
    }
    if (advance) extractedBeatCount++;
  }


  // Smoothly return a beat pose toward the extracted mode's normal pose.
  // This is deliberately based on imported pose data, not mod-specific names.
  function relaxExtractedBeat(elapsed:Float):Void
  {
    var selected:Dynamic = selectedBeatMode();
    if (selected == null || scriptSprites == null) return;
    var baseX:Float = util_f(get(selected, 'baseX'), 1);
    var baseY:Float = util_f(get(selected, 'baseY'), 1);
    var basePosY:Float = util_f(get(selected, 'baseYPos'), Math.NaN);
    var amount:Float = elapsed * 12;
    if (amount > 1) amount = 1;
    if (amount <= 0) return;
    for (s in scriptSprites)
    {
      s.scale.x += (baseX - s.scale.x) * amount;
      s.scale.y += (baseY - s.scale.y) * amount;
      if (!Math.isNaN(basePosY)) s.y += (basePosY - s.y) * amount;
      s.updateHitbox();
    }
  }

  override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (event.curStep != lastSoloStep)
    {
      lastSoloStep = event.curStep;
      runStepFx(event.curStep);
    }
  }

  function runStepFx(step:Int):Void
  {
    if (dyn == null) return;
    var effects:Array<Dynamic> = get(dyn, 'stepFx');
    if (effects == null) return;
    for (fx in effects)
    {
      if (fx == null || Std.int(util_f(get(fx, 'step'), -1)) != step) continue;
      var kind:String = Std.string(get(fx, 'kind'));
      trace('[FUNKY-COMPAT] extracted step effect ' + kind + ' at step ' + step);
      if (kind == 'flash')
      {
        soloFlash = new FlxSprite(0, 0);
        soloFlash.makeGraphic(Std.int(FlxG.width * 2), Std.int(FlxG.height * 2), FlxColor.BLACK);
        soloFlash.scrollFactor.set();
        soloFlash.screenCenter();
        soloFlash.zIndex = 6000;
        this.add(soloFlash);
      }
      else if (kind == 'cinematic')
      {
        if (soloFlash != null) { this.remove(soloFlash); soloFlash = null; }
        var cover:FlxSprite = new FlxSprite(0, 0);
        cover.makeGraphic(Std.int(FlxG.width * 2), Std.int(FlxG.height * 2), FlxColor.BLACK);
        cover.scrollFactor.set(); cover.screenCenter(); cover.alpha = 0.9; cover.zIndex = 6000;
        soloSprites.push(cover); this.add(cover);
        var images:Array<Dynamic> = get(fx, 'images');
        var imageZ:Int = 6001;
        if (images != null) for (imagePath in images)
        {
          var image:FlxSprite = new FlxSprite(0, 0);
          image.loadGraphic(Paths.image(Std.string(imagePath)));
          if (image.width > 0) { image.scale.set(FlxG.width / image.width, FlxG.height / image.height); image.updateHitbox(); }
          image.screenCenter(); image.zIndex = imageZ++; soloSprites.push(image); this.add(image);
        }
        var top:FlxSprite = new FlxSprite(0, 0); top.makeGraphic(FlxG.width, Std.int(FlxG.height * 0.2), FlxColor.BLACK); top.zIndex = imageZ++; soloSprites.push(top); this.add(top);
        var bottom:FlxSprite = new FlxSprite(0, Std.int(FlxG.height * 0.8)); bottom.makeGraphic(FlxG.width, Std.int(FlxG.height * 0.2), FlxColor.BLACK); bottom.zIndex = imageZ; soloSprites.push(bottom); this.add(bottom);
      }
      else if (kind == 'zoom')
      {
        if (FlxG.camera != null) FlxG.camera.zoom = util_f(get(fx, 'zoom'), 1.1);
      }
      else if (kind == 'fade')
      {
        for (s in soloSprites) if (s != null) FlxTween.tween(s, {alpha: 0.001}, 0.25, {ease: FlxEase.cubeOut});
      }
      this.refresh();
    }
  }

  override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    // Deduplicate against the update-loop fallback. If this callback is
    // skipped, onUpdate still advances the same state machine.
    var beat:Int = Std.int(Conductor.instance.currentStep / 4);
    if (beat != extractedBeat)
    {
      extractedBeat = beat;
      applyExtractedBeat();
    }
    if (dyn == null) return;
    var bb:Dynamic = get(dyn, 'beatBounce');
    if (bb == null) return;
    var drop:Float = util_f(get(bb, 'drop'), 0);
    if (drop == 0) return;
    var dur:Float = util_f(get(bb, 'dur'), 0.3);
    var count:Int = Std.int(util_f(get(bb, 'count'), 0));
    var prefix:String = Std.string(get(bb, 'prefix'));
    if (prefix == null || prefix == '') prefix = 'crowd';
    for (i in 1...(count + 1))
    {
      var c = getNamedProp(prefix + i);
      if (c == null) continue;
      c.y += drop;
      FlxTween.tween(c, {y: c.y - drop}, dur, {ease: FlxEase.circOut});
    }
  }

  // Create a runtime shader from a registered .frag with baked uniforms.
  function makeShader(spec:Dynamic):FlxRuntimeShader
  {
    if (spec == null) return null;
    var frag:String = Std.string(get(spec, 'frag'));
    if (frag == null || frag == '') return null;
    try
    {
      var text:String = Assets.getText(Paths.frag(frag));
      if (text == null || text == '')
      {
        trace('[FUNKY-COMPAT] Shader frag missing: ' + Paths.frag(frag));
        return null;
      }
      var sh:FlxRuntimeShader = new FlxRuntimeShader(text);
      var uni:Dynamic = get(spec, 'uniforms');
      if (uni != null)
      {
        for (ui in 0...uni.length)
        {
          var pair:Dynamic = uni[ui];
          sh.setFloat(Std.string(pair.k), util_f(pair.v, 0));
        }
      }
      return sh;
    }
    catch (e:Dynamic)
    {
      trace('[FUNKY-COMPAT] Shader "' + frag + '" failed to build: ' + e);
      return null;
    }
  }

  function util_f(v:Dynamic, fallback:Float):Float
  {
    if (v == null) return fallback;
    var f:Float = Std.parseFloat(Std.string(v));
    if (Math.isNaN(f)) return fallback;
    return f;
  }

  function get(obj:Dynamic, key:String):Dynamic
  {
    if (obj == null) return null;
    // NOTE: Reflect.* is blacklisted in HScript (silently caught below);
    // ReflectUtil is the game's sanctioned alias.
    try
    {
      return ReflectUtil.getField(obj, key);
    }
    catch (e:Dynamic)
    {
      return null;
    }
  }

  function util_b(v:Dynamic, fallback:Bool):Bool
  {
    if (v == null) return fallback;
    if (v == true) return true;
    if (v == false) return false;
    return fallback;
  }
}
